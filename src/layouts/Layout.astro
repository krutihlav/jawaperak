---
import { encyklopedie } from '../data/encyklopedie';
export interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Jawa Pérák — typová řada, výrobní čísla, technika a registr dochovaných strojů.' } = Astro.props;
const menuEncy = encyklopedie.filter((s) => s.hotovo).slice(0, 7);
---
<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
:root{
  --paper:#f6f3ec;
  --paper-2:#efece2;
  --card:#ffffff;
  --ink:#1c1a17;
  --mute:#4a463e;
  --mute-2:#6b675e;
  --mute-3:#7d786d;
  --rule:#ddd8cc;
  --hair:#e2ddd1;
  --red:#8a2b1e;
  --ocel:#4C5F66;
  --col:760px;          /* jednotna sirka textoveho sloupce na CELEM webu */
  --disp:"Archivo",Helvetica,sans-serif;
  --body:"Libre Baskerville",Georgia,serif;
  --mono:"JetBrains Mono",monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.6}
.wrap{max-width:1060px;margin:0 auto;padding:0 26px}
/* Sirsi obal jen tam, kde vedle textu stoji bocni osnova.
   Textovy sloupec uvnitr zustava stejne siroky a stejne vycentrovany. */
.wrap--art{max-width:1240px}
a{color:inherit}
:focus-visible{outline:2px solid var(--red);outline-offset:3px}
h1,h2,h3{margin:0;font-family:var(--disp);font-weight:500;line-height:1.08;text-transform:uppercase;letter-spacing:.02em}
h2{font-size:clamp(26px,3.4vw,36px)}
h3{font-size:17px;font-weight:500;letter-spacing:.04em}
p{margin:0 0 .9em}

/* ================================================================
   JEDNOTNY TEXTOVY SLOUPEC
   Pouziva se na vsech strankach: encyklopedie, registr, historie,
   sluzby, navody. Vzdy stejna sirka, vzdy vycentrovany v okne.
   ================================================================ */
.page{max-width:var(--col);margin:0 auto;padding:40px 0 64px;position:relative}

/* ================= hlavička ================= */
.top{border-bottom:3px double var(--ink)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 26px}
.brand{font-family:var(--body);font-weight:400;font-size:20px;letter-spacing:-.01em;text-transform:none;text-decoration:none}
.brand i{font-style:italic;color:var(--red)}
.nav{display:flex;align-items:center;gap:22px;font-family:var(--disp);font-size:14px;font-weight:400;letter-spacing:.11em;text-transform:uppercase}
.nav>a,.nav-item>a{text-decoration:none;color:var(--mute)}
.nav>a:hover,.nav-item>a:hover{color:var(--red)}
.lang{font-family:var(--disp);font-size:13px;letter-spacing:.11em;text-transform:uppercase;color:var(--mute);text-decoration:none}

.nav-toggle{position:absolute;opacity:0;pointer-events:none}
.burger{display:none;flex-direction:column;justify-content:space-between;width:24px;height:18px;cursor:pointer}
.burger span{display:block;height:2px;width:100%;background:var(--ink);border-radius:1px;
  transition:transform .22s ease,opacity .15s ease;transform-origin:center}
.scrim{display:none}

.nav-item{position:relative}
.nav-item .sub{list-style:none;margin:0;padding:8px 0;position:absolute;top:100%;left:0;min-width:230px;
  background:var(--paper);border:1px solid var(--rule);box-shadow:0 6px 16px rgba(43,33,24,.18);
  opacity:0;visibility:hidden;transform:translateY(4px);transition:opacity .15s ease,transform .15s ease,visibility .15s;z-index:20}
.nav-item .sub li a{display:block;padding:7px 16px;font-size:13px;letter-spacing:.06em;text-transform:none;text-decoration:none;color:var(--mute)}
.nav-item .sub li a:hover{color:var(--red)}
.nav-item .sub li.all a{border-top:1px solid var(--hair);margin-top:5px;padding-top:10px;color:var(--red)}
.nav-item:hover>.sub,.nav-item:focus-within>.sub{opacity:1;visibility:visible;transform:translateY(0)}

/* ================= ukazatel průchodu článkem ================= */
.progress{position:fixed;top:0;left:0;height:3px;background:var(--red);width:0;z-index:90;
  transition:width .1s linear;pointer-events:none}

/* ================= homepage a obecné bloky (beze změny) ================= */
.hero{padding:52px 0 46px;border-bottom:1px solid var(--rule)}
.hero .wrap{display:grid;grid-template-columns:330px 1fr;gap:70px;align-items:center}
.hero h1{font-size:clamp(44px,6.6vw,78px);font-weight:600;letter-spacing:.01em}
.hero .sub{margin-top:16px;font-size:19px;color:var(--mute);max-width:40ch}
.hero .sub b{color:var(--ink);font-weight:600}

.plate-wrap{width:330px;max-width:100%}
.plate-img{display:block;width:100%;height:auto;
  filter:drop-shadow(0 16px 22px rgba(43,33,24,.32)) drop-shadow(0 2px 3px rgba(43,33,24,.3))}
.plate-cap{margin:18px 0 0;font-family:var(--disp);font-weight:400;font-size:12px;
  letter-spacing:.1em;text-transform:uppercase;color:var(--mute);line-height:1.75;text-align:center}
.plate-cap b{display:block;color:var(--ink);font-weight:600;letter-spacing:.12em}

.ident{margin-top:30px;max-width:400px}
.ident-lb{font-family:var(--disp);font-weight:500;font-size:12px;letter-spacing:.15em;
  text-transform:uppercase;color:var(--mute);display:block;margin-bottom:9px}
.ident-row{display:flex;align-items:stretch;gap:0;border:2px solid var(--ink);background:var(--paper-2)}
.ident-row select,.ident-row input{
  font-family:var(--disp);font-weight:500;font-size:19px;letter-spacing:.08em;
  background:transparent;border:0;color:var(--ink);padding:11px 12px;outline:none;min-width:0}
.ident-row select{border-right:2px solid var(--ink);flex:0 0 auto;text-transform:uppercase}
.ident-row input{flex:1;width:100%}
.ident-row input::placeholder{color:#9C8C70}
.ident-row button{
  font-family:var(--disp);font-weight:500;font-size:14px;letter-spacing:.12em;text-transform:uppercase;
  background:var(--red);color:var(--paper);border:0;border-left:2px solid var(--ink);
  padding:0 20px;cursor:pointer}
.ident-row button:hover{background:#8C1519}
.ident-note{margin:9px 0 0;font-size:14.5px;color:var(--mute)}

.sec{padding:46px 0;border-bottom:1px solid var(--rule)}
.sec .lead{margin-top:10px;color:var(--mute);max-width:56ch}

.tbl{margin-top:24px;width:100%;border-collapse:collapse;font-family:var(--disp);font-weight:400}
.tbl th{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);
  text-align:left;padding:0 14px 8px 0;border-bottom:2px solid var(--ink);font-weight:500}
.tbl td{padding:13px 14px 13px 0;border-bottom:1px solid var(--hair);font-size:16px;vertical-align:baseline}
.tbl tr:hover td{background:var(--paper-2)}
.tbl .k{font-weight:600;font-size:18px;letter-spacing:.06em;white-space:nowrap}
.tbl .d{font-family:var(--body);font-size:15.5px;color:var(--mute)}
.tbl a{text-decoration:none}
.tbl tr:hover .k{color:var(--red)}

.plates{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:26px}
.pl figure{margin:0}
.pl .img{aspect-ratio:4/5;background:
  repeating-linear-gradient(45deg,#CFC0A2 0 12px,#C7B79A 12px 24px);
  border:1px solid #8A7B5E;display:flex;align-items:flex-end;justify-content:center;
  filter:sepia(.35) contrast(1.04)}
.pl .img span{font-family:var(--disp);font-size:11px;letter-spacing:.12em;text-transform:uppercase;
  color:#6B5B45;padding:10px}
.pl figcaption{font-family:var(--disp);font-weight:600;font-size:12.5px;letter-spacing:.06em;
  text-align:center;margin-top:9px;color:var(--ink)}

.reg{margin-top:22px;border-top:2px solid var(--ink)}
.rec{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:baseline;
  padding:12px 0;border-bottom:1px solid var(--hair);text-decoration:none}
.rec:hover{background:var(--paper-2)}
.rt{font-family:var(--disp);font-weight:500;font-size:17px;letter-spacing:.05em;text-transform:uppercase}
.rm{font-family:var(--disp);font-weight:300;font-size:13px;color:var(--mute);letter-spacing:.05em;margin-top:1px}
.st{font-family:var(--disp);font-size:12px;letter-spacing:.11em;text-transform:uppercase;color:var(--mute);white-space:nowrap}
.st.a{color:var(--red)}
.act{margin-top:20px;font-family:var(--disp);font-size:14px;letter-spacing:.1em;text-transform:uppercase}
.act a{color:var(--red);text-decoration:none;border-bottom:1px solid var(--red);padding-bottom:2px}
.act a+a{margin-left:26px}

.two{display:grid;grid-template-columns:1fr 320px;gap:46px;align-items:start}
.two .lead{margin-top:12px}

.note{border-left:4px solid var(--red);padding:2px 0 2px 18px}
.note p{margin:0;color:var(--mute);font-size:16px}
.note b{color:var(--ink)}
.note a{color:var(--red)}

/* ================================================================
   ENCYKLOPEDICKÝ ČLÁNEK
   ================================================================ */

/* --- dvousloupcová osnova --- */
.art{max-width:none;min-width:0}

/* Bocni osnova stoji v levem okraji stranky a sloupec textu neposouva. */
.aside{position:absolute;top:0;bottom:0;left:-214px;width:190px}
.aside-in{position:sticky;top:24px}
.aside-lb{font-family:var(--disp);font-weight:500;font-size:11px;letter-spacing:.18em;
  text-transform:uppercase;color:var(--mute);margin:0 0 12px;padding-bottom:9px;border-bottom:2px solid var(--ink)}
.aside ol{list-style:none;margin:0;padding:0;counter-reset:s}
.aside li{counter-increment:s;margin:0}
.aside li a{display:grid;grid-template-columns:24px 1fr;gap:6px;align-items:baseline;
  padding:7px 0 7px 9px;font-family:var(--disp);font-weight:400;font-size:13px;letter-spacing:.03em;
  color:var(--mute);text-decoration:none;line-height:1.3;border-left:2px solid transparent;
  transition:color .15s,border-color .15s}
.aside li a::before{content:"0" counter(s);font-size:10.5px;font-weight:300;color:var(--rule);letter-spacing:.1em}
.aside li a:hover{color:var(--ink)}
.aside li a.on{color:var(--red);border-left-color:var(--red);font-weight:500}
.aside li a.on::before{color:var(--red)}
.aside-foot{margin-top:22px;padding-top:14px;border-top:1px solid var(--rule)}
.aside-foot .t{font-family:var(--disp);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--mute);margin:0 0 9px}
.aside-foot .row{margin-bottom:6px;line-height:1.35}

/* --- hlavička článku --- */
.art .kicker,.page>.kicker{font-family:var(--disp);font-weight:500;font-size:11.5px;letter-spacing:.18em;
  text-transform:uppercase;color:var(--red);margin:0 0 12px}
.art .kicker a{text-decoration:none}
.art h1,.page>h1{font-size:clamp(32px,5.2vw,52px);font-weight:600;letter-spacing:.005em}
.art .lead,.page>.lead{margin-top:16px;font-size:19.5px;color:var(--mute);line-height:1.5;max-width:58ch}
.art .meta{margin-top:20px;padding-top:12px;border-top:1px solid var(--rule);
  display:flex;flex-wrap:wrap;gap:6px 22px;font-family:var(--disp);font-weight:300;
  font-size:11.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--mute)}
.art .meta b{font-weight:500;color:var(--ink)}
.art>section{scroll-margin-top:20px}
.art h3{margin:34px 0 9px;font-size:16px;font-weight:500;letter-spacing:.07em}

/* --- razítko spolehlivosti --- */
.stamp{display:inline-block;font-family:var(--disp);font-weight:500;font-size:10px;
  letter-spacing:.15em;text-transform:uppercase;padding:2px 7px;border:1.5px solid;
  transform:rotate(-1.4deg);white-space:nowrap;vertical-align:2px;line-height:1.5}
.stamp.ov{color:var(--ocel);border-color:var(--ocel)}
.stamp.od{color:var(--mute);border-color:var(--rule)}
.stamp.sp{color:var(--red);border-color:var(--red)}
.stamp.kn{color:var(--ink);border-color:var(--ink)}

/* --- shrnutí --- */
.tldr{margin:30px 0 0;background:var(--card);border:1px solid var(--rule);
  box-shadow:3px 3px 0 var(--paper-2);padding:20px 22px 18px}
.tldr h2{font-size:11px;letter-spacing:.17em;color:var(--mute);margin:0 0 13px}
.tldr ol{list-style:none;margin:0;padding:0;counter-reset:t}
.tldr li{counter-increment:t;display:grid;grid-template-columns:22px 1fr;gap:10px;
  margin-bottom:9px;font-size:16.5px;line-height:1.45}
.tldr li:last-child{margin-bottom:0}
.tldr li::before{content:counter(t);font-family:var(--disp);font-weight:500;font-size:12px;
  color:var(--red);border-bottom:1.5px solid var(--red);text-align:center;align-self:start;
  padding-bottom:1px;margin-top:5px}

/* --- hlavička sekce, číslo přerušuje linku --- */
.art .sec{padding:0;border:0;scroll-margin-top:20px}
.sec-h{position:relative;margin:64px 0 20px;padding-top:20px;border-top:2px solid var(--ink)}
.sec-n{position:absolute;top:-9px;left:0;background:var(--paper);padding-right:13px;
  font-family:var(--disp);font-weight:500;font-size:12px;letter-spacing:.22em;color:var(--red)}
.sec-h h2{font-size:clamp(23px,3.2vw,31px)}
.sec-h .sub{margin:8px 0 0;font-size:16px;color:var(--mute);max-width:56ch}

/* --- boxy: tři role (.warn a .fact ponechány jako alias pro starší stránky) --- */
.box{margin:26px 0}
.box .lb,.warn .lb,.fact .lb{font-family:var(--disp);font-weight:600;font-size:11px;letter-spacing:.16em;
  text-transform:uppercase;display:block;margin-bottom:8px}
.box p{margin:0 0 .6em;font-size:16px;max-width:none}
.box p:last-child{margin-bottom:0}
.box ul{margin:0;padding-left:19px;font-size:16px}
.box li{margin-bottom:5px}

.box--fact,.fact{margin:26px 0;border-left:4px solid var(--ink);background:var(--paper-2);padding:15px 18px}
.box--fact .lb,.fact .lb{color:var(--mute)}
.fact p{margin:0;font-size:16.5px}

.box--warn,.warn{margin:26px 0;border:2px solid var(--red);background:#F3E7D6;padding:16px 19px}
.box--warn .lb,.warn .lb{color:var(--red)}
.warn p{margin:0 0 .6em;font-size:16px}
.warn p:last-child{margin-bottom:0}
.warn ul{margin:0;padding-left:19px;font-size:16px}

.box--dilna{border:1px dashed var(--ocel);background:rgba(76,95,102,.055);padding:16px 19px}
.box--dilna .lb{color:var(--ocel)}
.box--dilna .lb::before{content:"\25C6\00A0";font-size:8px;vertical-align:2px}

/* --- tabulky, na mobilu jako karty --- */
.spec{margin:26px 0;width:100%;border-collapse:collapse;font-size:16px}
.spec caption{font-family:var(--disp);font-weight:500;font-size:11px;letter-spacing:.15em;
  text-transform:uppercase;color:var(--mute);text-align:left;padding-bottom:9px}
.spec th{font-family:var(--disp);font-weight:500;font-size:12px;letter-spacing:.1em;
  text-transform:uppercase;text-align:left;padding:9px 14px 9px 0;
  border-bottom:2px solid var(--ink);color:var(--mute)}
.spec td{padding:11px 14px 11px 0;border-bottom:1px solid var(--hair);vertical-align:top}
.spec tbody tr:hover td{background:var(--paper-2)}
.spec .rl{font-family:var(--disp);font-weight:500;letter-spacing:.04em}
.spec .nw{white-space:nowrap}
.spec .num{font-variant-numeric:tabular-nums;white-space:nowrap;font-family:var(--disp);letter-spacing:.04em}
.spec .q{font-size:14.5px;color:var(--mute)}
.bar{display:block;height:6px;background:var(--rule);margin-top:5px;position:relative}
.bar i{position:absolute;top:0;bottom:0;background:var(--red);opacity:.75}

/* --- tři místa, kde hledat čísla --- */
.spots{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:26px 0}
.spot{border:1px solid var(--rule);background:var(--card);padding:0 0 14px}
.spot .im{aspect-ratio:4/3;background:repeating-linear-gradient(45deg,#DFD2B4 0 12px,#D8CAAA 12px 24px);
  border-bottom:1px solid var(--rule);display:flex;align-items:flex-end;padding:9px}
.spot .im b{font-family:var(--disp);font-weight:600;font-size:11px;letter-spacing:.14em;
  color:var(--paper);background:var(--ink);padding:2px 7px}
.spot h4{margin:12px 14px 5px;font-family:var(--disp);font-weight:500;font-size:14px;
  letter-spacing:.05em;text-transform:uppercase;line-height:1.2}
.spot p{margin:0 14px;font-size:14.5px;color:var(--mute);line-height:1.45}
.spot .stx{margin:9px 14px 0}

/* --- obrázky --- */
.fig{margin:32px 0}
.fig img{display:block;width:100%;height:auto;border:1px solid var(--rule);background:var(--paper-2)}
.fig .ph{aspect-ratio:16/9;border:1px dashed var(--rule);
  background:repeating-linear-gradient(45deg,#DFD2B4 0 14px,#D8CAAA 14px 28px);
  display:flex;align-items:center;justify-content:center;text-align:center;padding:20px}
.fig .ph span{font-family:var(--disp);font-size:11.5px;letter-spacing:.12em;
  text-transform:uppercase;color:#7A6A50;max-width:30ch;line-height:1.75}
.fig figcaption{margin-top:9px;font-size:14.5px;color:var(--mute);line-height:1.5}
.fig figcaption b{color:var(--ink);font-weight:600}
.fig .cred{display:block;margin-top:4px;font-family:var(--disp);font-size:11px;
  letter-spacing:.08em;text-transform:uppercase;color:var(--mute);opacity:.8}
.gal{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;margin:28px 0}
.gal figure{margin:0}
.gal img{display:block;width:100%;height:auto;border:1px solid var(--rule)}
.gal figcaption{margin-top:7px;font-size:13.5px;color:var(--mute)}

/* --- nástroj: datování podle výrobního čísla --- */
.tool{margin:34px 0 0;border:2px solid var(--ink);background:var(--paper-2)}
.tool-h{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;
  padding:12px 18px;border-bottom:2px solid var(--ink);background:var(--ink);color:var(--paper)}
.tool-h .t{font-family:var(--disp);font-weight:500;font-size:13px;letter-spacing:.15em;text-transform:uppercase}
.tool-h .s{font-family:var(--disp);font-weight:300;font-size:11px;letter-spacing:.1em;text-transform:uppercase;opacity:.75}
.tool-b{padding:18px}
.tool-row{display:flex;border:2px solid var(--ink);background:var(--paper)}
.tool-row input{flex:1;min-width:0;font-family:var(--disp);font-weight:500;font-size:20px;
  letter-spacing:.09em;background:transparent;border:0;color:var(--ink);padding:12px 14px;outline:none}
.tool-row input::placeholder{color:#A2916F}
.tool-row button{font-family:var(--disp);font-weight:500;font-size:13.5px;letter-spacing:.13em;
  text-transform:uppercase;background:var(--red);color:var(--paper);border:0;border-left:2px solid var(--ink);
  padding:0 22px;cursor:pointer}
.tool-row button:hover{background:#8C1519}
.tool-hint{margin:10px 0 0;font-size:14px;color:var(--mute)}
.tool-hint code{font-family:var(--disp);font-size:14px;letter-spacing:.06em;background:var(--paper);
  padding:1px 5px;border:1px solid var(--rule)}
.tool-out{margin-top:16px;border-top:1px dashed var(--rule);padding-top:16px;display:none}
.tool-out.show{display:block}
.tool-out .yr{font-family:var(--disp);font-weight:600;font-size:clamp(34px,7vw,46px);line-height:1;
  letter-spacing:.02em;margin:0}
.tool-out .yr small{display:block;font-size:11.5px;font-weight:400;letter-spacing:.16em;
  text-transform:uppercase;color:var(--mute);margin-bottom:6px}
.tool-out .dsc{margin:12px 0 0;font-size:15.5px;color:var(--mute)}
.tool-out .dsc b{color:var(--ink)}
.tool-out.err .yr{font-size:22px;color:var(--red)}

/* --- prokliky v textu --- */
.rel{margin:30px 0;padding:14px 0;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);
  display:flex;flex-wrap:wrap;gap:9px;align-items:center}
.rel .t{font-family:var(--disp);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--mute);margin-right:4px}
.rel a{font-family:var(--disp);font-size:13px;letter-spacing:.05em;text-decoration:none;
  border:1px solid var(--rule);padding:5px 11px;color:var(--mute);background:var(--card)}
.rel a:hover{border-color:var(--red);color:var(--red)}

/* --- výzva na službu --- */
.cta{margin:40px 0 0;border:2px solid var(--ink);background:var(--card);
  display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center;padding:20px 22px}
.cta .lb{font-family:var(--disp);font-weight:500;font-size:10.5px;letter-spacing:.16em;
  text-transform:uppercase;color:var(--red);display:block;margin-bottom:6px}
.cta p{margin:0;font-size:16px;max-width:46ch}
.art ul,.art ol{padding-left:20px}
.art li{margin-bottom:6px}
.cta>a{font-family:var(--disp);font-weight:500;font-size:13px;letter-spacing:.12em;text-transform:uppercase;
  background:var(--ink);color:var(--paper);text-decoration:none;padding:12px 20px;white-space:nowrap}
.cta>a:hover{background:var(--red)}

/* --- zdroje --- */
.src{margin:52px 0 0;padding-top:18px;border-top:2px solid var(--ink)}
.src h2{margin:0 0 12px;font-size:11px;letter-spacing:.16em;color:var(--mute)}
.src ol{margin:0;padding-left:20px;font-size:15px;color:var(--mute)}
.src li{margin-bottom:9px;line-height:1.5}
.src cite{font-style:italic}
.src a{color:var(--mute)}

/* --- rejstřík encyklopedie --- */
.idx{margin:44px 0 0;border-top:2px solid var(--ink);padding-top:16px}
.idx-h{display:flex;align-items:baseline;justify-content:space-between;gap:14px;margin-bottom:14px}
.idx-h h2{font-size:11px;letter-spacing:.17em;color:var(--mute)}
.idx-all{font-family:var(--disp);font-size:11px;letter-spacing:.11em;
  text-transform:uppercase;color:var(--red);text-decoration:none;white-space:nowrap}
.idx-all:hover{border-bottom:1px solid var(--red)}
.idx ol{list-style:none;margin:0;padding:0;counter-reset:e;columns:2;column-gap:34px}
.idx li{counter-increment:e;break-inside:avoid}
.idx li>a,.idx li>span{display:grid;grid-template-columns:24px 1fr;gap:8px;align-items:baseline;
  padding:6px 0;text-decoration:none;font-family:var(--disp);font-weight:400;font-size:14.5px;
  letter-spacing:.03em;color:var(--mute);line-height:1.25;border-bottom:1px dotted var(--hair)}
.idx li>a::before,.idx li>span::before{content:"0" counter(e);font-size:10.5px;font-weight:300;
  color:var(--rule);letter-spacing:.1em}
.idx li>a:hover{color:var(--red)}
.idx li>a:hover::before{color:var(--red)}
.idx li.here>span{color:var(--ink);font-weight:500;
  background:linear-gradient(transparent 62%,rgba(168,28,33,.22) 0)}
.idx li.here>span::before{color:var(--red)}
.idx li.soon>span{color:var(--rule)}
.idx li.soon>span::after{content:"chystáme";font-size:9.5px;letter-spacing:.13em;
  text-transform:uppercase;color:var(--rule);margin-left:7px;vertical-align:1px}

/* --- rozcestník /perak/ --- */
.hublist{margin:34px 0 0;border-top:2px solid var(--ink);counter-reset:h}
.hubrow{counter-increment:h;display:grid;grid-template-columns:38px 1fr auto;gap:16px;
  align-items:baseline;padding:16px 0;border-bottom:1px solid var(--hair);text-decoration:none}
.hubrow:hover{background:var(--card)}
.hubrow::before{content:"0" counter(h);font-family:var(--disp);font-weight:300;font-size:12px;
  letter-spacing:.12em;color:var(--rule)}
.hubrow .tt{font-family:var(--disp);font-weight:500;font-size:19px;letter-spacing:.03em;
  text-transform:uppercase;line-height:1.15;display:block}
.hubrow .ds{margin:5px 0 0;font-size:15.5px;color:var(--mute);line-height:1.45}
.hubrow .fl{font-family:var(--disp);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--rule);white-space:nowrap}
.hubrow:hover .tt{color:var(--red)}
.hubrow.soon{cursor:default;background:transparent}
.hubrow.soon .tt{color:var(--rule)}
.hubrow.soon:hover{background:transparent}
.hubrow.soon:hover .tt{color:var(--rule)}
.hubrow.soon .ds{color:var(--rule)}

.hubgrp{margin:34px 0 -2px;font-family:var(--disp);font-weight:500;font-size:11px;
  letter-spacing:.17em;text-transform:uppercase;color:var(--red);
  padding-bottom:8px;border-bottom:2px solid var(--ink)}
.hubgrp+.hublist{margin-top:0;border-top:0}

/* --- casova osa vyroby --- */
.tl{margin:28px 0;border-left:2px solid var(--ink)}
.tlrow{display:grid;grid-template-columns:78px 1fr;gap:18px;padding:0 0 22px 20px;position:relative}
.tlrow::before{content:"";position:absolute;left:-6px;top:6px;width:10px;height:10px;
  background:var(--paper);border:2px solid var(--red);border-radius:50%}
.tlrow:last-child{padding-bottom:0}
.tlrow .yr{font-family:var(--disp);font-weight:600;font-size:19px;letter-spacing:.05em;line-height:1.1}
.tlrow .yr small{display:block;font-family:var(--disp);font-weight:300;font-size:10.5px;
  letter-spacing:.1em;color:var(--mute);margin-top:3px;text-transform:uppercase}
.tlrow .tx{margin:0;font-size:16px;line-height:1.5}
.tlrow .tx .sn{font-family:var(--disp);font-weight:500;font-size:14px;letter-spacing:.05em;
  color:var(--red);white-space:nowrap}

/* --- navigace mezi články (starší stránky) --- */
.next{margin-top:34px;display:grid;grid-template-columns:1fr 1fr;gap:14px}
.next a{display:block;padding:15px 17px;border:1px solid var(--rule);text-decoration:none;background:var(--card)}
.next a:hover{border-color:var(--red)}
.next .lb{font-family:var(--disp);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--mute)}
.next .tt{font-family:var(--disp);font-weight:500;font-size:16px;letter-spacing:.03em;margin-top:3px;display:block}

/* --- starší kotvová osnova, ponecháno --- */
.toc{margin:24px 0;padding:0 0 0 16px;border-left:3px solid var(--rule)}
.toc ol{margin:0;padding-left:18px;font-family:var(--disp);font-size:13.5px;letter-spacing:.05em}
.toc li{margin-bottom:4px}
.toc a{color:var(--mute);text-decoration:none}
.toc a:hover{color:var(--red)}

/* --- mobilní osnova --- */
.mtoc{display:none}

/* ================================================================
   PATIČKA
   ================================================================ */
.foot{border-top:3px double var(--ink);padding:28px 0 26px}
.foot .g{display:grid;grid-template-columns:280px 1fr;gap:50px;align-items:start}
.foot .mark{font-family:var(--body);font-weight:400;font-size:18px;letter-spacing:-.01em;
  text-transform:none;display:inline-block;text-decoration:none;margin-bottom:9px}
.foot .mark i{font-style:italic;color:var(--red)}
.foot .who{margin:0;font-size:14.5px;color:var(--mute);line-height:1.5;max-width:32ch}
.foot .who b{color:var(--ink);font-weight:600}
.foot .rows{display:grid;gap:0}
.foot .row{display:grid;grid-template-columns:106px 1fr;gap:18px;align-items:baseline;
  padding:9px 0;border-bottom:1px dotted var(--hair)}
.foot .row:first-child{border-top:1px solid var(--rule)}
.foot .row .t{font-family:var(--disp);font-weight:500;font-size:10px;letter-spacing:.17em;
  text-transform:uppercase;color:var(--red)}
.foot .row .ls{display:flex;flex-wrap:wrap;gap:3px 18px}
.foot .row .ls a{font-family:var(--disp);font-weight:300;font-size:14px;letter-spacing:.045em;
  color:var(--mute);text-decoration:none}
.foot .row .ls a:hover{color:var(--red)}
.colo{margin:20px 0 0;padding-top:12px;border-top:1px solid var(--rule);
  display:flex;flex-wrap:wrap;gap:4px 20px;justify-content:space-between;align-items:baseline;
  font-family:var(--disp);font-weight:300;font-size:11px;letter-spacing:.08em;
  text-transform:uppercase;color:var(--mute);line-height:1.75}
.colo a{text-decoration:none}
.colo a:hover{color:var(--red)}

/* ================================================================
   MOBIL
   ================================================================ */
@media (max-width:1239px){
  .aside{display:none}

  .mtoc{display:block;position:sticky;top:0;z-index:40;margin:0 -26px 24px;
    background:var(--paper);border-bottom:1px solid var(--rule)}
  .mtoc summary{list-style:none;cursor:pointer;padding:11px 26px;
    display:flex;align-items:center;justify-content:space-between;gap:10px;
    font-family:var(--disp);font-weight:500;font-size:12px;letter-spacing:.14em;
    text-transform:uppercase;color:var(--mute)}
  .mtoc summary::-webkit-details-marker{display:none}
  .mtoc summary .cur{color:var(--ink)}
  .mtoc summary::after{content:"\25BE";color:var(--red);font-size:13px}
  .mtoc[open] summary::after{content:"\25B4"}
  .mtoc ol{list-style:none;margin:0;padding:2px 26px 14px;counter-reset:m;border-top:1px solid var(--hair)}
  .mtoc li{counter-increment:m}
  .mtoc li a{display:grid;grid-template-columns:26px 1fr;gap:8px;padding:10px 0;
    font-family:var(--disp);font-size:14.5px;letter-spacing:.03em;color:var(--mute);
    text-decoration:none;border-bottom:1px solid var(--hair)}
  .mtoc li a::before{content:"0" counter(m);font-size:11px;font-weight:300;color:var(--rule)}
  .mtoc li:last-child a{border-bottom:0}
}

@media (max-width:880px){
  .page{padding:24px 0 50px}
  .spots{grid-template-columns:1fr;gap:0}
  .spot{border-bottom:0}
  .spot:last-child{border-bottom:1px solid var(--rule)}
  .spot .im{aspect-ratio:21/9}
  .cta{grid-template-columns:1fr;gap:14px}
  .cta>a{text-align:center}
  .next{grid-template-columns:1fr}
  .hero .wrap{grid-template-columns:1fr;gap:36px;justify-items:center;text-align:center}
  .hero .sub{margin-left:auto;margin-right:auto}
  .two{grid-template-columns:1fr;gap:28px}
  .plates{grid-template-columns:1fr 1fr}
  .foot .g{grid-template-columns:1fr;gap:24px}
  .foot .who{max-width:56ch}

  .burger{display:flex;margin-left:auto;z-index:40}
  .top .wrap>.lang{display:none}

  .scrim{display:block;position:fixed;inset:0;background:rgba(28,21,14,.5);
    opacity:0;visibility:hidden;transition:opacity .22s ease,visibility .22s;z-index:25}
  .nav-toggle:checked~.scrim{opacity:1;visibility:visible;touch-action:none}

  .nav{
    position:fixed;top:0;right:0;bottom:0;width:min(80vw,310px);
    background:#E8DEC8;flex-direction:column;align-items:stretch;gap:0;
    padding:70px 24px 28px;transform:translateX(100%);
    transition:transform .26s cubic-bezier(.4,0,.2,1);
    box-shadow:-12px 0 30px rgba(43,33,24,.3);overflow-y:auto;z-index:30}

  .nav>a,.nav-item{width:100%;border-bottom:1px solid var(--hair)}
  .nav>a,.nav-item>a{display:block;padding:15px 2px;font-size:15px}
  .nav-item>a{color:var(--ink)}

  .nav-item .sub{position:static;opacity:1;visibility:visible;transform:none;
    box-shadow:none;border:none;background:transparent;padding:2px 0 12px 14px}
  .nav-item .sub li a{padding:9px 0;font-size:14px}
  .nav-item .sub li.all a{border-top:1px solid var(--hair)}

  .nav .lang-in{display:block;margin-top:22px;padding:10px 0;text-align:center;
    border:1px solid var(--ink);text-decoration:none;color:var(--ink);
    font-family:var(--disp);font-size:13px;letter-spacing:.11em;text-transform:uppercase}

  .nav-toggle:checked~.nav{transform:translateX(0)}
  .nav-toggle:checked~.burger span:nth-child(1){transform:translateY(8px) rotate(45deg)}
  .nav-toggle:checked~.burger span:nth-child(2){opacity:0}
  .nav-toggle:checked~.burger span:nth-child(3){transform:translateY(-8px) rotate(-45deg)}
}
@media (min-width:881px){
  .nav .lang-in{display:none}
}

@media (max-width:640px){
  body{font-size:16.5px}
  .wrap{padding:0 20px}
  .mtoc{margin:0 -20px 22px}
  .mtoc summary,.mtoc ol{padding-left:20px;padding-right:20px}
  .art .lead,.page>.lead{font-size:18px}
  .sec-h{margin-top:48px}
  .tool-row{flex-direction:column}
  .tool-row button{border-left:0;border-top:2px solid var(--ink);padding:13px 0}
  .tool-h{flex-direction:column;gap:2px}
  .idx ol{columns:1}
  .hubrow{grid-template-columns:32px 1fr;gap:12px}
  .hubrow .fl{grid-column:2;margin-top:6px}
  .tlrow{grid-template-columns:1fr;gap:4px;padding-left:18px}
  .tlrow .yr{font-size:17px}
  .tlrow .yr small{display:inline;margin-left:8px}

  .spec thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .spec,.spec tbody,.spec tr,.spec td{display:block;width:100%}
  .spec tr{border:1px solid var(--rule);background:var(--card);padding:12px 14px;margin-bottom:10px}
  .spec tbody tr:hover td{background:transparent}
  .spec td{border:0;padding:5px 0}
  .spec td+td{border-top:1px dotted var(--hair)}
  .spec .nw{white-space:normal}
  .spec td::before{content:attr(data-l);display:block;
    font-family:var(--disp);font-weight:500;font-size:10.5px;letter-spacing:.14em;
    text-transform:uppercase;color:var(--mute);margin-bottom:2px}
}

@media (max-width:520px){
  .plates{grid-template-columns:1fr}
  .tbl .d{display:none}
  .colo{gap:8px}
  .foot .row{grid-template-columns:1fr;gap:5px;padding:11px 0}
}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .progress{transition:none}
  .stamp{transform:none}
}

/* ================================================================
   ZPŘEHLEDNĚNÍ ČLÁNKŮ (8/2026)
   Cílem je míň nábytku a víc vzduchu: popisky boxů přestávají být
   verzálkami, razítko se zklidnilo, přibyl seznam častých chyb,
   který nahrazuje čtyři červené boxy pod sebou.
   ================================================================ */

/* --- víc vzduchu --- */
body{line-height:1.66}
.art .sec p{margin:0 0 1.05em}
.sec-h{margin:78px 0 22px}
.box{margin:30px 0}
.spec{margin:30px 0}
.art h3{margin:40px 0 10px}

/* --- popisky boxů nejsou verzálkami --- */
.box .lb,.warn .lb,.fact .lb{font-family:var(--disp);font-weight:500;font-size:15px;
  letter-spacing:.015em;text-transform:none;margin-bottom:7px;line-height:1.25}
.box--fact .lb,.fact .lb{color:var(--ink)}
.box--warn .lb,.warn .lb{color:var(--red)}
.box--dilna .lb{color:var(--ocel)}

/* --- zklidněné razítko: tenčí rámeček, bez natočení --- */
.stamp{border-width:1px;transform:none;letter-spacing:.12em;font-size:9.5px;padding:2px 6px}

/* --- popisek tabulky nese razítko a nemusí být verzálkami --- */
.spec caption{font-family:var(--disp);font-weight:500;font-size:14.5px;
  letter-spacing:.015em;text-transform:none;color:var(--ink);
  text-align:left;padding-bottom:10px}
.spec caption .stamp{margin-left:8px;vertical-align:1px}
.spec caption i{font-style:normal;color:var(--mute);font-weight:400}

/* --- výrobní číslo v běžném textu, ne jen v časové ose --- */
.art .sn{font-family:var(--disp);font-weight:500;font-size:.94em;
  letter-spacing:.04em;color:var(--red);white-space:nowrap}

/* --- seznam častých chyb --- */
.mist{list-style:none;margin:26px 0 0;padding:0;counter-reset:mi;border-top:2px solid var(--ink)}
.mist li{counter-increment:mi;display:grid;grid-template-columns:26px 1fr;gap:15px;
  margin:0;padding:17px 0;border-bottom:1px solid var(--hair)}
.mist li::before{content:counter(mi);font-family:var(--disp);font-weight:500;font-size:12px;
  color:var(--red);border-bottom:1.5px solid var(--red);text-align:center;
  align-self:start;margin-top:5px;padding-bottom:1px}
.mist b{display:block;font-family:var(--disp);font-weight:500;font-size:16.5px;
  letter-spacing:.02em;margin-bottom:5px;line-height:1.25}
.mist p{margin:0;font-size:16px}

@media (max-width:640px){
  .mist li{grid-template-columns:22px 1fr;gap:12px}
}
</style>
</head>
<body>
<div class="progress" id="progress" aria-hidden="true"></div>

<header class="top">
  <div class="wrap">
    <a class="brand" href="/">Jawa<i>pérák</i></a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">
    <label for="nav-toggle" class="burger" aria-label="Otevřít menu">
      <span></span><span></span><span></span>
    </label>
    <label for="nav-toggle" class="scrim" aria-hidden="true"></label>

    <nav class="nav" aria-label="Hlavní">
      <div class="nav-item">
        <a href="/perak/">Encyklopedie</a>
        <ul class="sub">
          {menuEncy.map((s) => <li><a href={s.href}>{s.titul}</a></li>)}
          <li class="all"><a href="/perak/">Celý přehled</a></li>
        </ul>
      </div>
      <a href="/registr/">Registr</a>
      <a href="/navody/">Návody</a>
      <a href="/dilna/">Dílna</a>
      <a class="lang-in" href="/en/" hreflang="en">English</a>
    </nav>

    <a class="lang" href="/en/" hreflang="en">English</a>
  </div>
</header>

<slot />

<footer class="foot">
  <div class="wrap">
    <div class="g">
      <div>
        <a class="mark" href="/">Jawa<i>pérák</i></a>
        <p class="who">Nezávislý web o motocyklu Jawa 250/350 Pérák. Píše <b>Adam Kment</b>, dílna PureBikes, Drahanovice u Olomouce.</p>
      </div>
      <div class="rows">
        <div class="row">
          <span class="t">Encyklopedie</span>
          <span class="ls">
            <a href="/perak/250/">Pérák 250</a>
            <a href="/perak/350/">Pérák 350</a>
            <a href="/perak/identifikace/">Výrobní čísla</a>
            <a href="/perak/technicke-udaje/">Technické údaje</a>
            <a href="/historie/">Historie</a>
            <a href="/perak/">Celý přehled</a>
          </span>
        </div>
        <div class="row">
          <span class="t">Registr</span>
          <span class="ls">
            <a href="/registr/">Dochované stroje</a>
            <a href="/registr/pridat-stroj/">Přidat stroj</a>
            <a href="/registr/statistiky/">Statistiky</a>
          </span>
        </div>
        <div class="row">
          <span class="t">Dílna</span>
          <span class="ls">
            <a href="/sluzby/prohlidka-pred-koupi/">Prohlídka před koupí</a>
            <a href="/sluzby/vyroba-dilu/">Výroba dílů</a>
            <a href="/sluzby/renovace/">Renovace</a>
            <a href="/kontakt/">Kontakt</a>
          </span>
        </div>
      </div>
    </div>
    <div class="colo">
      <span>jawaperak.cz — není spojeno se značkou Jawa Moto ani Classic Legends</span>
      <a href="/en/" hreflang="en">English</a>
    </div>
  </div>
</footer>

<script is:inline>
(function () {
  /* ukazatel průchodu článkem — jen na stránkách s článkem */
  var bar = document.getElementById('progress');
  var art = document.querySelector('.art');
  if (bar && art) {
    var prog = function () {
      var h = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
    };
    window.addEventListener('scroll', prog, { passive: true });
    prog();
  } else if (bar) {
    bar.style.display = 'none';
  }

  /* zvýraznění aktivní položky v boční osnově */
  var links = Array.prototype.slice.call(document.querySelectorAll('#toc a'));
  if (links.length && 'IntersectionObserver' in window) {
    var cur = document.getElementById('curSec');
    var secs = links.map(function (a) { return document.querySelector(a.getAttribute('href')); });
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        var i = secs.indexOf(e.target);
        if (i < 0) return;
        links.forEach(function (a, j) { a.classList.toggle('on', j === i); });
        if (cur) cur.textContent = links[i].textContent;
      });
    }, { rootMargin: '-15% 0px -70% 0px' });
    secs.forEach(function (s) { if (s) io.observe(s); });
  }

  /* zavření mobilní osnovy po kliknutí */
  Array.prototype.forEach.call(document.querySelectorAll('.mtoc a'), function (a) {
    a.addEventListener('click', function () {
      var d = a.closest('details');
      if (d) d.open = false;
    });
  });
})();
</script>
