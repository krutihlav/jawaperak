---
export interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Jawa Pérák — typová řada, výrobní čísla, technika a registr dochovaných strojů.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
<style is:global>
:root{
  --paper:#E8DEC8;
  --paper-2:#DFD2B4;
  --ink:#2B2118;
  --mute:#6A5B45;
  --rule:#C3B292;
  --hair:#D2C4A6;
  --red:#A81C21;
  --disp:"Oswald",Impact,sans-serif;
  --body:"Source Serif 4",Georgia,serif;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.6}
.wrap{max-width:1060px;margin:0 auto;padding:0 26px}
a{color:inherit}
:focus-visible{outline:2px solid var(--red);outline-offset:3px}
h1,h2,h3{margin:0;font-family:var(--disp);font-weight:500;line-height:1.08;text-transform:uppercase;letter-spacing:.02em}
h2{font-size:clamp(26px,3.4vw,36px)}
h3{font-size:17px;font-weight:500;letter-spacing:.04em}
p{margin:0 0 .9em}

.top{border-bottom:3px double var(--ink)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 26px}
.brand{font-family:var(--disp);font-weight:600;font-size:20px;letter-spacing:.14em;text-transform:uppercase;text-decoration:none}
.brand i{font-style:normal;color:var(--red)}
.nav{display:flex;align-items:center;gap:22px;font-family:var(--disp);font-size:14px;font-weight:400;letter-spacing:.11em;text-transform:uppercase}
.nav>a,.nav-item>a{text-decoration:none;color:var(--mute)}
.nav>a:hover,.nav-item>a:hover{color:var(--red)}
.lang{font-family:var(--disp);font-size:13px;letter-spacing:.11em;text-transform:uppercase;color:var(--mute);text-decoration:none}

.nav-toggle{position:absolute;opacity:0;pointer-events:none}
.burger{display:none;flex-direction:column;justify-content:space-between;width:24px;height:18px;cursor:pointer}
.burger span{display:block;height:2px;width:100%;background:var(--ink);border-radius:1px;
  transition:transform .22s ease,opacity .15s ease;transform-origin:center}
.scrim{display:none}

.nav-item{position:relative}
.nav-item .sub{list-style:none;margin:0;padding:8px 0;position:absolute;top:100%;left:0;min-width:210px;
  background:var(--paper);border:1px solid var(--rule);box-shadow:0 6px 16px rgba(43,33,24,.18);
  opacity:0;visibility:hidden;transform:translateY(4px);transition:opacity .15s ease,transform .15s ease,visibility .15s}
.nav-item .sub li a{display:block;padding:7px 16px;font-size:13px;letter-spacing:.06em;text-transform:none;text-decoration:none;color:var(--mute)}
.nav-item .sub li a:hover{color:var(--red)}
.nav-item:hover>.sub,.nav-item:focus-within>.sub{opacity:1;visibility:visible;transform:translateY(0)}

.hero{padding:52px 0 46px;border-bottom:1px solid var(--rule)}
.hero .wrap{display:grid;grid-template-columns:330px 1fr;gap:70px;align-items:center}
.hero h1{font-size:clamp(44px,6.6vw,78px);font-weight:600;letter-spacing:.01em}
.hero .sub{margin-top:16px;font-size:19px;color:var(--mute);max-width:40ch}
.hero .sub b{color:var(--ink);font-weight:600}

.plate-wrap{width:330px;max-width:100%}
.plate-img{display:block;width:100%;height:auto;
  filter:drop-shadow(0 16px 22px rgba(43,33,24,.32)) drop-shadow(0 2px 3px rgba(43,33,24,.3))}
.plate-cap{margin:18px 0 0;font-family:var(--disp);font-weight:400;font-size:12px;
  letter-spacing:.1em;text-transform:uppercase;color:var(--mute);line-height:1.75;text-align:center}
.plate-cap b{display:block;color:var(--ink);font-weight:600;letter-spacing:.12em}

.ident{margin-top:30px;max-width:400px}
.ident-lb{font-family:var(--disp);font-weight:500;font-size:12px;letter-spacing:.15em;
  text-transform:uppercase;color:var(--mute);display:block;margin-bottom:9px}
.ident-row{display:flex;align-items:stretch;gap:0;border:2px solid var(--ink);background:var(--paper-2)}
.ident-row select,.ident-row input{
  font-family:var(--disp);font-weight:500;font-size:19px;letter-spacing:.08em;
  background:transparent;border:0;color:var(--ink);padding:11px 12px;outline:none;min-width:0}
.ident-row select{border-right:2px solid var(--ink);flex:0 0 auto;text-transform:uppercase}
.ident-row input{flex:1;width:100%}
.ident-row input::placeholder{color:#9C8C70}
.ident-row button{
  font-family:var(--disp);font-weight:500;font-size:14px;letter-spacing:.12em;text-transform:uppercase;
  background:var(--red);color:var(--paper);border:0;border-left:2px solid var(--ink);
  padding:0 20px;cursor:pointer}
.ident-row button:hover{background:#8C1519}
.ident-note{margin:9px 0 0;font-size:14.5px;color:var(--mute)}

.sec{padding:46px 0;border-bottom:1px solid var(--rule)}
.sec .lead{margin-top:10px;color:var(--mute);max-width:56ch}

.tbl{margin-top:24px;width:100%;border-collapse:collapse;font-family:var(--disp);font-weight:400}
.tbl th{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);
  text-align:left;padding:0 14px 8px 0;border-bottom:2px solid var(--ink);font-weight:500}
.tbl td{padding:13px 14px 13px 0;border-bottom:1px solid var(--hair);font-size:16px;vertical-align:baseline}
.tbl tr:hover td{background:var(--paper-2)}
.tbl .k{font-weight:600;font-size:18px;letter-spacing:.06em;white-space:nowrap}
.tbl .d{font-family:var(--body);font-size:15.5px;color:var(--mute)}
.tbl a{text-decoration:none}
.tbl tr:hover .k{color:var(--red)}

.plates{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:26px}
.pl figure{margin:0}
.pl .img{aspect-ratio:4/5;background:
  repeating-linear-gradient(45deg,#CFC0A2 0 12px,#C7B79A 12px 24px);
  border:1px solid #8A7B5E;display:flex;align-items:flex-end;justify-content:center;
  filter:sepia(.35) contrast(1.04)}
.pl .img span{font-family:var(--disp);font-size:11px;letter-spacing:.12em;text-transform:uppercase;
  color:#6B5B45;padding:10px}
.pl figcaption{font-family:var(--disp);font-weight:600;font-size:12.5px;letter-spacing:.06em;
  text-align:center;margin-top:9px;color:var(--ink)}

.reg{margin-top:22px;border-top:2px solid var(--ink)}
.rec{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:baseline;
  padding:12px 0;border-bottom:1px solid var(--hair);text-decoration:none}
.rec:hover{background:var(--paper-2)}
.rt{font-family:var(--disp);font-weight:500;font-size:17px;letter-spacing:.05em;text-transform:uppercase}
.rm{font-family:var(--disp);font-weight:300;font-size:13px;color:var(--mute);letter-spacing:.05em;margin-top:1px}
.st{font-family:var(--disp);font-size:12px;letter-spacing:.11em;text-transform:uppercase;color:var(--mute);white-space:nowrap}
.st.a{color:var(--red)}
.act{margin-top:20px;font-family:var(--disp);font-size:14px;letter-spacing:.1em;text-transform:uppercase}
.act a{color:var(--red);text-decoration:none;border-bottom:1px solid var(--red);padding-bottom:2px}
.act a+a{margin-left:26px}

.two{display:grid;grid-template-columns:1fr 320px;gap:46px;align-items:start}
.two .lead{margin-top:12px}

.note{border-left:4px solid var(--red);padding:2px 0 2px 18px}
.note p{margin:0;color:var(--mute);font-size:16px}
.note b{color:var(--ink)}
.note a{color:var(--red)}

/* ---------- Encyklopedický článek ---------- */
.art{padding:40px 0 56px;max-width:820px;margin:0 auto}
.art .kicker{font-family:var(--disp);font-weight:500;font-size:12px;letter-spacing:.16em;
  text-transform:uppercase;color:var(--red);margin:0 0 10px}
.art h1{font-size:clamp(32px,5vw,52px);font-weight:600}
.art .lead{margin-top:16px;font-size:19.5px;color:var(--mute);line-height:1.55}
.art h2{margin:42px 0 14px;font-size:clamp(22px,3vw,29px)}
.art h3{margin:28px 0 8px;font-size:16px;letter-spacing:.06em}
.art p{max-width:68ch}
.art>section{scroll-margin-top:20px}

/* Shrnutí nahoře — "co se tu dozvíte" */
.tldr{margin:26px 0 6px;background:var(--paper-2);border:1px solid var(--rule);padding:18px 20px}
.tldr h2{margin:0 0 10px;font-size:12px;letter-spacing:.15em;color:var(--mute)}
.tldr ul{margin:0;padding-left:18px}
.tldr li{margin-bottom:5px;font-size:16px}

/* Obsah stránky (kotvy) */
.toc{margin:24px 0;padding:0 0 0 16px;border-left:3px solid var(--rule)}
.toc ol{margin:0;padding-left:18px;font-family:var(--disp);font-size:13.5px;letter-spacing:.05em}
.toc li{margin-bottom:4px}
.toc a{color:var(--mute);text-decoration:none}
.toc a:hover{color:var(--red)}

/* Box: pozor / časté chyby */
.warn{margin:26px 0;border:2px solid var(--red);background:#F3E7D6;padding:16px 20px}
.warn .lb{font-family:var(--disp);font-weight:600;font-size:11.5px;letter-spacing:.15em;
  text-transform:uppercase;color:var(--red);display:block;margin-bottom:8px}
.warn p{margin:0 0 .6em;font-size:16px}
.warn p:last-child{margin-bottom:0}
.warn ul{margin:0;padding-left:18px;font-size:16px}
.warn li{margin-bottom:5px}

/* Box: fakt / klíčový údaj */
.fact{margin:24px 0;border-left:4px solid var(--ink);background:var(--paper-2);padding:14px 18px}
.fact .lb{font-family:var(--disp);font-weight:500;font-size:11.5px;letter-spacing:.15em;
  text-transform:uppercase;color:var(--mute);display:block;margin-bottom:6px}
.fact p{margin:0;font-size:16.5px}

/* Srovnávací / technická tabulka */
.spec{margin:26px 0;width:100%;border-collapse:collapse;font-size:16px}
.spec caption{font-family:var(--disp);font-weight:500;font-size:11.5px;letter-spacing:.14em;
  text-transform:uppercase;color:var(--mute);text-align:left;padding-bottom:8px}
.spec th{font-family:var(--disp);font-weight:500;font-size:12.5px;letter-spacing:.1em;
  text-transform:uppercase;text-align:left;padding:9px 12px 9px 0;
  border-bottom:2px solid var(--ink);color:var(--mute)}
.spec td{padding:11px 12px 11px 0;border-bottom:1px solid var(--hair);vertical-align:top}
.spec tbody tr:hover td{background:var(--paper-2)}
.spec .rl{font-family:var(--disp);font-weight:500;letter-spacing:.04em;white-space:nowrap}
.spec .num{font-variant-numeric:tabular-nums;white-space:nowrap}

/* Obrázek s popiskem */
.fig{margin:30px 0}
.fig img{display:block;width:100%;height:auto;border:1px solid var(--rule);background:var(--paper-2)}
.fig figcaption{margin-top:9px;font-size:14.5px;color:var(--mute);line-height:1.5}
.fig figcaption b{color:var(--ink);font-weight:600}
.fig .cred{display:block;margin-top:4px;font-family:var(--disp);font-size:11px;
  letter-spacing:.08em;text-transform:uppercase;color:var(--mute);opacity:.8}
.fig--wide{margin-left:calc((100% - 100vw)/2);margin-right:calc((100% - 100vw)/2);max-width:100vw}

/* Zástupný obrázek, dokud nemáme fotku */
.fig .ph{aspect-ratio:4/3;border:1px dashed var(--rule);background:
  repeating-linear-gradient(45deg,#DFD2B4 0 14px,#D8CAAA 14px 28px);
  display:flex;align-items:center;justify-content:center;text-align:center;padding:20px}
.fig .ph span{font-family:var(--disp);font-size:11.5px;letter-spacing:.12em;
  text-transform:uppercase;color:#7A6A50;max-width:26ch;line-height:1.7}

/* Galerie */
.gal{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;margin:28px 0}
.gal figure{margin:0}
.gal img{display:block;width:100%;height:auto;border:1px solid var(--rule)}
.gal figcaption{margin-top:7px;font-size:13.5px;color:var(--mute)}

/* Zdroje */
.src{margin:44px 0 0;padding-top:18px;border-top:2px solid var(--ink)}
.src h2{margin:0 0 10px;font-size:12px;letter-spacing:.15em;color:var(--mute)}
.src ol{margin:0;padding-left:20px;font-size:15px;color:var(--mute)}
.src li{margin-bottom:7px}
.src cite{font-style:italic}
.src .tag{font-family:var(--disp);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;
  border:1px solid var(--rule);padding:1px 6px;margin-left:6px;white-space:nowrap}
.src .tag.ov{border-color:var(--ink);color:var(--ink)}
.src .tag.ne{border-color:var(--red);color:var(--red)}

/* Navigace mezi články */
.next{margin-top:40px;display:grid;grid-template-columns:1fr 1fr;gap:16px}
.next a{display:block;padding:14px 16px;border:1px solid var(--rule);text-decoration:none;background:var(--paper-2)}
.next a:hover{border-color:var(--red)}
.next .lb{font-family:var(--disp);font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--mute)}
.next .tt{font-family:var(--disp);font-weight:500;font-size:16px;letter-spacing:.03em;margin-top:3px;display:block}

@media (max-width:880px){
  .art{padding:28px 0 40px}
  .art h2{margin:32px 0 12px}
  .spec{font-size:15px}
  .spec th,.spec td{padding-right:8px}
  .next{grid-template-columns:1fr}
  .fig--wide{margin-left:0;margin-right:0;max-width:100%}
}

.foot{border-top:3px double var(--ink);padding:34px 0 42px;font-size:15.5px}
.fg{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:34px}
.foot h4{font-family:var(--disp);font-size:12px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 11px;font-weight:500;color:var(--mute)}
.foot ul{list-style:none;margin:0;padding:0}
.foot li{margin-bottom:6px}
.foot a{color:var(--mute);text-decoration:none}
.foot a:hover{color:var(--red)}
.foot .lead{margin:0;color:var(--mute)}
.foot .lead b{color:var(--ink)}
.colo{margin-top:28px;padding-top:13px;border-top:1px solid var(--rule);
  font-family:var(--disp);font-weight:300;font-size:11.5px;letter-spacing:.07em;
  text-transform:uppercase;color:var(--mute);line-height:1.9}

@media (max-width:880px){
  .hero .wrap{grid-template-columns:1fr;gap:36px;justify-items:center;text-align:center}
  .hero .sub{margin-left:auto;margin-right:auto}
  .two{grid-template-columns:1fr;gap:28px}
  .plates{grid-template-columns:1fr 1fr}
  .fg{grid-template-columns:1fr 1fr}

  /* Burger vpravo — .lang se v liště skryje, přesouvá se dovnitř panelu */
  .burger{display:flex;margin-left:auto;z-index:40}
  .top .wrap>.lang{display:none}

  /* Ztmavení stránky za panelem, klepnutí zavírá menu */
  .scrim{display:block;position:fixed;inset:0;background:rgba(28,21,14,.5);
    opacity:0;visibility:hidden;transition:opacity .22s ease,visibility .22s;z-index:25}
  .nav-toggle:checked~.scrim{opacity:1;visibility:visible}

  .nav{
    position:fixed;top:0;right:0;bottom:0;width:min(80vw,310px);
    background:#E8DEC8;flex-direction:column;align-items:stretch;gap:0;
    padding:70px 24px 28px;transform:translateX(100%);
    transition:transform .26s cubic-bezier(.4,0,.2,1);
    box-shadow:-12px 0 30px rgba(43,33,24,.3);overflow-y:auto;z-index:30}

  .nav>a,.nav-item{width:100%;border-bottom:1px solid var(--hair)}
  .nav>a,.nav-item>a{display:block;padding:15px 2px;font-size:15px}
  .nav-item>a{color:var(--ink)}

  .nav-item .sub{position:static;opacity:1;visibility:visible;transform:none;
    box-shadow:none;border:none;background:transparent;padding:2px 0 12px 14px}
  .nav-item .sub li a{padding:9px 0;font-size:14px}

  /* Jazyk dole v panelu */
  .nav .lang-in{display:block;margin-top:22px;padding:10px 0;text-align:center;
    border:1px solid var(--ink);text-decoration:none;color:var(--ink);
    font-family:var(--disp);font-size:13px;letter-spacing:.11em;text-transform:uppercase}

  .nav-toggle:checked~.nav{transform:translateX(0)}
  .nav-toggle:checked~.burger span:nth-child(1){transform:translateY(8px) rotate(45deg)}
  .nav-toggle:checked~.burger span:nth-child(2){opacity:0}
  .nav-toggle:checked~.burger span:nth-child(3){transform:translateY(-8px) rotate(-45deg)}

  /* Když je menu otevřené, stránka pod ním neroluje */
  .nav-toggle:checked~.scrim{touch-action:none}
}

@media (min-width:881px){
  .nav .lang-in{display:none}
}
@media (max-width:520px){
  .plates{grid-template-columns:1fr}
  .fg{grid-template-columns:1fr}
  .tbl .d{display:none}
}
</style>
</head>
<body>
<header class="top">
  <div class="wrap">
    <a class="brand" href="/">Jawa<i>pérák</i></a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">
    <label for="nav-toggle" class="burger" aria-label="Otevřít menu">
      <span></span><span></span><span></span>
    </label>
    <label for="nav-toggle" class="scrim" aria-hidden="true"></label>

    <nav class="nav" aria-label="Hlavní">
      <div class="nav-item">
        <a href="/perak/">Typy</a>
        <ul class="sub">
          <li><a href="/perak/typ-10-a-typ-11/">Typ 10 a typ 11</a></li>
          <li><a href="/perak/motor-12-vs-18/">Motor 12 vs 18</a></li>
        </ul>
      </div>
      <a href="/registr/">Registr</a>
      <a href="/dilna/">Dílna</a>
      <a href="/navody/">Návody</a>
      <a href="/historie/">Historie</a>
      <a class="lang-in" href="/en/" hreflang="en">English</a>
    </nav>

    <a class="lang" href="/en/" hreflang="en">English</a>
  </div>
</header>

<slot />

<footer class="foot">
  <div class="wrap">
    <div class="fg">
      <div>
        <h4>Kdo to píše</h4>
        <p class="lead"><b>PureBikes</b> — renovace, generálky a výroba dílů pro Jawu a ČZ. Drahanovice u Olomouce.</p>
      </div>
      <div>
        <h4>Web</h4>
        <ul><li><a href="/perak/">Typová řada</a></li><li><a href="/registr/">Registr strojů</a></li><li><a href="/navody/">Návody</a></li><li><a href="/historie/">Historie</a></li></ul>
      </div>
      <div>
        <h4>Dílna</h4>
        <ul><li><a href="/sluzby/prohlidka-pred-koupi/">Prohlídka před koupí</a></li><li><a href="/sluzby/vyroba-dilu/">Výroba dílů</a></li><li><a href="/sluzby/renovace/">Renovace</a></li><li><a href="/kontakt/">Kontakt</a></li></ul>
      </div>
    </div>
    <p class="colo">jawaperak.cz — nezávislý web o motocyklu Jawa 250/350 Pérák<br>Není spojeno se značkou Jawa Moto ani Classic Legends</p>
  </div>
</footer>
</body>
</html>
