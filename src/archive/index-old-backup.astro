---
import Layout from '../layouts/Layout.astro';
import photos from '../data/homepage.json';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// Registr — nejnovější schválené záznamy a souhrnná statistika se načítají
// přímo tady, v serverovém frontmatteru (při buildu/requestu), ne klientským
// skriptem do prázdného <div>. Web tak nikdy neukazuje blikající skeleton
// a data jsou hned součástí vykresleného HTML. Fetch je zabalený v timeoutu
// a try/catch — když Supabase neodpoví (výpadek sítě při buildu), stránka se
// přesto sestaví, jen se zobrazí prázdný stav registru.
type NejnovejsiStroj = {
  slug: string;
  typ: string;
  rok_vyroby: number | null;
  stav: string | null;
  region: string | null;
  zeme: string | null;
  cislo_ramu_maskovane: string | null;
};

const STAV_POPIS: Record<string, string> = {
  puvodni: 'původní patina',
  renovovano: 'po renovaci',
  v_renovaci: 'v renovaci',
  vrak: 'nálezový stav',
  na_dily: 'na díly',
};

async function fetchJson(url: string, timeoutMs = 6000) {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), timeoutMs);
  try {
    const r = await fetch(url, {
      headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}`, Prefer: 'count=exact' },
      signal: ctrl.signal,
    });
    const total = Number(r.headers.get('content-range')?.split('/')?.[1] ?? 0);
    const data = r.ok ? await r.json() : [];
    return { data: Array.isArray(data) ? data : [], total };
  } catch {
    return { data: [] as any[], total: 0 };
  } finally {
    clearTimeout(t);
  }
}

let nejnovejsi: NejnovejsiStroj[] = [];
let souhrn = { celkem: 0, pocet250: 0, pocet350: 0, puvodni: 0 };

if (SUPABASE_URL && SUPABASE_KEY) {
  const [posledni, vsechny] = await Promise.all([
    fetchJson(
      `${SUPABASE_URL}/rest/v1/stroje_verejne?select=slug,typ,rok_vyroby,stav,region,zeme,cislo_ramu_maskovane&order=schvaleno_at.desc&limit=4`
    ),
    fetchJson(`${SUPABASE_URL}/rest/v1/stroje_verejne?select=typ,stav&limit=1000`),
  ]);
  nejnovejsi = posledni.data as NejnovejsiStroj[];
  const vsechnyRadky = vsechny.data as { typ: string; stav: string | null }[];
  souhrn.celkem = vsechny.total || vsechnyRadky.length;
  souhrn.pocet250 = vsechnyRadky.filter((s) => s.typ === '11').length;
  souhrn.pocet350 = vsechnyRadky.filter((s) => s.typ === '12' || s.typ === '18').length;
  souhrn.puvodni = vsechnyRadky.filter((s) => s.stav === 'puvodni').length;
}

const maSoucet = souhrn.pocet250 + souhrn.pocet350 > 0;
const podil250 = maSoucet ? Math.round((souhrn.pocet250 / (souhrn.pocet250 + souhrn.pocet350)) * 100) : 0;
const podilPuvodni = souhrn.celkem > 0 ? Math.round((souhrn.puvodni / souhrn.celkem) * 100) : 0;
---
<Layout title="Pérák — typy, výrobní čísla, technika | jawaperak.cz">

<!-- ============================================================
     MUZEJNÍ REJSTŘÍK — hero + fakta
     ============================================================ -->
<section class="ld-hero">
  {photos.hero.image ? (
    <img class="ld-hero__img" src={photos.hero.image} alt={photos.hero.alt} />
  ) : (
    <div class="ld-hero__ph" aria-hidden="true"><span>{photos.hero.placeholderText}</span></div>
  )}
  <div class="ld-hero__scrim"></div>
  <div class="ld-hero__text">
    <p class="ld-eyebrow">Zbrojovka Ing. F. Janeček — Praha-Nusle II.</p>
    <h1 class="ld-h1">Pérák</h1>
    <p class="ld-sub">Devět let výroby, dva objemy motoru a stroj, který dodnes definuje poválečné motocyklové Československo. <strong>Kompletní historie, technika i registr dochovaných kusů na jednom místě.</strong></p>
  </div>
</section>

<section class="facts">
  <h2 class="facts__h">V číslech.</h2>
  <div class="facts__grid">
    <div class="fnum">
      <span class="fnum__n">11 · 12 · 18</span>
      <span class="fnum__l">typová označení</span>
    </div>
    <a class="fnum fnum--link" href="/perak/identifikace/#kolik">
      <span class="fnum__n">128 000+ ks</span>
      <span class="fnum__l">vyrobeno, typ 11 — dolní mez <span class="stamp od">odhad</span></span>
    </a>
    <div class="fnum">
      <span class="fnum__n">Praha-Nusle</span>
      <span class="fnum__l">Zbrojovka Ing. F. Janečka</span>
    </div>
    <div class="fnum">
      <span class="fnum__n fnum__n--inf">∞</span>
      <span class="fnum__l">zážitků</span>
    </div>
  </div>
</section>

<!-- ============================================================
     TYPOVÁ ŘADA — široký srovnávací blok, mimo úzký textový sloupec
     ============================================================ -->
<div class="wrap wrap--wide">
  <section class="sec sec--wide" id="typova-rada">
    <div class="sec-h">
      <span class="sec-n">01</span>
      <h2>Typová řada</h2>
      <p class="sub">Dvě kubatury, tři typová označení. Motory ani díly nejsou zaměnitelné.</p>
    </div>

    <div class="tcards">
      <article class="tcard">
        <header class="tcard__h">
          <span class="tcard__typ">Typ 11</span>
          <span class="tcard__stroj">Jawa 250</span>
        </header>
        <p class="tcard__yr">1946–1954 <span class="stamp ov">ověřeno</span></p>
        <ul class="tcard__badges">
          <li><b>248,5 cm³</b><small>objem, jednoválec</small></li>
          <li><b>6,6–7,4 kW</b><small>9–10 k, od 1950 víc</small></li>
          <li><b>150 → 160 mm</b><small>brzdový buben, zlom u <span class="num">11-61551</span></small></li>
          <li><b>Ano, do ~1949</b><small>dekompresor v hlavě <span class="stamp od">odhad</span></small></li>
        </ul>
        <p class="tcard__note">Nejrozšířenější typ řady — nejméně 128 000 vyrobených kusů.</p>
        <a class="tcard__link" href="/perak/250/">Pérák 250 — typ 10 a 11</a>
      </article>

      <article class="tcard">
        <header class="tcard__h">
          <span class="tcard__typ">Typ 12</span>
          <span class="tcard__stroj">Jawa 350 „Ogar“</span>
        </header>
        <p class="tcard__yr">1948–1950 <span class="stamp ov">ověřeno</span></p>
        <ul class="tcard__badges">
          <li><b>344,0 cm³</b><small>objem, dvouválec</small></li>
          <li><b>8,8 kW</b><small>12 k při 4 000 ot/min</small></li>
          <li><b>150 mm</b><small>brzdový buben, po celou výrobu</small></li>
          <li><b>Ne</b><small>dekompresor v hlavě <span class="stamp od">odhad</span></small></li>
        </ul>
        <p class="tcard__note">Vzácný dvouválec se šesti provedeními klikového ústrojí za dva roky.</p>
        <a class="tcard__link" href="/perak/350/">Pérák 350 — typ 12 a 18</a>
      </article>

      <article class="tcard">
        <header class="tcard__h">
          <span class="tcard__typ">Typ 18</span>
          <span class="tcard__stroj">Jawa 350</span>
        </header>
        <p class="tcard__yr">1950–1954 <span class="stamp od">odhad</span></p>
        <ul class="tcard__badges">
          <li><b>344,0 cm³</b><small>objem, dvouválec</small></li>
          <li><b>10,3 kW</b><small>14 k při 4 500 ot/min</small></li>
          <li><b>160 mm</b><small>brzdový buben, unifikováno s typem 11</small></li>
          <li><b>Ne</b><small>dekompresor v hlavě <span class="stamp od">odhad</span></small></li>
        </ul>
        <p class="tcard__note">Nástupce typu 12, vyráběn souběžně s typem 11.</p>
        <a class="tcard__link" href="/perak/350/">Pérák 350 — typ 12 a 18</a>
      </article>
    </div>

    <div class="rel">
      <span class="t">Souvisí</span>
      <a href="/perak/identifikace/">Určení podle výrobního čísla</a>
      <a href="/perak/technicke-udaje/">Technické údaje</a>
      <a href="/dekoder/">Forenzní dekodér štítku</a>
    </div>
  </section>
</div>

<!-- ============================================================
     TECHNICKÝ ARCHIV — identifikace, údržba, registr
     ============================================================ -->
<div class="wrap">
  <div class="page">

    <section class="sec" id="identifikace">
      <div class="sec-h">
        <span class="sec-n">02</span>
        <h2>Co mám za stroj</h2>
        <p class="sub">Opište tovární číslo ze štítku nebo z rámu. Řekneme vám rok výroby, provedení a na co si dát pozor.</p>
      </div>

      <div class="tool">
        <div class="tool-h">
          <span class="t">Určení podle výrobního čísla</span>
          <span class="s">rychlý odhad — <a href="/perak/identifikace/">plný nástroj v encyklopedii</a></span>
        </div>
        <div class="tool-b">
          <div class="ld-seg" role="group" aria-label="Typ stroje">
            <button type="button" class="ld-seg__btn is-on" data-typ="11">Typ 11</button>
            <button type="button" class="ld-seg__btn" data-typ="12">Typ 12</button>
            <button type="button" class="ld-seg__btn" data-typ="18">Typ 18</button>
          </div>
          <div class="tool-row">
            <label for="ld-cislo" class="ld-sr">Tovární číslo</label>
            <input type="text" id="ld-cislo" inputmode="numeric" autocomplete="off" placeholder="tovární číslo, např. 11-12862">
            <button type="button" id="ld-go">Určit</button>
          </div>
          <div class="ld-out" id="ld-out" aria-live="polite">
            <div class="ld-out__typ">Vybráno: typ <span id="ld-out-typ">11</span></div>
            <div class="ld-out__body" id="ld-out-body" hidden>
              <p class="ld-out__head" id="ld-out-head"></p>
              <p class="ld-out__desc" id="ld-out-desc"></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec" id="udrzba">
      <div class="sec-h">
        <span class="sec-n">03</span>
        <h2>Obsluha a údržba</h2>
        <p class="sub">Podle původní knížky obsluhy, přefocené a doplněné o to, co se za osmdesát let ukázalo.</p>
      </div>

      <div class="spots">
        {photos.udrzba.map((p) => (
          <article class="spot">
            {p.image ? (
              <div class="im"><img src={p.image} alt={p.alt} loading="lazy" /></div>
            ) : (
              <div class="im" aria-hidden="true"><b>{p.placeholderText}</b></div>
            )}
            <h4>{p.caption}</h4>
          </article>
        ))}
      </div>
    </section>

    <section class="sec" id="registr">
      <div class="sec-h">
        <span class="sec-n">04</span>
        <h2>Registr strojů</h2>
        <p class="sub">Kolik Péráků se dochovalo, neví nikdo. Zkoušíme to spočítat.</p>
      </div>

      {souhrn.celkem > 0 && (
        <div class="reg-viz" aria-label="Souhrnná statistika registru">
          <div class="rv-block">
            <div class="rv-h">
              <span>250 ccm</span>
              <span>350 ccm</span>
            </div>
            <div class="rv-bar" role="img" aria-label={`${souhrn.pocet250} strojů 250 ccm, ${souhrn.pocet350} strojů 350 ccm`}>
              <i style={`width:${podil250}%`}></i>
            </div>
            <div class="rv-f">
              <span>{souhrn.pocet250} ks · {podil250}&nbsp;%</span>
              <span>{souhrn.pocet350} ks · {100 - podil250}&nbsp;%</span>
            </div>
          </div>
          <div class="rv-block">
            <div class="rv-h">
              <span>Původní patina</span>
              <span>Renovováno a jiné</span>
            </div>
            <div class="rv-bar rv-bar--ocel" role="img" aria-label={`${souhrn.puvodni} strojů v původní patině z ${souhrn.celkem} celkem`}>
              <i style={`width:${podilPuvodni}%`}></i>
            </div>
            <div class="rv-f">
              <span>{souhrn.puvodni} ks · {podilPuvodni}&nbsp;%</span>
              <span>{souhrn.celkem - souhrn.puvodni} ks · {100 - podilPuvodni}&nbsp;%</span>
            </div>
          </div>
        </div>
      )}

      <div class="reg" aria-live="polite">
        {nejnovejsi.length > 0 ? nejnovejsi.map((s) => {
          const misto = [s.region, s.zeme].filter(Boolean).join(', ');
          const meta = [misto, s.cislo_ramu_maskovane ? `rám ${s.cislo_ramu_maskovane}` : ''].filter(Boolean).join(' · ');
          return (
            <a class="rec" href={`/registr/stroj/${s.slug}/`}>
              <span class="rec__l">
                <span class="rt">Typ {s.typ}{s.rok_vyroby ? ` · ${s.rok_vyroby}` : ''}</span>
                {meta && <span class="rm">{meta}</span>}
              </span>
              <span class="st">{s.stav ? (STAV_POPIS[s.stav] ?? s.stav) : ''}</span>
            </a>
          );
        }) : (
          <p class="reg-prazdno">Registr se teprve plní. Když přidáte svůj stroj, budete mezi prvními.</p>
        )}
      </div>

      <div class="reg-cta">
        <a class="btn" href="/registr/pridat-stroj/">Přidat stroj</a>
        <a class="reg-cta__more" href="/registr/">Celý registr</a>
      </div>
    </section>

  </div>
</div>

<!-- ============================================================
     ZPĚT DO MUZEJNÍHO REJSTŘÍKU — dílna (PureBikes funnel)
     ============================================================ -->
<section class="ld-dilna">
  <div class="ld-dilna__inner">
    <div class="ld-dilna__text">
      <h2 class="ld-h2 ld-h2--ink">Z naší dílny</h2>
      <p class="ld-dilna__p">Historie stroje patří k jeho hodnotě. Kde to jde, patinu zachováváme a konzervujeme — místo aby zmizela pod novým lakem.</p>
      <a class="ld-dilna__link" href="/dilna/">Renovační deníky</a>
    </div>
    <figure class="ld-dilna__photo">
      {photos.dilna.image ? (
        <img class="ld-dilna__img" src={photos.dilna.image} alt={photos.dilna.alt} />
      ) : (
        <div class="ld-dilna__ph" aria-hidden="true"><span>{photos.dilna.placeholderText}</span></div>
      )}
      <figcaption>{photos.dilna.caption}</figcaption>
    </figure>
  </div>
</section>

<section class="ld-versus">
  <strong>Hledáte novou Jawu Perak?</strong>
  <span class="ld-versus__body">Bobber, který od roku 2019 vyrábí indický koncern Classic Legends. Jméno si vypůjčil od stroje z roku 1946.</span>
  <a class="ld-versus__link" href="/perak-vs-perak/">Rozdíly vedle sebe</a>
</section>

</Layout>

<script>
  // Rychlý odhad roku výroby přímo na homepage — stejná tabulka rozsahů
  // výrobních čísel jako plný nástroj na /perak/identifikace/ (odvozeno
  // z ~240 fotografií původních štítků). Pokrývá průběžnou řadu čísel
  // do roku 1951; pro roční řady od 1952 (číslo s dvouciferným rokem
  // na konci) odkazuje na plný nástroj.
  const ROKY = {
    '11': [[1946,1,1500],[1947,1501,15800],[1948,15801,34900],[1949,34901,53800],[1950,53801,73000],[1951,73001,90000]],
    '12': [[1948,1,900],[1949,901,4500],[1950,4501,10000]],
    '18': [[1950,1,8000],[1951,8001,14200]]
  };
  const POZNAMKY = {
    '11': 'Jednoválec 248,5 cm³. U strojů do roku 1949 hlídejte původnost hlavy a nižší výkon.',
    '12': 'Dvouválec, vyráběn krátce. Náhradní díly pohonu jsou nejhůř dostupné z celé řady.',
    '18': 'Nástupce typu 12. Kontrolujte elektroinstalaci a stav dynama.'
  };

  let typ = '11';
  const seg = document.querySelectorAll('.ld-seg__btn');
  const elTyp = document.getElementById('ld-out-typ');
  const elCislo = document.getElementById('ld-cislo');
  const elBody = document.getElementById('ld-out-body');
  const elHead = document.getElementById('ld-out-head');
  const elDesc = document.getElementById('ld-out-desc');

  seg.forEach((b) => b.addEventListener('click', () => {
    typ = b.dataset.typ;
    seg.forEach((x) => x.classList.toggle('is-on', x === b));
    elTyp.textContent = typ;
  }));

  function odhadniRok(t, cislo) {
    const tab = ROKY[t] || [];
    for (const [rok, od, doC] of tab) {
      if (cislo >= od && cislo <= doC) return rok;
    }
    return null;
  }

  function vyhodnot() {
    const cifry = (elCislo.value || '').replace(/\D/g, '');
    if (cifry.length < 3) {
      elBody.hidden = false;
      elHead.textContent = 'Zadejte tovární číslo';
      elDesc.textContent = 'Číslo najdete na štítku na rámu pod sedlem, případně vyražené na rámu.';
      return;
    }
    const cislo = parseInt(cifry.slice(-6), 10);
    const rok = odhadniRok(typ, cislo);
    elBody.hidden = false;
    if (rok) {
      elHead.textContent = `Typ ${typ} · ${cislo} — orientačně rok ${rok}`;
      elDesc.textContent = POZNAMKY[typ] || '';
    } else {
      elHead.textContent = 'Mimo rozsah rychlého odhadu';
      elDesc.textContent = 'Tahle rychlá tabulka platí přibližně do roku 1951. Pro čísla s ročním sufixem od roku 1952 (např. 11-07390-52) použijte kompletní nástroj na stránce Určení podle výrobního čísla.';
    }
  }

  document.getElementById('ld-go').addEventListener('click', vyhodnot);
  elCislo.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); vyhodnot(); } });
</script>

<style>
  .ld-sr{position:absolute;left:-9999px}

  /* --- Typová řada: široký 3sloupcový srovnávač (mimo textový sloupec) --- */
  .sec--wide{padding:46px 0;border-bottom:1px solid var(--rule)}
  .tcards{margin-top:28px;display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .tcard{border:1px solid var(--rule);background:var(--card);padding:22px 24px 24px;
    display:flex;flex-direction:column;gap:14px;transition:border-color .15s,box-shadow .15s}
  .tcard:hover{border-color:var(--ink);box-shadow:0 6px 18px rgba(20,19,18,.08)}
  .tcard__h{display:flex;align-items:baseline;justify-content:space-between;gap:10px;
    padding-bottom:12px;border-bottom:2px solid var(--ink)}
  .tcard__typ{font-family:var(--mono);font-weight:500;font-size:22px;letter-spacing:.02em;color:var(--red)}
  .tcard__stroj{font-family:var(--disp);font-size:12.5px;letter-spacing:.06em;color:var(--mute);text-align:right}
  .tcard__yr{margin:0;font-family:var(--mono);font-size:14px;letter-spacing:.02em;color:var(--mute-2)}
  .tcard__badges{list-style:none;margin:0;padding:0;display:grid;gap:10px}
  .tcard__badges li{display:flex;flex-direction:column;gap:1px;padding:8px 10px;background:var(--paper-2)}
  .tcard__badges b{font-family:var(--mono);font-size:16px;font-weight:500;letter-spacing:.01em;color:var(--ink)}
  .tcard__badges small{font-family:var(--disp);font-size:11px;letter-spacing:.03em;color:var(--mute-2);line-height:1.4}
  .tcard__note{margin:0;font-size:14.5px;color:var(--mute);line-height:1.5;flex:1}
  .tcard__link{margin-top:auto;font-family:var(--disp);font-size:12.5px;letter-spacing:.08em;
    text-transform:uppercase;color:var(--red);text-decoration:none;border-bottom:1px solid var(--red);
    padding-bottom:2px;align-self:flex-start}
  .tcard__link:hover{color:var(--red-hover);border-color:var(--red-hover)}

  @media (max-width:900px){
    .tcards{grid-template-columns:1fr}
  }

  /* --- Hero --- */
  .ld-hero{position:relative;height:520px;overflow:hidden;border-bottom:1px solid var(--rule)}
  .ld-hero__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .ld-hero__ph{position:absolute;inset:0;background:repeating-linear-gradient(45deg,var(--ph-1) 0 14px,var(--ph-2) 14px 28px);
    display:flex;align-items:center;justify-content:center;text-align:center;padding:20px}
  .ld-hero__ph span{font-family:var(--disp);font-size:12px;letter-spacing:.1em;text-transform:uppercase;
    color:var(--mute-2);max-width:26ch;line-height:1.6}
  .ld-hero__scrim{position:absolute;left:0;bottom:0;width:100%;height:70%;
    background:linear-gradient(to top,rgba(20,18,16,.82),transparent);pointer-events:none}
  .ld-hero__text{position:absolute;left:44px;bottom:40px;max-width:640px;color:var(--paper)}
  .ld-eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;
    opacity:.75;margin:0}
  .ld-h1{font-family:var(--head);font-size:clamp(44px,9vw,82px);line-height:1;font-weight:500;
