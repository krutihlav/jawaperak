---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { hasNoEnEquivalent } from '../utils/i18nEquivalence';

export interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const currentLocale = Astro.currentLocale ?? 'cs';
const targetLocale = currentLocale === 'cs' ? 'en' : 'cs';
const path = Astro.url.pathname.replace(/^\/en(\/|$)/, '/');
// Switcher na stránkách bez EN ekvivalentu místo 404 vede na EN homepage.
const targetUrl = hasNoEnEquivalent(currentLocale, Astro.url.pathname)
  ? getRelativeLocaleUrl('en', '/')
  : getRelativeLocaleUrl(targetLocale, path);
---
<a class={className} href={targetUrl}>{currentLocale === 'cs' ? 'English' : 'Česky'}</a>
