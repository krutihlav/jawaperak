---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { hasNoEnEquivalent } from '../i18n/utils';

export interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const currentLocale = Astro.currentLocale ?? 'cs';
const targetLocale = currentLocale === 'cs' ? 'en' : 'cs';
const path = Astro.url.pathname.replace(/^\/en(\/|$)/, '/');
// Switcher na stránkách bez EN ekvivalentu místo 404 vede na EN homepage.
const targetUrl = hasNoEnEquivalent(currentLocale, Astro.url.pathname)
  ? getRelativeLocaleUrl('en', '/')
  : getRelativeLocaleUrl(targetLocale, path);
// Cookie `locale` zapisuje jen tenhle klik (viz middleware.ts) — a jen
// pokud uživatel dřív odsouhlasil cookie lištu (CookieConsent.astro).
const setCookieJs = `if (localStorage.getItem('cookie_consent') === 'accepted') { document.cookie = 'locale=${targetLocale}; path=/; max-age=31536000; SameSite=Lax'; }`;
---
<a class={className} href={targetUrl} onclick={setCookieJs}>{currentLocale === 'cs' ? 'English' : 'Česky'}</a>
