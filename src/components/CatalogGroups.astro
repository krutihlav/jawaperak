---
// src/components/CatalogGroups.astro
// Konstrukční skupiny originálního katalogu dílů 1949 — sdílený seznam
// s prohlížečem katalogu (data/katalogSkupiny.ts), každá karta odkazuje
// na začátek skupiny v prohlížeči.
import { KATALOG_SKUPINY, katalogSkupinaUrl } from '../data/katalogSkupiny';
---

<section class="space-y-6">
  <div class="flex items-baseline justify-between border-b border-[var(--rule)] pb-4">
    <div>
      <span class="text-xs font-mono uppercase tracking-wider text-[var(--red)] font-semibold">Originální katalog náhradních dílů 1949</span>
      <h2 class="text-2xl sm:text-3xl font-serif text-[var(--ink)] mt-0.5">
        Konstrukční skupiny a rozkresy součástek
      </h2>
    </div>
    <span class="text-xs font-mono text-[var(--mute)] hidden sm:inline">140 stran</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {KATALOG_SKUPINY.map((group) => (
      <a
        href={katalogSkupinaUrl(group.index)}
        class="block p-5 rounded-xl border border-[var(--rule)] bg-[var(--card)] space-y-2 hover:border-[var(--red)] transition-all shadow-sm no-underline"
      >
        <h3 class="font-bold text-base text-[var(--ink)]">{group.name}</h3>
        <p class="text-xs font-mono text-[var(--red)] font-bold">
          od dvoustrany č. {group.index + 1} (orientačně)
        </p>
      </a>
    ))}
  </div>
</section>
