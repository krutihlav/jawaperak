---
// src/components/WorkshopBanner.astro
// Autentická prezentace dílny PureBikes v Drahanovicích u Olomouce
// Plně integrovaná do tiskařského design systému jawaperak.cz
---

<div class="rounded-3xl border border-[var(--rule)] bg-[var(--paper-2)] p-8 sm:p-12 space-y-8 shadow-xs relative overflow-hidden">
  <div class="max-w-4xl space-y-6 relative z-10">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--rule)] pb-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--card)] text-[var(--red)] border border-[var(--rule)] text-xs font-mono uppercase tracking-widest font-semibold shadow-xs">
        <span>Dílna PureBikes • Drahanovice u Olomouce</span>
      </div>
      <span class="text-xs font-mono text-[var(--mute)]">
        Konzervace patiny &amp; ověřování pravosti
      </span>
    </div>

    <blockquote class="text-2xl sm:text-3xl lg:text-4xl font-serif font-normal leading-tight text-[var(--ink)] border-l-4 border-[var(--red)] pl-4 sm:pl-6 my-2">
      „Historie a patina stroje patří k jeho nejvyšší hodnotě. Kde to jde, zachováváme původní stav — místo aby zmizel pod novým lakem.“
    </blockquote>

    <p class="text-sm sm:text-base text-[var(--mute)] font-sans leading-relaxed max-w-3xl">
      Píše <strong>Adam Kment</strong>. Pomáháme sběratelům a nadšencům s fyzickou prohlídkou Péráka před koupí, ověřením pravosti výrobních čísel a odchylek, šetrnou konzervací patiny po desetiletích spánku ve stodole i výrobou specifických chybějících dílů.
    </p>

    {/* 3 karty služeb na bílém podkladu (--card) */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
      <div class="bg-[var(--card)] p-4 sm:p-5 rounded-2xl border border-[var(--rule)] shadow-xs flex flex-col justify-between hover:border-[var(--red)] transition-colors">
        <span class="text-[var(--red)] font-mono font-bold text-xs block mb-1">01. Prohlídka před koupí</span>
        <p class="text-[var(--mute)] text-xs leading-relaxed">Asistence a kontrola originality karterů a rámu před podpisem smlouvy.</p>
      </div>

      <div class="bg-[var(--card)] p-4 sm:p-5 rounded-2xl border border-[var(--rule)] shadow-xs flex flex-col justify-between hover:border-[var(--red)] transition-colors">
        <span class="text-[var(--red)] font-mono font-bold text-xs block mb-1">02. Konzervace patiny</span>
        <p class="text-[var(--mute)] text-xs leading-relaxed">Šetrné chemické čištění a voskování původních linek a červeně ČSN 8850.</p>
      </div>

      <div class="bg-[var(--card)] p-4 sm:p-5 rounded-2xl border border-[var(--rule)] shadow-xs flex flex-col justify-between hover:border-[var(--red)] transition-colors">
        <span class="text-[var(--red)] font-mono font-bold text-xs block mb-1">03. Výroba chybějících dílů</span>
        <p class="text-[var(--mute)] text-xs leading-relaxed">Přesná kusová zámečnická výroba podle originálních výkresů a vzorů.</p>
      </div>
    </div>

    {/* Akční řádek */}
    <div class="pt-4 flex flex-wrap items-center gap-4 border-t border-[var(--rule)]">
      <a
        href="mailto:adas.kment@gmail.com"
        class="px-6 py-3 rounded-xl bg-[var(--red)] hover:bg-[var(--red-hover)] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-xs"
      >
        Napsat Adamovi Kmentovi
      </a>
      <span class="text-xs font-mono text-[var(--mute)]">
        adas.kment@gmail.com • Drahanovice u Olomouce
      </span>
    </div>
  </div>
</div>
