---
// Muzejní úvod pro stránky, které dál pokračují do archivní hustoty
// (model page 250/350, případně další jednotémové "vstupní" stránky).
// Jeden vizuál, jedna sjednocující myšlenka, minimum prvků — viz brief
// "muzejní úvod → technický archiv". Obsah pod <slot /> je věta/dvě,
// psaná přímo na volající stránce (může obsahovat <strong>/<em>).
export interface Props {
  eyebrow: string;
  eyebrowHref?: string;
  title: string;
  image?: string;
  alt?: string;
  placeholderText?: string;
}
const { eyebrow, eyebrowHref, title, image = '', alt = '', placeholderText = '' } = Astro.props;
---
<section class="mh">
  {image ? (
    <img class="mh__img" src={image} alt={alt} />
  ) : (
    <div class="mh__ph" aria-hidden="true"><span>{placeholderText}</span></div>
  )}
  <div class="mh__scrim"></div>
  <div class="mh__text">
    {eyebrowHref ? (
      <a class="mh__eyebrow mh__eyebrow--link" href={eyebrowHref}>{eyebrow}</a>
    ) : (
      <p class="mh__eyebrow">{eyebrow}</p>
    )}
    <h1 class="mh__h1">{title}</h1>
    <p class="mh__lead"><slot /></p>
  </div>
</section>

<style>
  .mh{position:relative;height:440px;overflow:hidden;border-bottom:1px solid var(--rule)}
  .mh__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .mh__ph{position:absolute;inset:0;background:repeating-linear-gradient(45deg,var(--ph-1) 0 14px,var(--ph-2) 14px 28px);
    display:flex;align-items:center;justify-content:center;text-align:center;padding:20px}
  .mh__ph span{font-family:var(--disp);font-size:12px;letter-spacing:.1em;text-transform:uppercase;
    color:var(--mute-2);max-width:26ch;line-height:1.6}
  .mh__scrim{position:absolute;left:0;bottom:0;width:100%;height:75%;
    background:linear-gradient(to top,rgba(20,18,16,.84),transparent);pointer-events:none}
  .mh__text{position:absolute;left:44px;right:44px;bottom:36px;max-width:640px;color:var(--paper)}
  .mh__eyebrow{display:block;font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;
    opacity:.75;margin:0;text-decoration:none;color:inherit}
  .mh__eyebrow--link:hover{opacity:1;text-decoration:underline}
  .mh__h1{font-family:var(--head);font-size:clamp(34px,6.2vw,58px);line-height:1.02;font-weight:500;
    margin:12px 0 14px;text-transform:none;letter-spacing:0}
  .mh__lead{font-family:var(--body);font-size:16.5px;line-height:1.6;margin:0;max-width:56ch;text-wrap:pretty}
  .mh__lead :global(strong){font-weight:700}
  .mh__lead :global(em){font-style:italic}

  @media (max-width:880px){
    .mh{height:340px}
    .mh__ph{align-items:flex-start;padding-top:24px}
    .mh__text{left:22px;right:22px;bottom:24px}
  }
</style>
