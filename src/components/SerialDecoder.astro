---
// src/components/SerialDecoder.astro
// Interaktivní forenzní dekodér výrobního štítku a čísel rámu
import { SERIAL_RANGES } from '../data/perakTechnicalData';
---

<div class="decoder-container rounded-2xl border border-[var(--rule)] bg-[var(--card)] p-6 sm:p-8 shadow-sm">
  <div class="border-b border-[var(--rule)] pb-4 mb-6">
    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-red-900/10 text-[var(--red)] border border-red-900/20 text-xs font-mono mb-2">
      <span>Forenzní určovatel čísel rámu & štítku</span>
    </div>
    <h3 class="text-2xl sm:text-3xl font-serif text-[var(--ink)]">
      Ověření roku výroby a dobové autenticity
    </h3>
    <p class="text-sm text-[var(--mute)] mt-1 max-w-2xl font-sans">
      Zadejte výrobní číslo z krku řízení nebo z hliníkového štítku. Systém určí modelový rok, tovární provedení a upozorní na nepůvodní záměny dílů.
    </p>
  </div>

  <!-- Typ Switcher & Input -->
  <div class="space-y-4">
    <div class="flex items-center gap-2">
      <span class="text-xs font-mono text-[var(--mute)]">Zvolte typ:</span>
      <div class="flex rounded-lg border border-[var(--rule)] p-1 bg-[var(--paper-2)]">
        <button type="button" class="typ-btn px-3 py-1 text-xs font-mono font-bold rounded active-typ bg-[var(--card)] text-[var(--ink)] shadow-sm" data-typ="11">Typ 11 (250 ccm)</button>
        <button type="button" class="typ-btn px-3 py-1 text-xs font-mono text-[var(--mute)] hover:text-[var(--ink)] rounded" data-typ="12">Typ 12 (350 Ogar)</button>
        <button type="button" class="typ-btn px-3 py-1 text-xs font-mono text-[var(--mute)] hover:text-[var(--ink)] rounded" data-typ="18">Typ 18 (350 ccm)</button>
      </div>
    </div>

    <!-- Presets -->
    <div class="flex flex-wrap items-center gap-2 pt-1">
      <span class="text-xs font-mono text-[var(--mute-2)]">Rychlé vzorky ze sbírek:</span>
      <button type="button" class="preset-btn text-xs font-mono px-2 py-1 rounded bg-[var(--paper-2)] border border-[var(--rule)] text-[var(--ink)] hover:border-[var(--red)]" data-typ="11" data-num="11-00240">11-00240 (Raný 1946 Janeček)</button>
      <button type="button" class="preset-btn text-xs font-mono px-2 py-1 rounded bg-[var(--paper-2)] border border-[var(--rule)] text-[var(--ink)] hover:border-[var(--red)]" data-typ="11" data-num="11-61840">11-61840 (Zlomový 1950 160mm)</button>
      <button type="button" class="preset-btn text-xs font-mono px-2 py-1 rounded bg-[var(--paper-2)] border border-[var(--rule)] text-[var(--ink)] hover:border-[var(--red)]" data-typ="12" data-num="12-00412">12-00412 (Vzácný Ogar 1948)</button>
      <button type="button" class="preset-btn text-xs font-mono px-2 py-1 rounded bg-[var(--paper-2)] border border-[var(--rule)] text-[var(--ink)] hover:border-[var(--red)]" data-typ="18" data-num="18-09140">18-09140 (Jawa 350 r. 1951)</button>
    </div>

    <!-- Live Input Row -->
    <div class="flex flex-col sm:flex-row gap-3 pt-2">
      <input
        id="serial-input"
        type="text"
        value="11-61840"
        placeholder="Např. 11-61840 nebo 61840"
        class="flex-1 px-4 py-3 rounded-xl border border-[var(--rule)] bg-[var(--paper)] text-[var(--ink)] font-mono text-base focus:border-[var(--red)] outline-none"
      />
      <button
        id="decode-action"
        type="button"
        class="px-6 py-3 rounded-xl bg-[var(--red)] hover:bg-[var(--red-hover)] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow"
      >
        Analyzovat číslo
      </button>
    </div>
  </div>

  <!-- Result Grid: Aluminum Stamped Badge Simulation -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-6 mt-6 border-t border-[var(--rule)]">

    <!-- Tactile Aluminum Stamped Plate -->
    <div class="relative bg-gradient-to-b from-neutral-200 via-neutral-300 to-neutral-400 p-6 rounded-2xl border-4 border-neutral-500 shadow-xl text-neutral-900 font-mono select-none overflow-hidden">
      <!-- 4 Corner Screws -->
      <div class="absolute top-2.5 left-2.5 w-3 h-3 rounded-full bg-neutral-600 border border-neutral-400 flex items-center justify-center">
        <div class="w-2 h-0.5 bg-neutral-900 transform rotate-45"></div>
      </div>
      <div class="absolute top-2.5 right-2.5 w-3 h-3 rounded-full bg-neutral-600 border border-neutral-400 flex items-center justify-center">
        <div class="w-2 h-0.5 bg-neutral-900 transform rotate-12"></div>
      </div>
      <div class="absolute bottom-2.5 left-2.5 w-3 h-3 rounded-full bg-neutral-600 border border-neutral-400 flex items-center justify-center">
        <div class="w-2 h-0.5 bg-neutral-900 transform rotate-75"></div>
      </div>
      <div class="absolute bottom-2.5 right-2.5 w-3 h-3 rounded-full bg-neutral-600 border border-neutral-400 flex items-center justify-center">
        <div class="w-2 h-0.5 bg-neutral-900 transform -rotate-30"></div>
      </div>

      <div class="text-center border-b-2 border-neutral-700/60 pb-3 mb-3">
        <span class="text-[10px] tracking-widest font-black uppercase block text-neutral-700">ČESKOSLOVENSKÁ VÝROBA</span>
        <h4 id="plate-badge-title" class="text-sm sm:text-base font-black tracking-tight text-neutral-950 uppercase mt-0.5">
          ZBROJOVKA BRNO N.P. — ZÁVOD JANEČEK
        </h4>
        <span id="plate-model-title" class="text-[10px] tracking-wider text-neutral-700 block">
          MOTOCYKL JAWA — TYP 11
        </span>
      </div>

      <div class="grid grid-cols-2 gap-3 text-xs">
        <div class="bg-neutral-100/90 p-2.5 rounded border border-neutral-400 shadow-inner">
          <span class="text-[10px] uppercase text-neutral-600 block">Výrobní číslo:</span>
          <span id="plate-serial-out" class="text-sm sm:text-base font-black text-neutral-950 tracking-wider">
            11-61840
          </span>
        </div>
        <div class="bg-neutral-100/90 p-2.5 rounded border border-neutral-400 shadow-inner">
          <span class="text-[10px] uppercase text-neutral-600 block">Rok výroby:</span>
          <span id="plate-year-out" class="text-sm sm:text-base font-black text-red-700 tracking-wider">
            1950
          </span>
        </div>
      </div>

      <div class="mt-3 bg-neutral-100/80 p-2.5 rounded border border-neutral-400 text-xs space-y-1">
        <div class="flex justify-between">
          <span class="text-neutral-600">Objem motoru:</span>
          <span id="plate-disp-out" class="font-bold text-neutral-900">248,5 cm³</span>
        </div>
        <div class="flex justify-between">
          <span class="text-neutral-600">Brzdové půlbubny:</span>
          <span id="plate-brakes-out" class="font-bold text-neutral-900">160 mm (velké žebrované bubny)</span>
        </div>
        <div class="flex justify-between">
          <span class="text-neutral-600">Dekompresor v hlavě:</span>
          <span id="plate-decomp-out" class="font-bold text-neutral-900">NE</span>
        </div>
      </div>
    </div>

    <!-- Forensic Analysis Card & Warnings -->
    <div class="space-y-4 font-sans">
      <div class="bg-[var(--paper-2)] p-5 rounded-xl border border-[var(--rule)]">
        <span class="text-[10px] font-mono uppercase text-[var(--red)] font-semibold block">Historické zařazení série</span>
        <p id="analysis-info" class="text-sm text-[var(--ink)] mt-1 leading-relaxed">
          Číslo spadá do druhé poloviny roku 1950. Od čísla 11-61551 došlo k zásadní modernizaci: nahrazení 150mm bubnů novými 160mm a zvýšení výkonu motoru na 10 k.
        </p>
      </div>

      <div id="alert-box" class="bg-amber-500/10 border border-amber-600/30 p-5 rounded-xl space-y-2">
        <div class="flex items-center gap-2 text-xs font-mono font-bold text-amber-900 dark:text-amber-300 uppercase">
          <span>⚠️ Upozornění na časté dobové záměny</span>
        </div>
        <ul id="alert-list" class="space-y-1 text-xs text-amber-950 dark:text-amber-200 leading-relaxed list-disc list-inside">
          <li>Pozor na záměnu kol: Menší 150mm kola jsou u tohoto ročníku nepůvodní.</li>
        </ul>
      </div>
    </div>

  </div>
</div>

<script>
  // Client-side instant decode script
  const RANGES: Record<string, Array<{ year: number, from: number, to: number, label: string }>> = {
    '11': [
      { year: 1946, from: 1, to: 1500, label: 'Nultá / raná série, dekompresor, Zbrojovka Janeček štítek, 150mm brzdy' },
      { year: 1947, from: 1501, to: 15800, label: 'Standardní poválečná série, dekompresor, karburace Amal/Jikov' },
      { year: 1948, from: 15801, to: 34900, label: 'Přechodné období znárodnění, postupné mizení dekompresoru' },
      { year: 1949, from: 34901, to: 53800, label: 'Hlava bez dekompresoru, unifikovaná spínačka, 150mm bubny' },
      { year: 1950, from: 53801, to: 73000, label: 'Zlomový milník: od čísla 11-61551 náběh 160mm brzd a výkonu 10 k' },
      { year: 1951, from: 73001, to: 90000, label: 'Pozdní série s 160mm bubny a novým žebrováním válce' },
      { year: 1952, from: 90001, to: 110000, label: 'Roční řada (dvouciferný rok 52 na štítku), exportní série' },
      { year: 1953, from: 110001, to: 125000, label: 'Předposlední ročník před nástupem Kývačky 353' },
      { year: 1954, from: 125001, to: 135000, label: 'Dobíhající výroba, souběh s prvními Kývačkami' }
    ],
    '12': [
      { year: 1948, from: 1, to: 900, label: 'Ogar 350 raná série, holubičí šedý lak, původní logo Ogar na nádrži' },
      { year: 1949, from: 901, to: 4500, label: 'Ogar / Jawa 350, náběh červeného laku ČSN 8850' },
      { year: 1950, from: 4501, to: 10000, label: 'Závěrečná série typu 12 před unifikací na typ 18' }
    ],
    '18': [
      { year: 1950, from: 1, to: 8000, label: 'Nová unifikovaná Jawa 350, nový blok motoru, 160mm brzdy' },
      { year: 1951, from: 8001, to: 14200, label: 'Standardní typ 18, souběžná výroba s typem 11' },
      { year: 1952, from: 14201, to: 22000, label: 'Roční řada, vyšší komprese, exportní provedení' }
    ]
  };

  let currentTyp = '11';
  const inputEl = document.getElementById('serial-input') as HTMLInputElement;

  function runDecode() {
    const raw = inputEl.value;
    const cleaned = raw.replace(/[^0-9]/g, '');
    const num = parseInt(cleaned, 10);
    if (isNaN(num)) return;

    const table = RANGES[currentTyp] || [];
    let matchedYear = null;
    let matchedLabel = null;

    for (const r of table) {
      if (num >= r.from && num <= r.to) {
        matchedYear = r.year;
        matchedLabel = r.label;
        break;
      }
    }

    if (!matchedYear) {
      matchedYear = currentTyp === '11' ? (num > 135000 ? 1954 : '1952–1954') : '1950–1952';
      matchedLabel = 'Pozdní série nebo exportní provedení.';
    }

    let badgeTitle = 'ZBROJOVKA BRNO N.P. — ZÁVOD JANEČEK';
    let decomp = 'NE';
    let brakes = currentTyp === '11' && (typeof matchedYear === 'number' && matchedYear >= 1950) ? '160 mm (velké bubny)' : '150 mm (malé půlbubny)';
    let alerts = [];

    if (currentTyp === '11') {
      if (typeof matchedYear === 'number' && matchedYear <= 1947) {
        badgeTitle = 'ZBROJOVKA ING. F. JANEČEK — PRAHA-NUSLE II.';
        decomp = 'ANO (původní dekompresor)';
        alerts.push('Hlava válce: Musí mít dekompresor a páčku. Hlava bez dekompresoru je nepůvodní z 50. let.');
        alerts.push('Spínačka v nádrži musí nést monogram FJ (František Janeček).');
      } else if (typeof matchedYear === 'number' && matchedYear >= 1950) {
        brakes = '160 mm (velké žebrované bubny)';
        alerts.push('Pozor na záměnu kol: Stroje od čísla 11-61551 mají 160mm bubny. Menší 150mm jsou nepůvodní.');
      }
    } else if (currentTyp === '12') {
      badgeTitle = 'OGAR N.P. PRAHA-STRAŠNICE / ZÁVOD 9';
      alerts.push('Pozor na záměnu s motorem Typu 18! Typ 12 má specifické zaoblené kartery a dělenou klikovku.');
      alerts.push('Původní tuzemská barva byla holubičí šedá s logem Ogar na nádrži.');
    } else if (currentTyp === '18') {
      badgeTitle = 'JAWA N.P. PRAHA / ZBROJOVKA BRNO N.P.';
      brakes = '160 mm standardně';
      alerts.push('Kontrolujte dynamo PAL se dvěma přerušovači.');
    }

    // Update DOM
    document.getElementById('plate-badge-title')!.textContent = badgeTitle;
    document.getElementById('plate-model-title')!.textContent = 'MOTOCYKL JAWA — TYP ' + currentTyp;
    document.getElementById('plate-serial-out')!.textContent = currentTyp + '-' + num;
    document.getElementById('plate-year-out')!.textContent = String(matchedYear);
    document.getElementById('plate-disp-out')!.textContent = currentTyp === '11' ? '248,5 cm³' : '344 cm³';
    document.getElementById('plate-brakes-out')!.textContent = brakes;
    document.getElementById('plate-decomp-out')!.textContent = decomp;
    document.getElementById('analysis-info')!.textContent = matchedLabel || '';

    const alertListEl = document.getElementById('alert-list')!;
    alertListEl.innerHTML = '';
    alerts.forEach(a => {
      const li = document.createElement('li');
      li.textContent = a;
      alertListEl.appendChild(li);
    });
  }

  // Bind Buttons
  document.querySelectorAll('.typ-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.typ-btn').forEach(b => {
        b.classList.remove('bg-[var(--card)]', 'text-[var(--ink)]', 'shadow-sm');
        b.classList.add('text-[var(--mute)]');
      });
      const t = (e.currentTarget as HTMLElement).dataset.typ || '11';
      currentTyp = t;
      (e.currentTarget as HTMLElement).classList.add('bg-[var(--card)]', 'text-[var(--ink)]', 'shadow-sm');
      (e.currentTarget as HTMLElement).classList.remove('text-[var(--mute)]');
      runDecode();
    });
  });

  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      currentTyp = el.dataset.typ || '11';
      inputEl.value = el.dataset.num || '';
      // update typ btn active state
      document.querySelectorAll('.typ-btn').forEach(b => {
        if ((b as HTMLElement).dataset.typ === currentTyp) {
          b.classList.add('bg-[var(--card)]', 'text-[var(--ink)]', 'shadow-sm');
          b.classList.remove('text-[var(--mute)]');
        } else {
          b.classList.remove('bg-[var(--card)]', 'text-[var(--ink)]', 'shadow-sm');
          b.classList.add('text-[var(--mute)]');
        }
      });
      runDecode();
    });
  });

  document.getElementById('decode-action')?.addEventListener('click', runDecode);
  inputEl.addEventListener('input', runDecode);
</script>
