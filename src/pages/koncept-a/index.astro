---
// src/pages/koncept-a/index.astro
// Náhled Konceptu A (Archival Craft) sestavený ze špičkových modulů,
// bez klientských skeletonů. Samostatná stránka, aby nedošlo k přepsání
// stávající produkční homepage v src/pages/index.astro.
import Layout from '../../layouts/Layout.astro';
import ModelComparator from '../../components/ModelComparator.astro';
import SerialDecoder from '../../components/SerialDecoder.astro';
import CatalogGroups from '../../components/CatalogGroups.astro';
import WorkshopBanner from '../../components/WorkshopBanner.astro';
import { SAMPLE_REGISTRY } from '../../data/perakTechnicalData';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// Build-safe načtení registru s fallbackem na SAMPLE_REGISTRY.
// Stránka je staticky prerenderovaná (viz zbytek webu, např. index.astro),
// takže tu záměrně nepoužíváme sdílený `supabase-js` klient z lib/supabase.ts
// — ten volá createClient() při importu a bez proměnných prostředí by shodil
// celý build. Místo toho jde o obyčejný fetch hlídaný přítomností klíčů.
let registryItems: any[] = SAMPLE_REGISTRY;
if (SUPABASE_URL && SUPABASE_KEY) {
  try {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), 6000);
    const r = await fetch(
      `${SUPABASE_URL}/rest/v1/stroje_verejne?select=*&order=schvaleno_at.desc&limit=4`,
      { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` }, signal: ctrl.signal }
    );
    clearTimeout(t);
    const data = r.ok ? await r.json() : [];
    if (Array.isArray(data) && data.length > 0) {
      registryItems = data;
    }
  } catch (e) {
    // Graceful fallback to verified sample records
  }
}
---

<Layout
  title="Koncept A: Archival Craft — Jawa Pérák | jawaperak.cz"
  description="Nejúplnější nezávislá digitální monografie legendárního motocyklu Jawa 250 typ 11, 350 typ 12 Ogar a typ 18. Dobový katalog náhradních dílů 1949 a registr dochovaných strojů."
>
  <div class="wrap--wide space-y-16 sm:space-y-24">

    <!-- 1. HERO SECTION: Noblesní muzejní otevření -->
    <section class="rounded-3xl border border-[var(--rule)] bg-[var(--card)] p-8 sm:p-14 shadow-sm relative overflow-hidden">
      <div class="max-w-3xl space-y-4 relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--paper-2)] border border-[var(--rule)] text-xs font-mono text-[var(--red)] font-semibold">
          <span>Zbrojovka Ing. F. Janeček • Praha-Nusle II.</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-serif text-[var(--ink)] font-normal leading-tight">
          Jawa Pérák
        </h1>

        <p class="text-lg sm:text-xl text-[var(--mute)] font-sans leading-relaxed">
          Devět let výroby, dva objemy motoru a konstrukční zázrak zrozený v utajení za protektorátu.
          Nejúplnější technický archiv, originální katalog náhradních dílů z roku 1949 a nezávislý registr dochovaných kusů.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-4">
          <a href="#modely" class="px-6 py-3 rounded-xl bg-[var(--red)] hover:bg-[var(--red-hover)] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow">
            Prozkoumat typy 11, 12 a 18
          </a>
          <a href="#dekoder" class="px-6 py-3 rounded-xl border border-[var(--rule)] bg-[var(--paper)] hover:bg-[var(--paper-2)] text-[var(--ink)] text-xs font-bold uppercase tracking-wider transition-colors">
            Ověřit číslo stroje
          </a>
        </div>
      </div>

      <!-- Key Metrics Counter Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-6 rounded-2xl border border-[var(--rule)] bg-[var(--paper)] mt-10 text-center font-mono">
        <div>
          <span class="text-2xl sm:text-3xl font-bold text-[var(--red)] block">128 000+</span>
          <span class="text-[11px] uppercase text-[var(--mute)] mt-0.5 block">Vyrobeno Typu 11</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-bold text-[var(--ink)] block">11 • 12 • 18</span>
          <span class="text-[11px] uppercase text-[var(--mute)] mt-0.5 block">Výrobní typy</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-bold text-[var(--ink)] block">~240</span>
          <span class="text-[11px] uppercase text-[var(--mute)] mt-0.5 block">Analyzovaných štítků</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-bold text-[var(--gold)] block">100+ zemí</span>
          <span class="text-[11px] uppercase text-[var(--mute)] mt-0.5 block">Poválečný export</span>
        </div>
      </div>
    </section>

    <!-- 2. MODEL COMPARISON: 11 vs 12 vs 18 -->
    <div id="modely">
      <ModelComparator />
    </div>

    <!-- 3. FORENSIC SERIAL DECODER -->
    <div id="dekoder">
      <SerialDecoder />
    </div>

    <!-- 4. SPARE PARTS CATALOG 1949 -->
    <div id="katalog">
      <CatalogGroups />
    </div>

    <!-- 5. REGISTRY ARCHIVE -->
    <section id="registr" class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-[var(--rule)] pb-4">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-[var(--red)] font-semibold">Veřejný archiv dochovaných kusů</span>
          <h2 class="text-2xl sm:text-3xl font-serif text-[var(--ink)] mt-0.5">
            Registr Jawa Pérák
          </h2>
        </div>
        <a href="mailto:adas.kment@gmail.com?subject=Registrace%20Péráka" class="text-xs font-bold font-sans text-[var(--red)] hover:underline">
          + Přidat svůj stroj
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {registryItems.map((bike: any) => (
          <div class="p-5 rounded-2xl border border-[var(--rule)] bg-[var(--card)] space-y-2 hover:border-[var(--red)] transition-colors shadow-sm">
            <div class="flex items-center justify-between">
              <code class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-[var(--paper-2)] border border-[var(--rule)] text-[var(--ink)]">
                {bike.serialMasked || bike.cislo_maskovane || '11-×××××'}
              </code>
              <span class="text-xs font-mono text-[var(--mute)]">
                rok ~{bike.yearEstimated || bike.rok_odhad || '1950'}
              </span>
            </div>
            <h4 class="font-bold text-base text-[var(--ink)]">{bike.type || bike.typ}</h4>
            <p class="text-xs text-[var(--mute)]">
              {bike.condition || bike.stav} • {bike.region}
            </p>
            {bike.notes && (
              <p class="text-xs text-[var(--mute-2)] pt-1 border-t border-[var(--rule)]">
                {bike.notes}
              </p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- 6. WORKSHOP PUREBIKES DRAHANOVICE -->
    <div id="dilna">
      <WorkshopBanner />
    </div>

  </div>
</Layout>
