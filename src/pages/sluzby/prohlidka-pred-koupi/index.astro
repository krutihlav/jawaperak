---
import Layout from '../../../layouts/Layout.astro';
import data from '../../../data/prohlidka-pred-koupi.json';
---

<Layout title={data.seoTitle} description={data.seoDescription}>
  <div class="wrap">
    <div class="page">
      <article class="art">

        <p class="kicker"><a href={data.kickerHref}>{data.kicker}</a> — {data.kickerLabel}</p>
        <h1>{data.title}</h1>
        <p class="lead">{data.lead}</p>

        <div class="meta">
          {data.meta.map((m) => <span>{m.label} <b>{m.value}</b></span>)}
        </div>

        <div class="tldr">
          <h2>Co si odnést</h2>
          <ol>
            {data.tldr.map((t) => <li><Fragment set:html={`<span>${t}</span>`} /></li>)}
          </ol>
        </div>

        {data.sections.map((s, i) => (
          <section class="sec" id={s.id}>
            <div class="sec-h">
              <span class="sec-n">{String(i + 1).padStart(2, '0')}</span>
              <h2>{s.title}</h2>
              <p class="sub">{s.sub}</p>
            </div>
            <Fragment set:html={s.body} />
          </section>
        ))}

        <div class="cta">
          <div>
            <span class="lb">{data.cta.label}</span>
            <p>{data.cta.text}</p>
          </div>
          <a href={data.cta.href}>{data.cta.linkText}</a>
        </div>

      </article>
    </div>
  </div>
</Layout>
