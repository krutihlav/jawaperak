---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/navody.json';
---

<Layout title={data.seoTitle} description={data.seoDescription}>
  <div class="wrap">
    <div class="page">

      <p class="kicker">Návody</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.lead}</p>

      <div class="hubgrp">Jawa 250</div>
      <div class="hublist">
        {data.rada250.map((p) => (
          <a class="hubrow" href={p.href}>
            <span class="tt-wrap">
              <span class="tt">{p.tt}</span>
              <span class="ds">{p.ds}</span>
            </span>
            <span class="fl">{p.fl}</span>
          </a>
        ))}
      </div>

      <div class="hubgrp">Jawa 350</div>
      <div class="hublist">
        {data.rada350.map((p) => (
          <div class="hubrow soon">
            <span class="tt-wrap">
              <span class="tt">{p.tt}</span>
              <span class="ds">{p.ds}</span>
            </span>
            <span class="fl">{p.fl}</span>
          </div>
        ))}
      </div>

    </div>
  </div>

  <style>
    /* .tt a .ds musí být jeden grid item (sloupec 1fr) — zabalíme je
       do jednoho bloku, aby .fl zůstal ve svém vlastním sloupci vpravo */
    .tt-wrap{display:block}
  </style>
</Layout>
