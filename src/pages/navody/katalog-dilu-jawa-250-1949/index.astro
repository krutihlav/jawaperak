---
import Layout from '../../../layouts/Layout.astro';
import SpreadViewer from '../../../components/SpreadViewer.astro';
import { KATALOG_SKUPINY } from '../../../data/katalogSkupiny';

const BASE = '/navody/katalog-dilu-jawa-250-1949';

const spreads = [
  { file: 'obalka', label: 'Obálka' },
  { file: 'titulni-list', label: 'Titulní list' },
];
for (let left = 2; left <= 138; left += 2) {
  const right = left + 1;
  spreads.push({
    file: `s${String(left).padStart(3, '0')}-${String(right).padStart(3, '0')}`,
    label: `str. ${left}–${right}`,
  });
}

const items = spreads.map((s) => ({
  src: `${BASE}/${s.file}.jpg`,
  alt: `Sken katalogu Jawa 250 — ${s.label}`,
  label: s.label,
}));

// Šest hlavních konstrukčních skupin (sdílený seznam s homepage) — rychlý
// rozcestník; začátky skupin jsou orientační, viz data/katalogSkupiny.ts.
const groups = KATALOG_SKUPINY.map((g) => ({ label: g.name, index: g.index }));
---

<Layout
  title="Seznam náhradních dílů Jawa 250 (1949) — sken katalogu | jawaperak.cz"
  description="Kompletní dobový katalog náhradních dílů pro motocykl Jawa 250 (vydání 1949, Zbrojovka Brno). Vyčištěné a zvětšené skeny s pohodlným listováním a přibližováním — funguje i na mobilu."
  breadcrumbs={[
    { name: 'Domů', url: '/' },
    { name: 'Návody', url: '/navody/' },
    { name: 'Seznam náhradních dílů Jawa 250 (1949)', url: '/navody/katalog-dilu-jawa-250-1949/' },
  ]}
  article={{
    type: 'TechArticle',
    headline: 'Seznam náhradních dílů Jawa 250 (1949) — sken katalogu',
  }}
>
  <div class="wrap">
    <div class="page">

      <p class="kicker">Návody</p>
      <h1>Seznam náhradních dílů Jawa 250 (1949)</h1>
      <p class="lead">
        Kompletní dobový katalog — Zbrojovka Brno, závod Praha-Nusle II, platí
        od č. stroje 11–01. Skeny jsme vyčistili a zvětšili, aby šly číst
        i drobné položky v tabulkách.
      </p>

      <SpreadViewer items={items} hashPrefix="s" groups={groups} />

      <div class="box box--warn">
        <span class="lb">Rozsahy stran u rozcestníku jsou odhad</span>
        <p>
          Šest tlačítek nad prohlížečem vede na přibližné začátky
          konstrukčních skupin — motor, karburace a filtr, převodovka a
          spojka, rám a pérování, kola a brzdy, elektrická výzbroj PAL.
          Přesné stránkování bude doplněno po ověření proti rejstříku
          v tištěném katalogu. <span class="stamp od">odhad</span>
        </p>
      </div>

      <p class="hint">
        Na mobilu: přibliž štípnutím dvou prstů nebo dvojím poklepáním, po
        přiblížení posouváš tažením prstu, mezi stranami listuješ swipem.
        Na počítači: přibližuje kolečko myši s <kbd>Ctrl</kbd> (nebo gesto na
        trackpadu), tažením myší listuješ, šipky <kbd>←</kbd> <kbd>→</kbd> na
        klávesnici stránkují. Odkaz na konkrétní dvoustranu jde poslat přes
        adresu v adresním řádku. Zdroj: dobový tištěný katalog, vydání 1949.
      </p>

    </div>
  </div>

  <style>
    kbd{font-family:var(--disp);font-size:.85em;letter-spacing:.02em;
      border:1px solid var(--rule);border-bottom-width:2px;border-radius:3px;
      padding:0 5px;background:var(--card)}
  </style>
</Layout>
