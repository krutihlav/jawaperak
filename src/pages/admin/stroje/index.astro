---
// Přehled a správa už zveřejněných strojů (stav_moderace = 'schvaleno').
// Sesterská stránka k /admin (fronta ke schválení) — stejný auth vzor,
// navíc filtr nad seznamem a možnost zveřejnění zrušit (vrátí stroj zpět
// do fronty na /admin) nebo záznam trvale smazat.
import Layout from '../../../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Zveřejněné stroje — administrace — jawaperak.cz" noindex={true}>
  <main class="min-h-screen bg-[var(--paper,#FAF8F5)] text-[var(--ink,#141312)] font-serif py-8 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto space-y-6">

      <!-- Hlavička rozhraní & ČSN 8850 identita -->
      <header class="border-b border-[var(--rule,#E2DDD5)] pb-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 text-xs font-sans tracking-widest text-[var(--red,#8B2014)] uppercase font-semibold">
              <span>jawaperak.cz</span>
              <span>·</span>
              <span>Dílna PureBikes Drahanovice</span>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-[var(--ink,#141312)] mt-1">
              Administrační rozhraní registru a webu
            </h1>
          </div>

          <!-- Auth lišta -->
          <div id="auth-panel" class="flex items-center gap-3 font-sans text-xs">
            <div id="user-info" class="hidden text-right">
              <span id="user-email" class="font-medium text-[var(--ink,#141312)] block"></span>
              <span class="text-[var(--mute,#3E3A33)] text-[11px]">Ověřený správce</span>
            </div>
            <button
              id="btn-logout"
              class="hidden px-3 py-1.5 rounded-sm bg-[var(--paper-2,#F2EFE9)] hover:bg-[var(--rule,#E2DDD5)] text-[var(--ink,#141312)] border border-[var(--rule,#E2DDD5)] transition-colors"
            >
              Odhlásit
            </button>
          </div>
        </div>

        <!-- Přepínač záložek -->
        <nav class="flex items-center gap-4 mt-6 pt-2 border-t border-[var(--rule,#E2DDD5)]/60 font-sans text-sm font-medium">
          <a
            href="/admin"
            class="border-b-2 border-transparent text-[var(--mute,#3E3A33)] hover:text-[var(--ink,#141312)] pb-2 flex items-center gap-2"
          >
            <span>Moderace registru</span>
            <span id="badge-pending" class="hidden px-1.5 py-0.5 rounded-full text-[10px] bg-[var(--red,#8B2014)] text-white font-bold">0</span>
          </a>
          <a
            href="/admin/stroje"
            class="border-b-2 border-[var(--red,#8B2014)] text-[var(--red,#8B2014)] pb-2 font-semibold"
          >
            Zveřejněné stroje
          </a>
          <a
            href="/admin/obsah"
            class="border-b-2 border-transparent text-[var(--mute,#3E3A33)] hover:text-[var(--ink,#141312)] pb-2 flex items-center gap-1.5"
          >
            <span>Správa obsahu (Sveltia CMS)</span>
            <span class="text-[11px] text-[var(--mute,#3E3A33)] opacity-70">↗</span>
          </a>
        </nav>
      </header>

      <!-- Formulář pro přihlášení -->
      <section id="login-section" class="hidden bg-[var(--card,#FFFFFF)] border border-[var(--rule,#E2DDD5)] p-8 max-w-md mx-auto rounded-sm shadow-xs font-sans">
        <h2 class="text-lg font-bold font-serif text-[var(--ink,#141312)] mb-2">Přihlášení správce</h2>
        <p class="text-xs text-[var(--mute,#3E3A33)] mb-4">
          Zadejte přihlašovací údaje pro přístup k neveřejné moderaci registru motocyklů Jawa Pérák.
        </p>
        <form id="form-login" class="space-y-4 text-xs">
          <div>
            <label class="block text-[var(--mute,#3E3A33)] uppercase tracking-wider text-[10px] font-semibold mb-1" for="input-email">
              E-mail správce
            </label>
            <input
              id="input-email"
              type="email"
              autocomplete="username"
              required
              class="w-full bg-[var(--paper,#FAF8F5)] border border-[var(--rule,#E2DDD5)] px-3 py-2 rounded-sm text-[var(--ink,#141312)] focus:outline-none focus:border-[var(--red,#8B2014)]"
            />
          </div>
          <div>
            <label class="block text-[var(--mute,#3E3A33)] uppercase tracking-wider text-[10px] font-semibold mb-1" for="input-password">
              Heslo
            </label>
            <input
              id="input-password"
              type="password"
              autocomplete="current-password"
              required
              class="w-full bg-[var(--paper,#FAF8F5)] border border-[var(--rule,#E2DDD5)] px-3 py-2 rounded-sm text-[var(--ink,#141312)] focus:outline-none focus:border-[var(--red,#8B2014)]"
            />
          </div>
          <div id="login-error" class="hidden text-[var(--red,#8B2014)] font-medium text-[11px]"></div>
          <button
            type="submit"
            class="w-full bg-[var(--red,#8B2014)] hover:bg-[#6e1910] text-[var(--paper,#FAF8F5)] font-semibold py-2 rounded-sm border border-[var(--gold,#C89D42)] transition-colors"
          >
            Přihlásit se
          </button>
        </form>
      </section>

      <!-- Seznam zveřejněných strojů -->
      <section id="stroje-section" class="hidden space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 font-sans text-xs">
          <div class="text-[var(--mute,#3E3A33)]">
            Stroje aktuálně viditelné ve veřejném registru na <a href="/registr" target="_blank" class="underline hover:text-[var(--ink,#141312)]">/registr</a>.
          </div>
          <button
            id="btn-refresh"
            class="px-3 py-1.5 bg-[var(--paper-2,#F2EFE9)] hover:bg-[var(--rule,#E2DDD5)] border border-[var(--rule,#E2DDD5)] rounded-sm text-[var(--ink,#141312)] transition-colors self-start sm:self-auto"
          >
            Obnovit seznam
          </button>
        </div>

        <!-- Filtr -->
        <div class="bg-[var(--card,#FFFFFF)] border border-[var(--rule,#E2DDD5)] p-4 rounded-sm shadow-xs font-sans">
          <div class="flex flex-wrap items-end gap-3">
            <div class="flex-1 min-w-[180px]">
              <label class="block text-[var(--mute,#3E3A33)] uppercase tracking-wider text-[10px] font-semibold mb-1" for="f-hledat">
                Hledat
              </label>
              <input
                id="f-hledat"
                type="text"
                placeholder="Rám, motor, e-mail, kraj…"
                class="w-full bg-[var(--paper,#FAF8F5)] border border-[var(--rule,#E2DDD5)] px-2.5 py-2 rounded-sm text-xs text-[var(--ink,#141312)] focus:outline-none focus:border-[var(--red,#8B2014)]"
              />
            </div>
            <div>
              <label class="block text-[var(--mute,#3E3A33)] uppercase tracking-wider text-[10px] font-semibold mb-1" for="f-typ">Typ</label>
              <select id="f-typ" class="bg-[var(--paper,#FAF8F5)] border border-[var(--rule,#E2DDD5)] px-2.5 py-2 rounded-sm text-xs text-[var(--ink,#141312)] focus:outline-none focus:border-[var(--red,#8B2014)]">
                <option value="">Všechny</option>
              </select>
            </div>
            <div>
              <label class="block text-[var(--mute,#3E3A33)] uppercase tracking-wider text-[10px] font-semibold mb-1" for="f-stav">Stav</label>
              <select id="f-stav" class="bg-[var(--paper,#FAF8F5)] border border-[var(--rule,#E2DDD5)] px-2.5 py-2 rounded-sm text-xs text-[var(--ink,#141312)] focus:outline-none focus:border-[var(--red,#8B2014)]">
                <option value="">Všechny</option>
              </select>
            </div>
            <div>
              <label class="block text-[var(--mute,#3E3A33)] uppercase tracking-wider text-[10px] font-semibold mb-1" for="f-faze">Výrobní fáze</label>
              <select id="f-faze" class="bg-[var(--paper,#FAF8F5)] border border-[var(--rule,#E2DDD5)] px-2.5 py-2 rounded-sm text-xs text-[var(--ink,#141312)] focus:outline-none focus:border-[var(--red,#8B2014)]">
                <option value="">Všechny</option>
              </select>
            </div>
            <label class="flex items-center gap-1.5 text-xs pb-2 cursor-pointer select-none">
              <input id="f-prodej" type="checkbox" class="accent-[var(--red,#8B2014)]" />
              Jen na prodej
            </label>
            <button
              id="btn-filtr-reset"
              type="button"
              class="px-3 py-2 bg-[var(--paper-2,#F2EFE9)] hover:bg-[var(--rule,#E2DDD5)] border border-[var(--rule,#E2DDD5)] rounded-sm text-xs text-[var(--mute,#3E3A33)] transition-colors"
            >
              Zrušit filtr
            </button>
          </div>
        </div>

        <div id="pocet-vysledku" class="text-[11px] font-sans text-[var(--mute,#3E3A33)]"></div>

        <div id="stroje-container" class="space-y-4">
          <div class="p-8 text-center bg-[var(--card,#FFFFFF)] border border-[var(--rule,#E2DDD5)] text-xs text-[var(--mute,#3E3A33)]">
            Načítám záznamy ze Supabase...
          </div>
        </div>
      </section>

    </div>
  </main>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const supabase = createClient(supabaseUrl, supabaseAnonKey);

    const loginSection = document.getElementById('login-section');
    const strojeSection = document.getElementById('stroje-section');
    const userInfo = document.getElementById('user-info');
    const userEmail = document.getElementById('user-email');
    const btnLogout = document.getElementById('btn-logout');
    const formLogin = document.getElementById('form-login');
    const loginError = document.getElementById('login-error');
    const strojeContainer = document.getElementById('stroje-container');
    const pocetVysledku = document.getElementById('pocet-vysledku');
    const btnRefresh = document.getElementById('btn-refresh');
    const btnFiltrReset = document.getElementById('btn-filtr-reset');

    const fHledat = document.getElementById('f-hledat') as HTMLInputElement;
    const fTyp = document.getElementById('f-typ') as HTMLSelectElement;
    const fStav = document.getElementById('f-stav') as HTMLSelectElement;
    const fFaze = document.getElementById('f-faze') as HTMLSelectElement;
    const fProdej = document.getElementById('f-prodej') as HTMLInputElement;

    let TYP: Record<string, string> = {};
    let STAV: Record<string, string> = {};
    let FAZE: Record<string, string> = {};
    let hledatTimer: ReturnType<typeof setTimeout> | undefined;

    function escapujHtml(s: string | null | undefined) {
      return (s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[c] as string));
    }

    function formatDatum(iso: string | null | undefined) {
      if (!iso) return '—';
      return new Date(iso).toLocaleDateString('cs-CZ', { year: 'numeric', month: 'long', day: 'numeric' });
    }

    function naplnSelect(selectEl: HTMLSelectElement, radky: { hodnota: string; popis_cs: string }[]) {
      for (const r of radky) {
        const opt = document.createElement('option');
        opt.value = r.hodnota;
        opt.textContent = r.popis_cs;
        selectEl.appendChild(opt);
      }
    }

    async function nactiCiselniky() {
      try {
        const [rTyp, rStav, rFaze] = await Promise.all([
          supabase.from('ciselnik_typ').select('*').order('poradi'),
          supabase.from('ciselnik_stav').select('*').order('poradi'),
          supabase.from('ciselnik_faze').select('*').order('poradi'),
        ]);
        const typy = rTyp.data || [];
        const stavy = rStav.data || [];
        const faze = rFaze.data || [];

        TYP = Object.fromEntries(typy.map((r: any) => [r.hodnota, r.popis_cs]));
        STAV = Object.fromEntries(stavy.map((r: any) => [r.hodnota, r.popis_cs]));
        FAZE = Object.fromEntries(faze.map((r: any) => [r.hodnota, r.popis_cs]));

        naplnSelect(fTyp, typy);
        naplnSelect(fStav, stavy);
        naplnSelect(fFaze, faze);
      } catch (e) {
        console.error('Číselníky se nepodařilo načíst', e);
      }
    }

    async function initAuth() {
      const { data: { session } } = await supabase.auth.getSession();
      if (session?.user) {
        showAuthenticated(session.user.email);
        nactiCiselniky();
        loadZverejneneStroje();
      } else {
        showLogin();
      }
    }

    function showAuthenticated(email: string | undefined) {
      loginSection?.classList.add('hidden');
      strojeSection?.classList.remove('hidden');
      userInfo?.classList.remove('hidden');
      btnLogout?.classList.remove('hidden');
      if (userEmail) userEmail.textContent = email || 'Správce';
    }

    function showLogin() {
      loginSection?.classList.remove('hidden');
      strojeSection?.classList.add('hidden');
      userInfo?.classList.add('hidden');
      btnLogout?.classList.add('hidden');
    }

    formLogin?.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginError?.classList.add('hidden');
      const email = (document.getElementById('input-email') as HTMLInputElement).value;
      const password = (document.getElementById('input-password') as HTMLInputElement).value;

      const { data, error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) {
        if (loginError) {
          loginError.textContent = 'Nesprávný e-mail nebo heslo.';
          loginError.classList.remove('hidden');
        }
      } else if (data.session) {
        showAuthenticated(data.session.user.email);
        nactiCiselniky();
        loadZverejneneStroje();
      }
    });

    btnLogout?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      showLogin();
    });

    btnRefresh?.addEventListener('click', () => loadZverejneneStroje());

    btnFiltrReset?.addEventListener('click', () => {
      fHledat.value = '';
      fTyp.value = '';
      fStav.value = '';
      fFaze.value = '';
      fProdej.checked = false;
      loadZverejneneStroje();
    });

    [fTyp, fStav, fFaze, fProdej].forEach((el) => el.addEventListener('change', () => loadZverejneneStroje()));
    fHledat.addEventListener('input', () => {
      clearTimeout(hledatTimer);
      hledatTimer = setTimeout(() => loadZverejneneStroje(), 350);
    });

    async function loadZverejneneStroje() {
      if (!strojeContainer) return;
      strojeContainer.innerHTML = '<div class="p-8 text-center bg-[var(--card,#FFFFFF)] border border-[var(--rule,#E2DDD5)] text-xs text-[var(--mute,#3E3A33)]">Načítám záznamy...</div>';
      if (pocetVysledku) pocetVysledku.textContent = '';

      let dotaz = supabase
        .from('stroje')
        .select('*')
        .eq('stav_moderace', 'schvaleno')
        .order('schvaleno_at', { ascending: false });

      if (fTyp.value) dotaz = dotaz.eq('typ', fTyp.value);
      if (fStav.value) dotaz = dotaz.eq('stav', fStav.value);
      if (fFaze.value) dotaz = dotaz.eq('vyrobni_faze', fFaze.value);
      if (fProdej.checked) dotaz = dotaz.eq('na_prodej', true);

      const hledat = fHledat.value.trim().replace(/[,()%]/g, '');
      if (hledat) {
        const vzor = `%${hledat}%`;
        dotaz = dotaz.or(
          [
            `cislo_ramu.ilike.${vzor}`,
            `cislo_motoru.ilike.${vzor}`,
            `kontakt_email.ilike.${vzor}`,
            `region.ilike.${vzor}`,
            `zeme.ilike.${vzor}`,
            `spz_historicka.ilike.${vzor}`,
          ].join(',')
        );
      }

      const { data: stroje, error } = await dotaz;

      if (error) {
        strojeContainer.innerHTML = `<div class="p-4 bg-[var(--paper-2,#F2EFE9)] text-[var(--red,#8B2014)] text-xs border border-[var(--red,#8B2014)]/30">Chyba při načítání: ${escapujHtml(error.message)}</div>`;
        return;
      }

      if (!stroje || stroje.length === 0) {
        strojeContainer.innerHTML = `
          <div class="bg-[var(--card,#FFFFFF)] border border-[var(--rule,#E2DDD5)] p-12 text-center text-xs text-[var(--mute,#3E3A33)]">
            <p class="font-serif text-base text-[var(--ink,#141312)] font-bold mb-1">Žádný stroj neodpovídá filtru</p>
            <p>Zkuste filtr zúžit nebo zrušit.</p>
          </div>
        `;
        return;
      }

      if (pocetVysledku) {
        pocetVysledku.textContent = `Zobrazeno ${stroje.length} ${stroje.length === 1 ? 'stroj' : stroje.length < 5 ? 'stroje' : 'strojů'}.`;
      }

      const itemsHtml = await Promise.all(stroje.map(async (stroj) => {
        let photoHtml = '';
        const { data: fotky } = await supabase
          .from('stroje_fotky')
          .select('*')
          .eq('stroj_id', stroj.id)
          .order('poradi');

        if (fotky && fotky.length > 0) {
          const podepsane = await Promise.all(fotky.map(async (f: { url: string }) => {
            const { data } = await supabase.storage
              .from('stroje-fotky')
              .createSignedUrl(f.url, 3600);
            return data?.signedUrl || null;
          }));
          const validUrls = podepsane.filter(Boolean) as string[];
          if (validUrls.length > 0) {
            photoHtml = `
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-3 pt-3 border-t border-[var(--rule,#E2DDD5)]">
                ${validUrls.map((url) => `
                  <a href="${url}" target="_blank" rel="noopener noreferrer">
                    <img src="${url}" alt="Foto stroje" class="w-full h-24 object-cover rounded-xs border border-[var(--rule,#E2DDD5)] hover:opacity-90" />
                  </a>
                `).join('')}
              </div>
            `;
          }
        }

        const stavTag = stroj.stav ? (STAV[stroj.stav] || escapujHtml(stroj.stav)) : null;
        const fazeTag = stroj.vyrobni_faze ? (FAZE[stroj.vyrobni_faze] || escapujHtml(stroj.vyrobni_faze)) : null;

        return `
          <article class="bg-[var(--card,#FFFFFF)] border border-[var(--rule,#E2DDD5)] p-5 rounded-sm shadow-xs" data-id="${stroj.id}">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
              <div>
                <span class="text-xs font-sans font-bold text-[var(--red,#8B2014)]">${escapujHtml(TYP[stroj.typ] || ('Typ ' + stroj.typ))}</span>
                <h3 class="text-lg font-bold font-serif text-[var(--ink,#141312)]">
                  Rok ${stroj.rok_vyroby || '—'} · Rám: ${escapujHtml(stroj.cislo_ramu) || '—'} · Motor: ${escapujHtml(stroj.cislo_motoru) || '—'}
                </h3>
                <div class="text-xs font-sans text-[var(--mute,#3E3A33)] mt-0.5 flex flex-wrap items-center gap-x-1.5 gap-y-1">
                  <span>Kontakt: <strong>${escapujHtml(stroj.kontakt_email) || '—'}</strong>${stroj.kontakt_telefon ? ` · ${escapujHtml(stroj.kontakt_telefon)}` : ''}</span>
                  <span>· ${escapujHtml([stroj.region, stroj.zeme].filter(Boolean).join(', ')) || '—'}</span>
                  <span>· zveřejněno ${formatDatum(stroj.schvaleno_at)}</span>
                  ${stavTag ? `<span class="px-1.5 py-0.5 rounded-full border border-[var(--rule,#E2DDD5)] text-[10px] uppercase tracking-wide">${stavTag}</span>` : ''}
                  ${fazeTag ? `<span class="px-1.5 py-0.5 rounded-full border border-[var(--rule,#E2DDD5)] text-[10px] uppercase tracking-wide">${fazeTag}</span>` : ''}
                  ${stroj.na_prodej ? `<span class="px-1.5 py-0.5 rounded-full bg-[var(--red,#8B2014)]/10 border border-[var(--red,#8B2014)]/30 text-[var(--red,#8B2014)] text-[10px] uppercase tracking-wide font-semibold">Na prodej</span>` : ''}
                </div>
              </div>
              <div class="flex flex-wrap items-center gap-2 font-sans text-xs self-start">
                <a
                  href="/registr/stroj/${escapujHtml(stroj.slug) || ''}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-3 py-1.5 bg-[var(--paper-2,#F2EFE9)] hover:bg-[var(--rule,#E2DDD5)] border border-[var(--rule,#E2DDD5)] rounded-sm text-[var(--ink,#141312)] transition-colors"
                >
                  Zobrazit veřejně ↗
                </a>
                <button
                  class="btn-unpublish px-3 py-1.5 bg-[var(--paper-2,#F2EFE9)] hover:bg-[var(--rule,#E2DDD5)] text-[var(--red,#8B2014)] border border-[var(--rule,#E2DDD5)] rounded-sm transition-colors"
                  data-id="${stroj.id}"
                >
                  Zrušit zveřejnění
                </button>
                <button
                  class="btn-delete px-3 py-1.5 bg-[var(--paper-2,#F2EFE9)] hover:bg-[var(--red,#8B2014)] hover:text-white text-[var(--red,#8B2014)] border border-[var(--rule,#E2DDD5)] rounded-sm transition-colors"
                  data-id="${stroj.id}"
                >
                  Smazat trvale
                </button>
              </div>
            </div>

            ${stroj.pribeh ? `
              <p class="text-xs text-[var(--mute,#3E3A33)] font-serif mt-2 leading-relaxed bg-[var(--paper,#FAF8F5)] p-2.5 border border-[var(--rule,#E2DDD5)] rounded-xs whitespace-pre-wrap">
                ${escapujHtml(stroj.pribeh)}
              </p>
            ` : ''}

            ${photoHtml}
          </article>
        `;
      }));

      strojeContainer.innerHTML = itemsHtml.join('');

      document.querySelectorAll('.btn-unpublish').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          if (confirm('Opravdu chcete zrušit zveřejnění tohoto stroje? Vrátí se zpět do fronty ke schválení a zmizí z veřejného registru.')) {
            const { error } = await supabase
              .from('stroje')
              .update({ stav_moderace: 'ceka', schvaleno_at: null })
              .eq('id', id);
            if (!error) loadZverejneneStroje();
            else alert('Chyba: ' + error.message);
          }
        });
      });

      document.querySelectorAll('.btn-delete').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          if (confirm('Opravdu chcete tento záznam trvale smazat? Tuto akci nelze vzít zpět.')) {
            const { error } = await supabase
              .from('stroje')
              .delete()
              .eq('id', id);
            if (!error) loadZverejneneStroje();
            else alert('Chyba: ' + error.message);
          }
        });
      });
    }

    initAuth();
  </script>
</Layout>
