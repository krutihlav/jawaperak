---
// Centrální administrace — sjednocené rozhraní pro moderaci registru
// (dřív samostatně na /moderace, teď tady) a odkaz na správu obsahu
// (Sveltia CMS, přesunuto na /admin/obsah, viz ten soubor).
//
// Vizuální styl: tiskařský knižní design ČSN 8850 (slonovina #FAF8F5,
// pérácká červeň #8B2014, zlatá linka #C89D42). Datově je stránka
// navázaná na skutečné tabulky `stroje` / `stroje_fotky` a číselníky
// `ciselnik_typ` / `ciselnik_stav` — RLS (private.je_admin()) povoluje
// přihlášenému správci číst všechny stroje/fotky a aktualizovat
// stav_moderace, ale ne řádky mazat, proto zamítnutí mění stav místo
// DELETE (viz rejectStroj níže).
import Layout from '../../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Centrální administrace & moderace — jawaperak.cz" noindex={true}>
  <div id="admin-root" class="min-h-screen bg-paper text-ink font-serif flex flex-col selection:bg-gold/30 selection:text-perak">

    <!-- Heraldická lišta -->
    <header class="border-b border-rule bg-paper px-6 py-4 sticky top-0 z-30 shadow-sm">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-sm bg-perak text-paper flex items-center justify-center font-bold text-lg tracking-wider border border-gold flex-shrink-0">
            JP
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs font-sans tracking-widest text-perak uppercase font-semibold">
                jawaperak.cz · ČSN 8850
              </span>
              <span class="text-[10px] font-sans px-1.5 py-0.5 rounded-sm bg-paper-2 border border-rule text-mute">
                Astro 4.15 Hybrid
              </span>
            </div>
            <h1 class="text-xl font-bold tracking-tight text-ink">
              Centrální administrace &amp; moderace registru
            </h1>
          </div>
        </div>

        <!-- Stavový panel přihlášeného správce -->
        <div id="auth-panel" class="flex items-center gap-3 text-xs font-sans">
          <div id="user-info" class="text-right hidden sm:block">
            <div id="user-email" class="font-medium text-ink">Ověřuji relaci…</div>
            <div class="text-mute text-[11px]">Správce registru &amp; dílny (PureBikes)</div>
          </div>
          <div class="h-8 w-px bg-rule hidden sm:block"></div>
          <button
            id="btn-logout"
            class="hidden items-center gap-1.5 jp-btn-secondary"
          >
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/></svg>
            <span>Odhlásit</span>
          </button>
        </div>
      </div>

      <!-- Záložková navigace -->
      <div class="max-w-6xl mx-auto mt-4 pt-2 border-t border-rule/70 flex items-center gap-4 font-sans text-xs">
        <a
          href="/admin"
          class="no-underline inline-flex items-center gap-2 px-3 pt-2 pb-3 border-b-2 border-perak text-perak bg-paper-2/70 font-bold transition-colors"
        >
          <span>Moderace registru</span>
          <span id="badge-pending" class="hidden px-1.5 py-0.5 rounded-full text-[10px] bg-perak text-paper font-bold">
            0
          </span>
        </a>

        <a
          href="/admin/obsah"
          class="no-underline inline-flex items-center gap-1.5 px-3 pt-2 pb-3 border-b-2 border-transparent text-mute hover:text-ink hover:bg-paper-2/40 font-medium transition-colors"
        >
          <span>Správa obsahu (Sveltia CMS)</span>
          <span class="text-[10px] bg-rule text-mute px-1.5 py-0.5 rounded-xs">/admin/obsah</span>
        </a>
      </div>
    </header>

    <!-- Hlavní obsah -->
    <main class="flex-1 max-w-6xl mx-auto w-full p-6">

      <!-- Přihlašovací formulář (nepřihlášeným) -->
      <section id="login-section" class="hidden bg-card border border-rule p-8 max-w-md mx-auto rounded-sm shadow-sm font-sans mt-12">
        <div class="flex items-center gap-2 text-xs uppercase tracking-widest text-perak font-bold mb-1">
          <span>Ověření správce dílny</span>
        </div>
        <h2 class="text-xl font-bold font-serif text-ink mb-2">Přihlášení do administrace</h2>
        <p class="text-xs text-mute mb-6 leading-relaxed">
          Zadejte přihlašovací údaje ke svému Supabase účtu pro přístup ke schvalování motocyklů v neveřejném registru.
        </p>

        <form id="form-login" class="space-y-4 text-xs">
          <div>
            <label class="block text-mute uppercase tracking-wider text-[10px] font-semibold mb-1" for="input-email">
              E-mail správce
            </label>
            <input
              id="input-email"
              type="email"
              autocomplete="username"
              required
              class="w-full bg-paper border border-rule px-3 py-2 rounded-sm text-ink focus:outline-none focus:border-perak"
            />
          </div>
          <div>
            <label class="block text-mute uppercase tracking-wider text-[10px] font-semibold mb-1" for="input-password">
              Heslo
            </label>
            <input
              id="input-password"
              type="password"
              autocomplete="current-password"
              required
              class="w-full bg-paper border border-rule px-3 py-2 rounded-sm text-ink focus:outline-none focus:border-perak"
            />
          </div>

          <div id="login-error" class="hidden p-2.5 bg-paper-2 text-perak border border-perak/20 rounded-sm text-[11px] font-medium"></div>

          <button
            type="submit"
            class="w-full justify-center jp-btn-primary"
          >
            Vstoupit do administrace
          </button>
        </form>
      </section>

      <!-- Přehled a moderace (přihlášeným) -->
      <section id="dashboard-section" class="hidden space-y-6">

        <!-- Panel s přehledem a filtry -->
        <div class="bg-card border border-rule p-5 rounded-sm shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <div class="text-xs uppercase tracking-widest text-perak font-sans font-bold">
              Přehled registru strojů Jawa Pérák
            </div>
            <h2 id="summary-title" class="text-lg font-bold text-ink mt-0.5">
              Načítám přehled…
            </h2>
            <p class="text-xs text-mute font-sans mt-1">
              Fotografie jsou uloženy v privátním Supabase Storage bucketu <code class="bg-paper-2 px-1 py-0.5 rounded-sm text-ink font-mono">stroje-fotky</code>. Náhledy se načítají výhradně přes krátkodobé podepsané URL (signed URLs), nikdy přímo z veřejné cesty.
            </p>
          </div>

          <!-- Filtry -->
          <div class="flex flex-wrap items-center gap-2 font-sans text-xs">
            <div class="relative inline-block">
              <select
                id="filter-status"
                class="jp-select"
              >
                <option value="ceka">Pouze ke schválení</option>
                <option value="schvaleno">Schválené v registru</option>
                <option value="zamitnuto">Zamítnuté</option>
                <option value="all">Všechny záznamy</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2.5 text-ink">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
              </div>
            </div>
            <div class="relative inline-block">
              <select
                id="filter-type"
                class="jp-select"
              >
                <option value="all">Všechny typy</option>
                <option value="11">Jawa 250 typ 11</option>
                <option value="12">Jawa 350 typ 12 Ogar</option>
                <option value="18">Jawa 350 typ 18</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2.5 text-ink">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
              </div>
            </div>
            <button
              id="btn-refresh"
              class="jp-btn-secondary"
              title="Obnovit data"
            >
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
              <span>Obnovit</span>
            </button>
          </div>
        </div>

        <!-- Seznam strojů -->
        <div id="stroje-list" class="space-y-4">
          <div class="p-12 text-center bg-card border border-rule text-xs text-mute rounded-sm">
            Načítám záznamy z databáze…
          </div>
        </div>
      </section>
    </main>

    <!-- Detailní inspekční modální okno -->
    <div id="detail-modal" class="hidden fixed inset-0 z-50 bg-ink/60 flex items-center justify-center p-4">
      <div class="bg-paper border-2 border-perak max-w-2xl w-full max-h-[90vh] overflow-y-auto rounded-sm p-6 shadow-2xl relative font-serif">
        <div class="flex items-start justify-between border-b border-rule pb-3 mb-4">
          <div>
            <span class="text-xs font-sans tracking-widest text-perak uppercase font-bold">
              Technický posudek stroje · ČSN 8850
            </span>
            <h3 id="modal-title" class="text-xl font-bold text-ink">Detail stroje</h3>
          </div>
          <button id="modal-close-btn" class="jp-btn-secondary flex-shrink-0">
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            <span>Zavřít</span>
          </button>
        </div>

        <!-- Fotogalerie -->
        <div class="mb-4">
          <div class="text-xs font-sans text-mute mb-2 flex items-center gap-1 font-medium">
            Privátní fotodokumentace (bucket <code class="font-mono text-perak">stroje-fotky</code>):
          </div>
          <div id="modal-photos" class="grid grid-cols-2 gap-2"></div>
        </div>

        <!-- Technická karta -->
        <div class="bg-card border border-rule p-4 rounded-sm text-xs font-sans space-y-3 mb-4">
          <div class="grid grid-cols-2 gap-3 pb-3 border-b border-rule">
            <div>
              <span class="text-mute block text-[10px] uppercase tracking-wider">Výrobní číslo rámu</span>
              <span id="modal-ram" class="font-mono font-bold text-sm text-ink">—</span>
            </div>
            <div>
              <span class="text-mute block text-[10px] uppercase tracking-wider">Výrobní číslo motoru</span>
              <span id="modal-motor" class="font-mono font-bold text-sm text-ink">—</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 pb-3 border-b border-rule">
            <div>
              <span class="text-mute block text-[10px] uppercase tracking-wider">Kontakt (majitel)</span>
              <span id="modal-kontakt" class="text-ink font-medium">—</span>
            </div>
            <div>
              <span class="text-mute block text-[10px] uppercase tracking-wider">Lokalita</span>
              <span id="modal-lokalita" class="text-ink">—</span>
            </div>
          </div>

          <div>
            <span class="text-mute block text-[10px] uppercase tracking-wider mb-1">Popis historie a stavu</span>
            <p id="modal-popis" class="font-serif text-ink leading-relaxed text-sm bg-paper p-3 border border-rule rounded-sm whitespace-pre-wrap">
              Bez popisu.
            </p>
          </div>

          <div class="flex items-start gap-2 p-2 bg-paper-2 border border-rule text-[11px] text-mute rounded-sm">
            <svg class="w-4 h-4 text-perak flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
            <span>
              Záznam pochází z veřejného formuláře <code class="font-mono">/registr/pridat-stroj</code>, který před uložením
              vynucuje prázdné honeypot pole <code class="font-mono">overeni_webu</code> a časový zámek přes 3&nbsp;s
              od načtení stránky. Fotografie procházejí serverovým odstraněním EXIF/GPS metadat (sharp) ještě před uložením do bucketu.
            </span>
          </div>
        </div>

        <!-- Akce -->
        <div id="modal-actions" class="flex items-center justify-end gap-2 pt-3 border-t border-rule">
          <button id="modal-cancel-btn" class="jp-btn-secondary">
            <span>Zavřít</span>
          </button>
          <button id="modal-reject-btn" class="jp-btn-danger">
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Zamítnout</span>
          </button>
          <button id="modal-approve-btn" class="jp-btn-primary">
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Schválit do registru</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Patička -->
    <footer class="border-t border-rule bg-paper-2 py-4 px-6 text-center text-xs font-sans text-mute mt-auto">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
        <span>
          <strong class="text-ink">jawaperak.cz</strong> — Dílna PureBikes Drahanovice (Adam Kment).
        </span>
        <span class="text-[11px]">
          Tiskařský styl ČSN 8850 · Slonová kost #FAF8F5 · Pérácká červeň #8B2014 · Zlatá linka #C89D42
        </span>
      </div>
    </footer>
  </div>

  <!-- Klientská logika: Supabase Auth, číselníky, filtry, podepsaná URL a inspekční okno -->
  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const supabase = createClient(supabaseUrl, supabaseAnonKey);

    type CiselnikRadek = {
      hodnota: string;
      popis_cs: string;
      popis_en: string | null;
      poradi: number;
      objem_ccm?: number | null;
    };

    type Fotka = { id: string; stroj_id: string; url: string; poradi: number };

    type Stroj = {
      id: string;
      typ: string;
      rok_vyroby: number | null;
      cislo_ramu: string | null;
      cislo_motoru: string | null;
      stav: string;
      region: string | null;
      zeme: string | null;
      pribeh: string | null;
      kontakt_email: string | null;
      kontakt_telefon: string | null;
      stav_moderace: 'ceka' | 'schvaleno' | 'zamitnuto';
      vytvoreno_at: string;
      schvaleno_at: string | null;
    };

    let allStroje: Stroj[] = [];
    let fotkyByStroj: Record<string, Fotka[]> = {};
    let ciselnikTyp: CiselnikRadek[] = [];
    let ciselnikStav: CiselnikRadek[] = [];
    let currentModalStrojId: string | null = null;

    const loginSection = document.getElementById('login-section');
    const dashboardSection = document.getElementById('dashboard-section');
    const userEmail = document.getElementById('user-email');
    const btnLogout = document.getElementById('btn-logout');
    const formLogin = document.getElementById('form-login');
    const loginError = document.getElementById('login-error');
    const strojeList = document.getElementById('stroje-list');
    const badgePending = document.getElementById('badge-pending');
    const summaryTitle = document.getElementById('summary-title');
    const filterStatus = document.getElementById('filter-status') as HTMLSelectElement;
    const filterType = document.getElementById('filter-type') as HTMLSelectElement;
    const btnRefresh = document.getElementById('btn-refresh');

    const detailModal = document.getElementById('detail-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalRam = document.getElementById('modal-ram');
    const modalMotor = document.getElementById('modal-motor');
    const modalKontakt = document.getElementById('modal-kontakt');
    const modalLokalita = document.getElementById('modal-lokalita');
    const modalPopis = document.getElementById('modal-popis');
    const modalPhotos = document.getElementById('modal-photos');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalCancelBtn = document.getElementById('modal-cancel-btn');
    const modalApproveBtn = document.getElementById('modal-approve-btn');
    const modalRejectBtn = document.getElementById('modal-reject-btn');

    function escapeHtml(s: string | null | undefined): string {
      return (s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[c] as string));
    }

    function typLabel(hodnota: string): string {
      const radek = ciselnikTyp.find((r) => r.hodnota === hodnota);
      const zavod = radek?.objem_ccm && radek.objem_ccm > 300 ? '350' : '250';
      const ogar = hodnota === '12' ? ' Ogar' : '';
      return `Jawa ${zavod} typ ${hodnota}${ogar}`;
    }

    function stavLabel(hodnota: string): string {
      return ciselnikStav.find((r) => r.hodnota === hodnota)?.popis_cs ?? hodnota;
    }

    function fotoSlovo(n: number): string {
      if (n === 1) return 'fotka';
      if (n >= 2 && n <= 4) return 'fotky';
      return 'fotek';
    }

    function formatDatum(iso: string | null | undefined): string {
      if (!iso) return '—';
      return new Date(iso).toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' });
    }

    async function init() {
      // Číselníky jen doplňují popisky (typLabel/stavLabel mají fallback
      // na syrovou hodnotu) — jejich výpadek nesmí zablokovat přihlášení.
      await nactiCiselniky();

      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (session?.user) {
          showAuthenticated(session.user.email);
          loadStroje();
        } else {
          showLogin();
        }
      } catch (e) {
        console.error('Ověření relace selhalo', e);
        showLogin();
      }
    }

    async function nactiCiselniky() {
      try {
        const [{ data: typy }, { data: stavy }] = await Promise.all([
          supabase.from('ciselnik_typ').select('*').order('poradi'),
          supabase.from('ciselnik_stav').select('*').order('poradi'),
        ]);
        ciselnikTyp = typy ?? [];
        ciselnikStav = stavy ?? [];
      } catch (e) {
        console.error('Číselníky se nepodařilo načíst', e);
      }
    }

    function showAuthenticated(email: string | undefined) {
      loginSection?.classList.add('hidden');
      dashboardSection?.classList.remove('hidden');
      btnLogout?.classList.remove('hidden');
      btnLogout?.classList.add('inline-flex');
      if (userEmail) userEmail.textContent = email || 'Správce';
    }

    function showLogin() {
      loginSection?.classList.remove('hidden');
      dashboardSection?.classList.add('hidden');
      btnLogout?.classList.add('hidden');
      btnLogout?.classList.remove('inline-flex');
    }

    formLogin?.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginError?.classList.add('hidden');
      const email = (document.getElementById('input-email') as HTMLInputElement).value;
      const password = (document.getElementById('input-password') as HTMLInputElement).value;

      const { data, error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) {
        if (loginError) {
          loginError.textContent = 'Nesprávný e-mail nebo heslo.';
          loginError.classList.remove('hidden');
        }
      } else if (data.session) {
        showAuthenticated(data.session.user.email);
        loadStroje();
      }
    });

    btnLogout?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      showLogin();
    });

    btnRefresh?.addEventListener('click', () => loadStroje());
    filterStatus?.addEventListener('change', () => renderStroje());
    filterType?.addEventListener('change', () => renderStroje());

    async function loadStroje() {
      if (!strojeList) return;
      strojeList.innerHTML = '<div class="p-12 text-center bg-card border border-rule text-xs text-mute rounded-sm">Načítám záznamy z databáze…</div>';

      const { data, error } = await supabase
        .from('stroje')
        .select('*')
        .order('vytvoreno_at', { ascending: false });

      if (error) {
        strojeList.innerHTML = `<div class="p-4 bg-paper-2 text-perak text-xs border border-perak/20 rounded-sm">Chyba při komunikaci s databází: ${escapeHtml(error.message)}</div>`;
        return;
      }

      allStroje = (data as Stroj[]) ?? [];

      fotkyByStroj = {};
      const ids = allStroje.map((s) => s.id);
      if (ids.length > 0) {
        const { data: fotky } = await supabase
          .from('stroje_fotky')
          .select('*')
          .in('stroj_id', ids)
          .order('poradi');
        for (const f of (fotky as Fotka[]) ?? []) {
          (fotkyByStroj[f.stroj_id] ??= []).push(f);
        }
      }

      updateSummary();
      await renderStroje();
    }

    function updateSummary() {
      const pendingCount = allStroje.filter((s) => s.stav_moderace === 'ceka').length;

      if (badgePending) {
        badgePending.textContent = pendingCount.toString();
        badgePending.classList.toggle('hidden', pendingCount === 0);
      }

      if (summaryTitle) {
        const sloveso = pendingCount === 1 ? 'stroj vyžaduje' : (pendingCount >= 2 && pendingCount <= 4 ? 'stroje vyžadují' : 'strojů vyžaduje');
        summaryTitle.textContent = `Čekající žádosti o zápis (${pendingCount} ${sloveso} schválení)`;
      }
    }

    const ICON_HODINY = '<svg class="w-3 h-3 text-perak flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
    const ICON_SCHVALIT = '<svg class="w-3.5 h-3.5 text-[#C89D42] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
    const ICON_ZAMITNOUT = '<svg class="w-3.5 h-3.5 text-perak flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
    const ICON_OKO = '<svg class="w-3.5 h-3.5 text-perak flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>';
    const ICON_FOTOAPARAT = '<svg class="w-6 h-6 text-gold mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z"/><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z"/></svg>';

    function statusBadge(stav: Stroj['stav_moderace']): string {
      if (stav === 'ceka') {
        return `<span class="ml-auto inline-flex items-center gap-1 text-[11px] font-sans font-semibold text-perak bg-perak/10 border border-perak/30 px-2 py-0.5 rounded-sm">${ICON_HODINY} Ke schválení</span>`;
      }
      if (stav === 'schvaleno') {
        return `<span class="ml-auto inline-flex items-center gap-1 text-[11px] font-sans font-semibold text-[#2E6B32] bg-[#2E6B32]/10 border border-[#2E6B32]/30 px-2 py-0.5 rounded-sm"><svg class="w-3 h-3 text-[#2E6B32] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Schváleno v registru</span>`;
      }
      return `<span class="ml-auto inline-flex items-center gap-1 text-[11px] font-sans font-semibold text-mute bg-paper border border-rule px-2 py-0.5 rounded-sm"><svg class="w-3 h-3 text-mute flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Zamítnuto</span>`;
    }

    async function renderStroje() {
      if (!strojeList) return;

      const statusFilter = filterStatus.value;
      const typeFilter = filterType.value;

      const filtered = allStroje.filter((s) => {
        if (statusFilter !== 'all' && s.stav_moderace !== statusFilter) return false;
        if (typeFilter !== 'all' && s.typ !== typeFilter) return false;
        return true;
      });

      if (filtered.length === 0) {
        strojeList.innerHTML = `
          <div class="bg-card border border-rule p-12 text-center text-xs text-mute rounded-sm">
            <p class="font-serif text-base text-ink font-bold mb-1">Žádné odpovídající stroje</p>
            <p>Pro vybraný filtr nebyl v databázi nalezen žádný motocykl.</p>
          </div>
        `;
        return;
      }

      // Náhledové fotky se podepisují hromadně jedním voláním, ne stroj po stroji.
      const nahledoveCesty = filtered
        .map((s) => fotkyByStroj[s.id]?.[0]?.url)
        .filter((cesta): cesta is string => Boolean(cesta));

      const nahledyMap: Record<string, string> = {};
      if (nahledoveCesty.length > 0) {
        const { data: podepsane } = await supabase.storage.from('stroje-fotky').createSignedUrls(nahledoveCesty, 3600);
        for (const p of podepsane ?? []) {
          if (p.signedUrl && p.path) nahledyMap[p.path] = p.signedUrl;
        }
      }

      strojeList.innerHTML = filtered.map((stroj) => {
        const fotky = fotkyByStroj[stroj.id] ?? [];
        const photoCount = fotky.length;
        const prvniCesta = fotky[0]?.url;
        const firstPhotoUrl = prvniCesta ? nahledyMap[prvniCesta] : '';
        const datum = formatDatum(stroj.vytvoreno_at);
        const lokalita = [stroj.region, stroj.zeme].filter(Boolean).map(escapeHtml).join(', ') || '—';

        return `
          <div class="bg-card border border-rule hover:border-gold transition-colors p-5 rounded-sm shadow-sm flex flex-col md:flex-row gap-5 items-start">
            <div class="w-full md:w-48 h-32 bg-paper-2 border border-rule rounded-sm overflow-hidden flex-shrink-0 relative group">
              ${firstPhotoUrl ? `
                <img src="${firstPhotoUrl}" alt="${escapeHtml(typLabel(stroj.typ))}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              ` : `
                <div class="w-full h-full flex flex-col items-center justify-center text-mute text-xs">
                  ${ICON_FOTOAPARAT}
                  <span>Bez fotografie</span>
                </div>
              `}
              ${photoCount > 0 ? `
                <div class="absolute bottom-1 right-1 bg-ink/80 text-paper text-[10px] font-sans px-1.5 py-0.5 rounded-sm">
                  ${photoCount} ${fotoSlovo(photoCount)}
                </div>
              ` : ''}
            </div>

            <div class="flex-1 min-w-0 w-full">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <span class="font-bold text-base text-perak">${escapeHtml(typLabel(stroj.typ))}</span>
                <span class="text-xs font-sans px-2 py-0.5 bg-paper-2 border border-rule text-mute rounded-sm">
                  Rok ${stroj.rok_vyroby ?? '—'}
                </span>
                <span class="text-xs font-sans px-2 py-0.5 bg-paper border border-gold/40 text-ink rounded-sm">
                  ${escapeHtml(stavLabel(stroj.stav))}
                </span>
                ${statusBadge(stroj.stav_moderace)}
              </div>

              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 py-2 my-2 border-y border-rule/70 text-xs font-sans">
                <div>
                  <span class="text-mute block text-[10px] uppercase tracking-wider">Číslo rámu</span>
                  <span class="font-mono font-bold text-ink">${escapeHtml(stroj.cislo_ramu) || '—'}</span>
                </div>
                <div>
                  <span class="text-mute block text-[10px] uppercase tracking-wider">Číslo motoru</span>
                  <span class="font-mono font-bold text-ink">${escapeHtml(stroj.cislo_motoru) || '—'}</span>
                </div>
                <div>
                  <span class="text-mute block text-[10px] uppercase tracking-wider">Kontakt / lokalita</span>
                  <span class="text-ink break-words">${escapeHtml(stroj.kontakt_email) || 'Neuvedeno'} (${lokalita})</span>
                </div>
                <div>
                  <span class="text-mute block text-[10px] uppercase tracking-wider">Podáno</span>
                  <span class="text-mute">${datum}</span>
                </div>
              </div>

              <p class="text-xs text-mute line-clamp-2 leading-relaxed">
                ${escapeHtml(stroj.pribeh) || 'K tomuto motocyklu nebyl přiložen žádný doplňující text.'}
              </p>

              <div class="mt-3 pt-2 flex flex-wrap items-center gap-2 font-sans text-xs">
                <button
                  class="btn-detail inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-sans rounded-[2px] bg-paper-2 hover:bg-rule text-ink border border-rule transition-colors"
                  data-id="${stroj.id}"
                >
                  ${ICON_OKO}
                  <span>Detailní posudek &amp; fotky</span>
                </button>

                ${stroj.stav_moderace !== 'schvaleno' ? `
                  <button
                    class="btn-approve inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-sans rounded-[2px] bg-perak hover:bg-perak-hover text-paper border border-perak transition-colors font-medium"
                    data-id="${stroj.id}"
                  >
                    ${ICON_SCHVALIT}
                    <span>Schválit do registru</span>
                  </button>
                ` : ''}
                ${stroj.stav_moderace !== 'zamitnuto' ? `
                  <button
                    class="btn-reject inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-sans rounded-[2px] bg-paper hover:bg-paper-2 text-perak border border-perak/30 transition-colors"
                    data-id="${stroj.id}"
                  >
                    ${ICON_ZAMITNOUT}
                    <span>Zamítnout</span>
                  </button>
                ` : ''}
              </div>
            </div>
          </div>
        `;
      }).join('');

      document.querySelectorAll('.btn-detail').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          const stroj = allStroje.find((s) => s.id === id);
          if (stroj) openDetailModal(stroj);
        });
      });

      document.querySelectorAll('.btn-approve').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          if (id && confirm('Opravdu chcete tento stroj schválit do veřejného registru jawaperak.cz?')) {
            await approveStroj(id);
          }
        });
      });

      document.querySelectorAll('.btn-reject').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          if (id && confirm('Opravdu chcete tento záznam zamítnout? Zůstane uložen se stavem "zamítnuto".')) {
            await rejectStroj(id);
          }
        });
      });
    }

    async function openDetailModal(stroj: Stroj) {
      currentModalStrojId = stroj.id;
      if (!detailModal) return;

      if (modalTitle) modalTitle.textContent = `${typLabel(stroj.typ)} (${stroj.rok_vyroby ?? '—'})`;
      if (modalRam) modalRam.textContent = stroj.cislo_ramu || '—';
      if (modalMotor) modalMotor.textContent = stroj.cislo_motoru || '—';
      if (modalKontakt) modalKontakt.textContent = [stroj.kontakt_email, stroj.kontakt_telefon].filter(Boolean).join(' · ') || 'Neuvedeno';
      if (modalLokalita) modalLokalita.textContent = [stroj.region, stroj.zeme].filter(Boolean).join(', ') || '—';
      if (modalPopis) modalPopis.textContent = stroj.pribeh || 'Bez přiloženého popisu.';

      if (modalPhotos) {
        const fotky = fotkyByStroj[stroj.id] ?? [];
        if (fotky.length > 0) {
          modalPhotos.innerHTML = '<div class="text-xs text-mute col-span-2 py-4">Generuji podepsané URL pro náhled fotografií…</div>';
          const { data: podepsane } = await supabase.storage
            .from('stroje-fotky')
            .createSignedUrls(fotky.map((f) => f.url), 3600);

          const urls = (podepsane ?? []).filter((p) => p.signedUrl);
          if (urls.length > 0) {
            modalPhotos.innerHTML = urls.map((p, i) => `
              <div class="border border-rule bg-card p-1 rounded-sm">
                <a href="${p.signedUrl}" target="_blank" rel="noopener noreferrer">
                  <img src="${p.signedUrl}" alt="Foto stroje" class="w-full h-40 object-cover rounded-sm hover:opacity-90 transition-opacity" />
                </a>
                <div class="text-[10px] font-sans text-mute mt-1 px-1">
                  Fotka #${i + 1} · EXIF/GPS odstraněno (sharp)
                </div>
              </div>
            `).join('');
          } else {
            modalPhotos.innerHTML = '<div class="text-xs text-mute col-span-2 py-2">Fotografie se nepodařilo podepsat.</div>';
          }
        } else {
          modalPhotos.innerHTML = '<div class="text-xs text-mute col-span-2 py-2">K tomuto stroji nebyly nahrány žádné fotky.</div>';
        }
      }

      if (modalApproveBtn) (modalApproveBtn as HTMLElement).style.display = stroj.stav_moderace === 'schvaleno' ? 'none' : 'inline-flex';
      if (modalRejectBtn) (modalRejectBtn as HTMLElement).style.display = stroj.stav_moderace === 'zamitnuto' ? 'none' : 'inline-flex';

      detailModal.classList.remove('hidden');
    }

    function closeDetailModal() {
      detailModal?.classList.add('hidden');
      currentModalStrojId = null;
    }

    modalCloseBtn?.addEventListener('click', closeDetailModal);
    modalCancelBtn?.addEventListener('click', closeDetailModal);

    modalApproveBtn?.addEventListener('click', async () => {
      if (currentModalStrojId && confirm('Schválit tento stroj do veřejného registru?')) {
        await approveStroj(currentModalStrojId);
        closeDetailModal();
      }
    });

    modalRejectBtn?.addEventListener('click', async () => {
      if (currentModalStrojId && confirm('Zamítnout tento záznam? Zůstane uložen se stavem "zamítnuto".')) {
        await rejectStroj(currentModalStrojId);
        closeDetailModal();
      }
    });

    async function approveStroj(id: string) {
      const { error } = await supabase
        .from('stroje')
        .update({ stav_moderace: 'schvaleno', schvaleno_at: new Date().toISOString() })
        .eq('id', id);
      if (error) {
        alert('Chyba při schvalování: ' + error.message);
      } else {
        await loadStroje();
      }
    }

    async function rejectStroj(id: string) {
      // Řádek se nemaže — RLS admin_moderace_update povoluje jen UPDATE,
      // ne DELETE, a zamítnuté záznamy tak zůstávají v databázi k dohledání.
      const { error } = await supabase
        .from('stroje')
        .update({ stav_moderace: 'zamitnuto' })
        .eq('id', id);
      if (error) {
        alert('Chyba při zamítání: ' + error.message);
      } else {
        await loadStroje();
      }
    }

    init();
  </script>
  <style is:global>
    /* ================================================================
       ČSN 8850 TISKAŘSKÝ STYL — Sjednoceno s design systémem jawaperak.cz
       ================================================================ */

    #admin-root button,
    #admin-root select,
    #admin-root input {
      box-sizing: border-box;
      outline: none;
    }

    #admin-root a {
      text-decoration: none !important;
    }

    /* Vynucení tiskařských linek při vypnutém Tailwind preflightu */
    #admin-root .border-y {
      border-top-style: solid !important;
      border-bottom-style: solid !important;
    }
    #admin-root .border-b-2 {
      border-bottom-style: solid !important;
    }
    #admin-root .border,
    #admin-root .border-t,
    #admin-root .border-b,
    #admin-root .border-l,
    #admin-root .border-r {
      border-style: solid !important;
    }

    /* --- PRIMÁRNÍ TLAČÍTKO (jako .btn na jawaperak.cz) --- */
    .jp-btn-primary {
      display: inline-flex !important;
      align-items: center !important;
      gap: 7px !important;
      background: var(--red) !important;
      color: var(--paper) !important;
      border: 2px solid var(--ink) !important;
      border-radius: 0 !important;
      font-family: var(--disp) !important;
      font-size: 11.5px !important;
      font-weight: 600 !important;
      letter-spacing: .12em !important;
      text-transform: uppercase !important;
      padding: 7px 14px !important;
      line-height: 1.2 !important;
      cursor: pointer !important;
      transition: background .15s ease, color .15s ease !important;
      -webkit-appearance: none !important;
      appearance: none !important;
    }
    .jp-btn-primary:hover {
      background: var(--ink) !important;
      color: var(--paper) !important;
    }

    /* --- SEKUNDÁRNÍ TLAČÍTKO (Detail, Obnovit, Odhlásit, Zavřít) --- */
    .jp-btn-secondary {
      display: inline-flex !important;
      align-items: center !important;
      gap: 7px !important;
      background: var(--paper-2) !important;
      color: var(--ink) !important;
      border: 1px solid var(--ink) !important;
      border-radius: 0 !important;
      font-family: var(--disp) !important;
      font-size: 11.5px !important;
      font-weight: 600 !important;
      letter-spacing: .11em !important;
      text-transform: uppercase !important;
      padding: 7px 13px !important;
      line-height: 1.2 !important;
      cursor: pointer !important;
      transition: background .15s ease, color .15s ease, border-color .15s ease !important;
      -webkit-appearance: none !important;
      appearance: none !important;
    }
    .jp-btn-secondary:hover {
      background: var(--ink) !important;
      color: var(--paper) !important;
      border-color: var(--ink) !important;
    }
    .jp-btn-secondary:hover svg {
      color: var(--paper) !important;
    }

    /* --- ZAMÍTNOUT (červený tiskařský rámeček) --- */
    .jp-btn-danger {
      display: inline-flex !important;
      align-items: center !important;
      gap: 7px !important;
      background: transparent !important;
      color: var(--red) !important;
      border: 1px solid var(--red) !important;
      border-radius: 0 !important;
      font-family: var(--disp) !important;
      font-size: 11.5px !important;
      font-weight: 600 !important;
      letter-spacing: .11em !important;
      text-transform: uppercase !important;
      padding: 7px 13px !important;
      line-height: 1.2 !important;
      cursor: pointer !important;
      transition: background .15s ease, color .15s ease !important;
      -webkit-appearance: none !important;
      appearance: none !important;
    }
    .jp-btn-danger:hover {
      background: var(--red) !important;
      color: var(--paper) !important;
    }
    .jp-btn-danger:hover svg {
      color: var(--paper) !important;
    }

    /* --- FILTRY (<select>) --- */
    .jp-select {
      display: inline-block !important;
      -webkit-appearance: none !important;
      -moz-appearance: none !important;
      appearance: none !important;
      background-color: var(--paper-2) !important;
      border: 1px solid var(--ink) !important;
      border-radius: 0 !important;
      color: var(--ink) !important;
      font-family: var(--disp) !important;
      font-size: 12px !important;
      font-weight: 500 !important;
      letter-spacing: .06em !important;
      padding: 7px 30px 7px 12px !important;
      cursor: pointer !important;
      background-image: none !important;
    }
    .jp-select:focus {
      border-color: var(--red) !important;
    }
  </style>
</Layout>
