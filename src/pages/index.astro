---
import Layout from '../layouts/Layout.astro';
import photos from '../data/homepage.json';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<Layout title="Pérák — typy, výrobní čísla, technika | jawaperak.cz">

<!-- ============================================================
     MUZEJNÍ REJSTŘÍK — hero + fakta
     ============================================================ -->
<section class="ld-hero">
  {photos.hero.image ? (
    <img class="ld-hero__img" src={photos.hero.image} alt={photos.hero.alt} />
  ) : (
    <div class="ld-hero__ph" aria-hidden="true"><span>{photos.hero.placeholderText}</span></div>
  )}
  <div class="ld-hero__scrim"></div>
  <div class="ld-hero__text">
    <p class="ld-eyebrow">Zbrojovka Ing. F. Janeček — Praha-Nusle II.</p>
    <h1 class="ld-h1">Pérák</h1>
    <p class="ld-sub">Devět let výroby, dva objemy motoru a stroj, který dodnes definuje poválečné motocyklové Československo. <strong>Kompletní historie, technika i registr dochovaných kusů na jednom místě.</strong></p>
  </div>
</section>

<section class="facts">
  <h2 class="facts__h">V číslech.</h2>
  <div class="facts__grid">
    <div class="fnum">
      <span class="fnum__n">11 · 12 · 18</span>
      <span class="fnum__l">typová označení</span>
    </div>
    <a class="fnum fnum--link" href="/perak/identifikace/#kolik">
      <span class="fnum__n">128 000+ ks</span>
      <span class="fnum__l">vyrobeno, typ 11 — dolní mez <span class="stamp od">odhad</span></span>
    </a>
    <div class="fnum">
      <span class="fnum__n">Praha-Nusle</span>
      <span class="fnum__l">Zbrojovka Ing. F. Janečka</span>
    </div>
    <div class="fnum">
      <span class="fnum__n fnum__n--inf">∞</span>
      <span class="fnum__l">zážitků</span>
    </div>
  </div>
</section>

<!-- ============================================================
     TECHNICKÝ ARCHIV — typová řada, identifikace, údržba, registr
     ============================================================ -->
<div class="wrap">
  <div class="page">

    <section class="sec" id="typova-rada">
      <div class="sec-h">
        <span class="sec-n">01</span>
        <h2>Typová řada</h2>
        <p class="sub">Dvě kubatury, tři typová označení. Motory ani díly nejsou zaměnitelné.</p>
      </div>

      <table class="spec">
        <caption>Přehled typů 11 / 12 / 18</caption>
        <thead>
          <tr><th>Typ</th><th>Stroj</th><th>Výroba</th><th>Poznámka</th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="rl nw" data-l="Typ"><a href="/perak/250/">11</a></td>
            <td data-l="Stroj">Jawa 250</td>
            <td class="num nw" data-l="Výroba">1946–1954 <span class="stamp ov">ověřeno</span></td>
            <td class="q" data-l="Poznámka">Jednoválec 248,5 cm³. Od roku 1950 vyšší výkon a upravené žebrování.</td>
          </tr>
          <tr>
            <td class="rl nw" data-l="Typ"><a href="/perak/350/">12</a></td>
            <td data-l="Stroj">Jawa 350</td>
            <td class="num nw" data-l="Výroba">1948–1950 <span class="stamp ov">ověřeno</span></td>
            <td class="q" data-l="Poznámka">Dvouválec. Sdílí podvozek, ne pohon.</td>
          </tr>
          <tr>
            <td class="rl nw" data-l="Typ"><a href="/perak/350/">18</a></td>
            <td data-l="Stroj">Jawa 350</td>
            <td class="num nw" data-l="Výroba">1950–1954 <span class="stamp od">odhad</span></td>
            <td class="q" data-l="Poznámka">Nástupce typu 12, souběžně s typem 11.</td>
          </tr>
        </tbody>
      </table>

      <div class="rel">
        <span class="t">Souvisí</span>
        <a href="/perak/identifikace/">Určení podle výrobního čísla</a>
        <a href="/perak/technicke-udaje/">Technické údaje</a>
      </div>
    </section>

    <section class="sec" id="identifikace">
      <div class="sec-h">
        <span class="sec-n">02</span>
        <h2>Co mám za stroj</h2>
        <p class="sub">Opište tovární číslo ze štítku nebo z rámu. Řekneme vám rok výroby, provedení a na co si dát pozor.</p>
      </div>

      <div class="tool">
        <div class="tool-h">
          <span class="t">Určení podle výrobního čísla</span>
          <span class="s">rychlý odhad — <a href="/perak/identifikace/">plný nástroj v encyklopedii</a></span>
        </div>
        <div class="tool-b">
          <div class="ld-seg" role="group" aria-label="Typ stroje">
            <button type="button" class="ld-seg__btn is-on" data-typ="11">Typ 11</button>
            <button type="button" class="ld-seg__btn" data-typ="12">Typ 12</button>
            <button type="button" class="ld-seg__btn" data-typ="18">Typ 18</button>
          </div>
          <div class="tool-row">
            <label for="ld-cislo" class="ld-sr">Tovární číslo</label>
            <input type="text" id="ld-cislo" inputmode="numeric" autocomplete="off" placeholder="tovární číslo, např. 11-12862">
            <button type="button" id="ld-go">Určit</button>
          </div>
          <div class="ld-out" id="ld-out" aria-live="polite">
            <div class="ld-out__typ">Vybráno: typ <span id="ld-out-typ">11</span></div>
            <div class="ld-out__body" id="ld-out-body" hidden>
              <p class="ld-out__head" id="ld-out-head"></p>
              <p class="ld-out__desc" id="ld-out-desc"></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec" id="udrzba">
      <div class="sec-h">
        <span class="sec-n">03</span>
        <h2>Obsluha a údržba</h2>
        <p class="sub">Podle původní knížky obsluhy, přefocené a doplněné o to, co se za osmdesát let ukázalo.</p>
      </div>

      <div class="spots">
        {photos.udrzba.map((p) => (
          <article class="spot">
            {p.image ? (
              <div class="im"><img src={p.image} alt={p.alt} loading="lazy" /></div>
            ) : (
              <div class="im" aria-hidden="true"><b>{p.placeholderText}</b></div>
            )}
            <h4>{p.caption}</h4>
          </article>
        ))}
      </div>
    </section>

    <section class="sec" id="registr">
      <div class="sec-h">
        <span class="sec-n">04</span>
        <h2>Registr strojů</h2>
        <p class="sub">Kolik Péráků se dochovalo, neví nikdo. Zkoušíme to spočítat.</p>
      </div>

      <div class="reg" id="ld-registr-grid" aria-live="polite">
        <div class="reg-skel" aria-hidden="true"></div>
        <div class="reg-skel" aria-hidden="true"></div>
        <div class="reg-skel" aria-hidden="true"></div>
        <div class="reg-skel" aria-hidden="true"></div>
      </div>

      <div class="reg-cta">
        <a class="btn" href="/registr/pridat-stroj/">Přidat stroj</a>
        <a class="reg-cta__more" href="/registr/">Celý registr</a>
      </div>
    </section>

  </div>
</div>

<!-- ============================================================
     ZPĚT DO MUZEJNÍHO REJSTŘÍKU — dílna (PureBikes funnel)
     ============================================================ -->
<section class="ld-dilna">
  <div class="ld-dilna__inner">
    <div class="ld-dilna__text">
      <h2 class="ld-h2 ld-h2--ink">Z naší dílny</h2>
      <p class="ld-dilna__p">Historie stroje patří k jeho hodnotě. Kde to jde, patinu zachováváme a konzervujeme — místo aby zmizela pod novým lakem.</p>
      <a class="ld-dilna__link" href="/dilna/">Renovační deníky</a>
    </div>
    <figure class="ld-dilna__photo">
      {photos.dilna.image ? (
        <img class="ld-dilna__img" src={photos.dilna.image} alt={photos.dilna.alt} />
      ) : (
        <div class="ld-dilna__ph" aria-hidden="true"><span>{photos.dilna.placeholderText}</span></div>
      )}
      <figcaption>{photos.dilna.caption}</figcaption>
    </figure>
  </div>
</section>

<section class="ld-versus">
  <strong>Hledáte novou Jawu Perak?</strong>
  <span class="ld-versus__body">Bobber, který od roku 2019 vyrábí indický koncern Classic Legends. Jméno si vypůjčil od stroje z roku 1946.</span>
  <a class="ld-versus__link" href="/perak-vs-perak/">Rozdíly vedle sebe</a>
</section>

</Layout>

<script define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
  // Rychlý odhad roku výroby přímo na homepage — stejná tabulka rozsahů
  // výrobních čísel jako plný nástroj na /perak/identifikace/ (odvozeno
  // z ~240 fotografií původních štítků). Pokrývá průběžnou řadu čísel
  // do roku 1951; pro roční řady od 1952 (číslo s dvouciferným rokem
  // na konci) odkazuje na plný nástroj.
  const ROKY = {
    '11': [[1946,1,1500],[1947,1501,15800],[1948,15801,34900],[1949,34901,53800],[1950,53801,73000],[1951,73001,90000]],
    '12': [[1948,1,900],[1949,901,4500],[1950,4501,10000]],
    '18': [[1950,1,8000],[1951,8001,14200]]
  };
  const POZNAMKY = {
    '11': 'Jednoválec 248,5 cm³. U strojů do roku 1949 hlídejte původnost hlavy a nižší výkon.',
    '12': 'Dvouválec, vyráběn krátce. Náhradní díly pohonu jsou nejhůř dostupné z celé řady.',
    '18': 'Nástupce typu 12. Kontrolujte elektroinstalaci a stav dynama.'
  };

  let typ = '11';
  const seg = document.querySelectorAll('.ld-seg__btn');
  const elTyp = document.getElementById('ld-out-typ');
  const elCislo = document.getElementById('ld-cislo');
  const elBody = document.getElementById('ld-out-body');
  const elHead = document.getElementById('ld-out-head');
  const elDesc = document.getElementById('ld-out-desc');

  seg.forEach((b) => b.addEventListener('click', () => {
    typ = b.dataset.typ;
    seg.forEach((x) => x.classList.toggle('is-on', x === b));
    elTyp.textContent = typ;
  }));

  function odhadniRok(t, cislo) {
    const tab = ROKY[t] || [];
    for (const [rok, od, doC] of tab) {
      if (cislo >= od && cislo <= doC) return rok;
    }
    return null;
  }

  function vyhodnot() {
    const cifry = (elCislo.value || '').replace(/\D/g, '');
    if (cifry.length < 3) {
      elBody.hidden = false;
      elHead.textContent = 'Zadejte tovární číslo';
      elDesc.textContent = 'Číslo najdete na štítku na rámu pod sedlem, případně vyražené na rámu.';
      return;
    }
    const cislo = parseInt(cifry.slice(-6), 10);
    const rok = odhadniRok(typ, cislo);
    elBody.hidden = false;
    if (rok) {
      elHead.textContent = `Typ ${typ} · ${cislo} — orientačně rok ${rok}`;
      elDesc.textContent = POZNAMKY[typ] || '';
    } else {
      elHead.textContent = 'Mimo rozsah rychlého odhadu';
      elDesc.textContent = 'Tahle rychlá tabulka platí přibližně do roku 1951. Pro čísla s ročním sufixem od roku 1952 (např. 11-07390-52) použijte kompletní nástroj na stránce Určení podle výrobního čísla.';
    }
  }

  document.getElementById('ld-go').addEventListener('click', vyhodnot);
  elCislo.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); vyhodnot(); } });

  // --- Registr: 4 nejnovější schválené záznamy, stejný zdroj jako /registr/ ---
  const H = { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY };
  const esc = (s) => String(s ?? '').replace(/[<>&"]/g, (c) => ({ '<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;' }[c]));
  const grid = document.getElementById('ld-registr-grid');

  async function nactiRegistr() {
    try {
      const r = await fetch(
        `${SUPABASE_URL}/rest/v1/stroje_verejne?select=slug,typ,rok_vyroby,stav,region,zeme,cislo_ramu_maskovane&order=schvaleno_at.desc&limit=4`,
        { headers: H }
      );
      const data = await r.json();
      if (!Array.isArray(data) || data.length === 0) {
        grid.innerHTML = `<p class="reg-prazdno">Registr se teprve plní. Když přidáte svůj stroj, budete mezi prvními.</p>`;
        return;
      }
      grid.innerHTML = data.map((s) => {
        const misto = [s.region, s.zeme].filter(Boolean).map(esc).join(', ');
        const meta = [misto, s.cislo_ramu_maskovane ? `rám ${esc(s.cislo_ramu_maskovane)}` : ''].filter(Boolean).join(' · ');
        return `
        <a class="rec" href="/registr/stroj/${esc(s.slug)}/">
          <span class="rec__l">
            <span class="rt">Typ ${esc(s.typ)}${s.rok_vyroby ? ' · ' + esc(s.rok_vyroby) : ''}</span>
            ${meta ? `<span class="rm">${meta}</span>` : ''}
          </span>
          <span class="st">${esc(s.stav)}</span>
        </a>`;
      }).join('');
    } catch (e) {
      grid.innerHTML = '<p class="reg-prazdno">Registr se nepodařilo načíst.</p>';
      console.error(e);
    }
  }
  nactiRegistr();
</script>

<style>
  .ld-sr{position:absolute;left:-9999px}

  /* --- Hero --- */
  .ld-hero{position:relative;height:520px;overflow:hidden;border-bottom:1px solid var(--rule)}
  .ld-hero__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .ld-hero__ph{position:absolute;inset:0;background:repeating-linear-gradient(45deg,#DFD2B4 0 14px,#D8CAAA 14px 28px);
    display:flex;align-items:center;justify-content:center;text-align:center;padding:20px}
  .ld-hero__ph span{font-family:var(--disp);font-size:12px;letter-spacing:.1em;text-transform:uppercase;
    color:#7A6A50;max-width:26ch;line-height:1.6}
  .ld-hero__scrim{position:absolute;left:0;bottom:0;width:100%;height:70%;
    background:linear-gradient(to top,rgba(20,18,16,.82),transparent);pointer-events:none}
  .ld-hero__text{position:absolute;left:44px;bottom:40px;max-width:640px;color:var(--paper)}
  .ld-eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;
    opacity:.75;margin:0}
  .ld-h1{font-family:var(--body);font-size:clamp(44px,9vw,82px);line-height:.95;font-weight:400;
    margin:14px 0 16px;text-transform:none;letter-spacing:0}
  .ld-sub{font-family:var(--body);font-size:17px;line-height:1.6;margin:0;max-width:600px;text-wrap:pretty}

  /* --- Pérák v číslech: muzejní rejstřík, vzdušný pás faktů --- */
  .facts{max-width:1200px;margin:0 auto;padding:64px 26px 72px;text-align:center;
    border-bottom:3px double var(--ink)}
  .facts__h{font-family:var(--body);font-weight:400;font-size:clamp(24px,3vw,30px);
    letter-spacing:0;text-transform:none;color:var(--ink);margin:0}
  .facts__grid{margin:46px auto 0;max-width:980px;display:grid;grid-template-columns:repeat(4,1fr)}
  .fnum{padding:0 26px;border-left:1px solid var(--hair);text-decoration:none;color:inherit;background:none}
  .fnum:first-child{border-left:0}
  .fnum__n{display:block;font-family:var(--body);font-weight:400;font-size:clamp(24px,2.8vw,32px);
    line-height:1.1;color:var(--ink);letter-spacing:0}
  .fnum__n--inf{font-size:clamp(32px,4vw,44px);color:var(--red);line-height:1}
  .fnum__l{display:block;margin-top:11px;font-family:var(--mono);font-size:10.5px;letter-spacing:.07em;
    text-transform:uppercase;color:var(--mute-2);line-height:1.55}
  .fnum--link{transition:opacity .15s}
  .fnum--link:hover{opacity:.72}
  .fnum--link:hover .fnum__n{color:var(--red)}

  /* --- Archivní sekce: typová řada, identifikace, údržba, registr --- */
  .tool-h .s a{color:inherit;text-decoration:underline;text-decoration-color:rgba(232,222,200,.5)}
  .tool-h .s a:hover{text-decoration-color:currentColor}

  .spot .im{position:relative;overflow:hidden}
  .spot .im img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}

  .reg{margin-top:24px}
  .rec__l{display:flex;flex-direction:column;gap:3px}
  .reg-skel{height:52px;background:var(--card);border-bottom:1px solid var(--hair)}
  .reg-prazdno{padding:24px 0;color:var(--mute);font-family:var(--body);text-align:center;border-bottom:1px solid var(--hair)}

  .reg-cta{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:22px}
  .reg-cta__more{font-family:var(--disp);font-size:13.5px;letter-spacing:.08em;text-transform:uppercase;
    color:var(--red);text-decoration:none;border-bottom:1px solid var(--red);padding-bottom:2px}

  /* --- Z naší dílny --- */
  .ld-dilna{background:var(--ink);color:#f2efe6}
  .ld-dilna__inner{display:grid;grid-template-columns:1.1fr 1fr;gap:44px;padding:44px 26px;
    max-width:1160px;margin:0 auto;align-items:center}
  .ld-h2{font-family:var(--body);font-size:30px;font-weight:400;margin:0;text-transform:none;letter-spacing:0}
  .ld-h2--ink{color:#f2efe6}
  .ld-dilna__p{font-family:var(--body);font-size:16px;line-height:1.65;color:#c9c4b8;margin:12px 0 22px;text-wrap:pretty}
  .ld-dilna__link{font-family:var(--disp);font-size:14px;border-bottom:1px solid #f2efe6;color:#f2efe6;text-decoration:none}
  .ld-dilna__photo{margin:0;display:flex;flex-direction:column;gap:10px}
  .ld-dilna__img{display:block;width:100%;height:240px;object-fit:cover}
  .ld-dilna__ph{height:240px;background:repeating-linear-gradient(45deg,#2a2620 0 12px,#242019 12px 24px);
    border:1px solid #3a352c;display:flex;align-items:flex-end;padding:9px}
  .ld-dilna__ph span{font-family:var(--disp);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#c9c4b8}
  .ld-dilna__photo figcaption{font-family:var(--body);font-style:italic;font-size:14px;color:#c9c4b8}

  /* --- Perak vs Pérák --- */
  .ld-versus{display:flex;gap:16px;align-items:baseline;flex-wrap:wrap;padding:26px;
    border-bottom:1px solid var(--rule);font-family:var(--disp);font-size:14px;color:var(--mute);
    max-width:1160px;margin:0 auto}
  .ld-versus strong{color:var(--ink)}
  .ld-versus__body{flex:1;min-width:200px}
  .ld-versus__link{color:var(--red);border-bottom:1px solid var(--red);text-decoration:none;white-space:nowrap}

  @media (max-width:1239px){
    .ld-versus{padding-left:26px;padding-right:26px}
  }

  @media (max-width:880px){
    .ld-hero{height:380px}
    .ld-hero__ph{align-items:flex-start;padding-top:26px}
    .ld-hero__text{left:22px;bottom:24px;max-width:calc(100% - 44px)}
    .facts{padding:52px 22px 60px}
    .facts__grid{grid-template-columns:1fr 1fr;row-gap:34px;margin-top:38px}
    .fnum:nth-child(3){border-left:0}
    .ld-dilna__inner{grid-template-columns:1fr;padding:32px 22px}
    .ld-versus{padding:20px 22px;flex-direction:column;align-items:flex-start;gap:8px}
  }

  @media (max-width:520px){
    .facts__grid{grid-template-columns:1fr;row-gap:28px}
    .fnum{border-left:0;padding:0}
    .ld-h1{font-size:clamp(38px,15vw,60px)}
  }
</style>
