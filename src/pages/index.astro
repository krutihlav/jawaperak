---
// src/pages/index.astro
// Koncept A (Archival Craft) — homepage sestavená ze špičkových modulů;
// karty registru se načítají klientsky.
import Layout from '../layouts/Layout.astro';
import ModelComparator from '../components/ModelComparator.astro';
import SerialDecoder from '../components/SerialDecoder.astro';
import CatalogGroups from '../components/CatalogGroups.astro';
import WorkshopBanner from '../components/WorkshopBanner.astro';
import { KATALOG_URL } from '../data/katalogSkupiny';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// Karty registru se načítají v prohlížeči (skript na konci souboru), aby se nový
// schválený stroj objevil bez dalšího deploye.
---

<Layout
  title="Jawa Pérák — typy, výrobní čísla, technika | jawaperak.cz"
  description="Nejúplnější nezávislá digitální monografie legendárního motocyklu Jawa 250 typ 11, 350 typ 12 Ogar a typ 18. Dobový katalog náhradních dílů 1949 a registr dochovaných strojů."
>
  <!-- 1. HERO SECTION: Full-width Návrh 2 (Archivní hlubotisk / Duplex) -->
  <section class="relative w-full border-b border-[var(--rule)] bg-[var(--paper)] py-16 sm:py-24 overflow-hidden">
    {/* Fotografie Návrh 2: Celoplošná desaturovaná s teplým hlubotiskovým tónem */}
    <img
      src="/uploads/homepage/jawa_250_pérák_-1951-_in_ntm_prague.webp"
      alt="Jawa 250 Pérák v Národním technickém muzeu v Praze"
      class="absolute inset-0 w-full h-full object-cover object-[center_35%] pointer-events-none filter grayscale contrast-125 sepia-[0.22] opacity-70 mix-blend-multiply"
      loading="eager"
      fetchpriority="high"
    />
    {/* Plynulý tiskařský přechod do slonoviny zleva i zdola */}
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--paper)] via-[var(--paper)]/90 to-[var(--paper)]/40 pointer-events-none" />
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--paper)] via-transparent to-transparent pointer-events-none" />

    {/* Kontejner s obsahem zarovnaný do standardní šířky stránky */}
    <div class="wrap--wide relative z-10 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--card)]/90 border border-[var(--rule)] text-xs font-mono text-[var(--red)] font-semibold shadow-xs">
        <span>Zbrojovka Ing. F. Janeček • Praha-Nusle II.</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-serif text-[var(--ink)] font-normal leading-tight max-w-3xl">
        Jawa Pérák
      </h1>
      <p class="text-lg sm:text-xl text-[var(--mute)] font-sans leading-relaxed max-w-2xl">
        Devět let výroby, dva objemy motoru a konstrukční zázrak zrozený v utajení za protektorátu.
        Nejúplnější technický archiv, originální katalog náhradních dílů z roku 1949 a nezávislý registr dochovaných kusů.
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-4">
        <a href="#modely" class="px-6 py-3 rounded-xl bg-[var(--red)] hover:bg-[var(--red-hover)] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow">
          Prozkoumat typy 11, 12 a 18
        </a>
        <a href="#dekoder" class="px-6 py-3 rounded-xl bg-[var(--card)] hover:bg-[var(--paper-2)] border border-[var(--rule)] text-[var(--ink)] text-xs font-bold uppercase tracking-wider transition-colors">
          Ověřit výrobní číslo
        </a>
        <a href={KATALOG_URL} class="px-6 py-3 rounded-xl bg-[var(--card)] hover:bg-[var(--paper-2)] border border-[var(--rule)] text-[var(--ink)] text-xs font-bold uppercase tracking-wider transition-colors">
          Katalog dílů 1949 &rarr;
        </a>
      </div>
      <div class="pt-6 flex flex-wrap items-center gap-6 text-xs font-mono text-[var(--mute)]">
        <span>Výroba: 1946–1954</span>
        <span class="hidden sm:inline">•</span>
        <span>Přes 128 000 vyrobených kusů</span>
        <span class="hidden sm:inline">•</span>
        <span>Zbrojovka Janeček / Zbrojovka Brno</span>
      </div>
    </div>
  </section>

  <div class="wrap--wide space-y-16 sm:space-y-24 pt-12 sm:pt-16">

    <!-- 2. MODEL COMPARISON: 11 vs 12 vs 18 -->
    <div id="modely">
      <ModelComparator />
    </div>

    <!-- 3. FORENSIC SERIAL DECODER -->
    <div id="dekoder">
      <SerialDecoder />
    </div>

    <!-- 4. SPARE PARTS CATALOG 1949 -->
    <div id="katalog">
      <CatalogGroups />
    </div>

    <!-- 5. REGISTRY ARCHIVE -->
    <section id="registr" class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-[var(--rule)] pb-4">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-[var(--red)] font-semibold">Veřejný archiv dochovaných kusů</span>
          <h2 class="text-2xl sm:text-3xl font-serif text-[var(--ink)] mt-0.5">
            Registr Jawa Pérák
          </h2>
        </div>
        <a href="/registr/pridat-stroj/" class="text-xs font-bold font-sans text-[var(--red)] hover:underline">
          + Přidat svůj stroj &rarr;
        </a>
      </div>

      <div id="registr-karty" class="grid grid-cols-1 sm:grid-cols-2 gap-4" aria-live="polite">
        {[0, 1, 2, 3].map(() => (
          <div class="p-5 rounded-2xl border border-[var(--rule)] bg-[var(--card)] space-y-3 animate-pulse" aria-hidden="true">
            <div class="h-4 w-2/3 rounded bg-[var(--paper-2)]" />
            <div class="h-4 w-1/3 rounded bg-[var(--paper-2)]" />
            <div class="h-3 w-1/2 rounded bg-[var(--paper-2)]" />
          </div>
        ))}
      </div>

      <p>
        <a href="/registr/" class="text-sm font-bold font-sans text-[var(--red)] hover:underline">
          Zobrazit celý registr &rarr;
        </a>
      </p>
    </section>

    <!-- 6. WORKSHOP PUREBIKES DRAHANOVICE -->
    <div id="dilna">
      <WorkshopBanner />
    </div>

  </div>
</Layout>

<script define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
  (async () => {
    const box = document.getElementById('registr-karty');
    if (!box) return;
    const H = { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY };
    const esc = (v) => String(v ?? '').replace(/[<>&"]/g, (c) =>
      ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c]));
    const get = async (cesta) => {
      const r = await fetch(`${SUPABASE_URL}/rest/v1/${cesta}`, { headers: H });
      if (!r.ok) throw new Error(cesta + ' ' + r.status);
      return r.json();
    };
    try {
      const [stroje, typy, stavy] = await Promise.all([
        get('stroje_verejne?select=slug,typ,rok_vyroby,stav,region,zeme,cislo_ramu_maskovane&order=schvaleno_at.desc&limit=4'),
        get('ciselnik_typ?select=hodnota,popis_cs'),
        get('ciselnik_stav?select=hodnota,popis_cs'),
      ]);
      const TYP = Object.fromEntries(typy.map((r) => [r.hodnota, r.popis_cs]));
      const STAV = Object.fromEntries(stavy.map((r) => [r.hodnota, r.popis_cs]));
      box.innerHTML = stroje.map((s) => `
        <a href="/registr/stroj/${esc(s.slug)}/" class="block p-5 rounded-2xl border border-[var(--rule)] bg-[var(--card)] space-y-2 hover:border-[var(--red)] transition-colors shadow-sm no-underline">
          <h3 class="font-bold text-base text-[var(--ink)]">${esc(TYP[s.typ] || 'Typ ' + s.typ)}${s.rok_vyroby ? ' · ' + esc(s.rok_vyroby) : ''}</h3>
          ${s.cislo_ramu_maskovane ? `<code class="text-xs font-bold font-mono px-2 py-0.5 rounded bg-[var(--paper-2)] border border-[var(--rule)] text-[var(--ink)]">${esc(s.cislo_ramu_maskovane)}</code>` : ''}
          <p class="text-xs text-[var(--mute)]">${[s.stav ? (STAV[s.stav] || s.stav) : null, s.region, s.zeme].filter(Boolean).map(esc).join(' • ')}</p>
        </a>`).join('');
    } catch (e) {
      console.error('Registr se nepodařilo načíst', e);
      box.remove();
    }
  })();
</script>
