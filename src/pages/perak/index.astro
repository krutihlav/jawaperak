---
import Layout from '../../layouts/Layout.astro';
import { encyklopedie, skupiny } from '../../data/encyklopedie';

const hotovo = encyklopedie.filter((s) => s.hotovo).length;
---

<Layout
  title="Encyklopedie Jawa Pérák — typy, technika, identifikace | jawaperak.cz"
  description="Referenční přehled o motocyklu Jawa 250/350 Pérák: dvěstěpadesátka i třistapadesátka, výrobní čísla a datování, motor, podvozek, elektroinstalace, barvy a technické údaje."
>
  <div class="wrap">
    <div class="page">

      <p class="kicker">Pilíř webu</p>
      <h1>Encyklopedie Péráku</h1>
      <p class="lead">
        Všechno, co o Péráku víme a umíme doložit, na jednom místě. Píšeme to
        tak, aby se to dalo použít v garáži — a u každého tvrzení je vidět,
        odkud pochází a jak jistě.
      </p>

      <div class="tldr">
        <h2>Jak to číst</h2>
        <ol>
          <li><span>U tvrzení najdete <b>razítko spolehlivosti</b>. Černé „kniha“ znamená doloženo monografií, modré „ověřeno“ dva nezávislé prameny, béžové „odhad“ jeden pramen a červené „sporné“ znamená, že se prameny neshodnou.</span></li>
          <li><span>Kde si nejsme jistí, napíšeme to. Na webu, který má pomáhat proti falšování identity strojů, by <b>předstíraná přesnost</b> byla to nejhorší.</span></li>
          <li><span>Hotovo je <b>{hotovo} z {encyklopedie.length}</b> stránek. Zbytek postupně přibývá.</span></li>
        </ol>
      </div>

      {skupiny.map((g) => {
        const strany = encyklopedie.filter((s) => s.skupina === g.klic);
        if (strany.length === 0) return null;
        return (
          <>
            <p class="hubgrp">{g.nazev} — {g.popis}</p>
            <div class="hublist">
              {strany.map((s) =>
                s.hotovo ? (
                  <a class="hubrow" href={s.href}>
                    <span>
                      <span class="tt">{s.titul}</span>
                      <span class="ds">{s.popis}</span>
                    </span>
                    <span class="fl">Číst &#8594;</span>
                  </a>
                ) : (
                  <div class="hubrow soon">
                    <span>
                      <span class="tt">{s.titul}</span>
                      <span class="ds">{s.popis}</span>
                    </span>
                    <span class="fl">Chystáme</span>
                  </div>
                )
              )}
            </div>
          </>
        );
      })}

      <div class="cta">
        <div>
          <span class="lb">Registr dochovaných strojů</span>
          <p>Encyklopedie stojí na datech od majitelů. Každý zapsaný stroj zpřesňuje datování podle výrobních čísel.</p>
        </div>
        <a href="/registr/pridat-stroj/">Přidat stroj</a>
      </div>

    </div>
  </div>
</Layout>
