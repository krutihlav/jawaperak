  <script is:inline>
  (function () {
    var R = {
      '11': [[1,1500,1946],[1500,15800,1947],[15800,34900,1948],[34900,53800,1949],
             [53800,73000,1950],[73000,84200,1951]],
      '12': [[1,900,1948],[900,4500,1949],[4500,10000,1950]],
      '18': [[1,8000,1950],[8000,14200,1951]]
    };
    function faze(t, n) {
      if (t !== '11') return '';
      if (n < 26000) return ' V té době nesla nádrž ještě logo FJ.';
      if (n < 53800) return ' V té době už se na nádrži objevuje logo Zbrojovky.';
      return ' V té době se na nádrži používalo prázdné kolečko.';
    }
    var inp = document.getElementById('sn');
    var btn = document.getElementById('go');
    if (!inp || !btn) return;

    function dat() {
      var raw = inp.value.trim().replace(/\s/g, '');
      var out = document.getElementById('out');
      var yr = document.getElementById('outYr');
      var lb = document.getElementById('outLb');
      var dsc = document.getElementById('outDsc');
      out.classList.add('show');
      out.classList.remove('err');

      var m = raw.match(/^(10|11|12|18)[-\s.]?0*(\d+)(?:[-\s.](\d{2}))?$/i);
      if (!m) {
        out.classList.add('err');
        lb.textContent = 'Nerozpoznáno';
        yr.textContent = 'Zkuste formát 11-12862';
        dsc.innerHTML = 'Číslo musí začínat typem <b>10</b>, <b>11</b>, <b>12</b> nebo <b>18</b>. ' +
          'U strojů od roku 1952 připojte i dvojčíslí roku na konci.';
        return;
      }
      var t = m[1] === '10' ? '11' : m[1];
      var n = parseInt(m[2], 10);
      var suf = m[3];

      if (suf) {
        var y = parseInt(suf, 10);
        y = y < 40 ? 2000 + y : 1900 + y;
        lb.textContent = 'Rok výroby — jednoznačně';
        yr.textContent = y;
        dsc.innerHTML = 'Od 1. ledna 1952 je rok součástí výrobního čísla, takže tady se nic ' +
          'neodhaduje. Pořadové číslo <b>' + n + '</b> je pořadí v rámci roku ' + y + ', ne celkové.';
        return;
      }

      var rng = R[t] || [];
      var hit = null;
      for (var i = 0; i < rng.length; i++) {
        if (n >= rng[i][0] && n < rng[i][1]) { hit = rng[i]; break; }
      }
      if (!hit) {
        out.classList.add('err');
        lb.textContent = 'Mimo doložený rozsah';
        yr.textContent = 'Číslo nesedí do žádného ročníku';
        dsc.innerHTML = 'Typ <b>' + t + '</b> máme doložený zhruba do čísla ' +
          rng[rng.length - 1][1].toLocaleString('cs') + '. Vyšší čísla bez dvojčíslí roku na konci ' +
          'neznáme — může jít o překlep, o přeraženou ražbu, nebo o stroj, který nám v datech chybí. ' +
          '<a href="/registr/pridat-stroj/">Zapište ho do registru</a> a doplníme ho do tabulky.';
        return;
      }
      lb.textContent = 'Odhadovaný rok výroby';
      yr.textContent = hit[2];
      var okraj = (n - hit[0] < 2000) || (hit[1] - n < 2000);
      dsc.innerHTML = 'Typ <b>' + t + '</b>, číslo <b>' + n.toLocaleString('cs') + '</b> spadá do rozsahu ' +
        'roku <b>' + hit[2] + '</b>.' + faze(t, n) +
        (okraj
          ? ' <b>Pozor — číslo leží blízko hranice ročníku.</b> Hranice jsou rozmazané v pásmu ' +
            'několika tisíc kusů, takže stroj může být i o rok jinde.'
          : ' Berte to jako vodítko s tolerancí, ne jako přesný převodník.');
    }
    btn.addEventListener('click', dat);
    inp.addEventListener('keydown', function (e) { if (e.key === 'Enter') dat(); });
  })();
  </script>
