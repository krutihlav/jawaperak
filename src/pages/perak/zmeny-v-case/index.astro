---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import RejstrikEncyklopedie from '../../../components/RejstrikEncyklopedie.astro';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const H = { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` };

async function nacti(cesta) {
  const r = await fetch(`${SUPABASE_URL}/rest/v1/${cesta}`, { headers: H });
  return r.ok ? r.json() : [];
}

// Celá tabulka změn se načte na serveru a vloží do stránky jako JSON.
// Filtrování pak běží v prohlížeči, takže zadání čísla je okamžité
// a nejde na server žádný další dotaz. Anon klíč se do prohlížeče neposílá.
const zmeny = await nacti(
  'zmeny_dilu?select=dil,typ,poradi,popis_zmeny,vyrobni_cislo_od,rok_od,zdroj,jistota,poznamka&order=dil,typ,poradi'
);

const pocetZaznamu = zmeny.length;
const pocetDilu = new Set(zmeny.map((z) => z.dil)).size;
---

<Layout
  title="Co má mít můj stroj — vyhodnocení podle výrobního čísla | jawaperak.cz"
  description="Zadejte výrobní číslo Péráka a nástroj z databáze doložených změn složí seznam dílů, které k němu podle pramenů patří. Včetně toho, jak jisté které zařazení je."
>
  <div class="wrap wrap--art">
    <div class="page">

      <aside class="aside">
        <div class="aside-in">
          <p class="aside-lb">Na této stránce</p>
          <ol id="toc">
            <li><a href="#nastroj">Nástroj</a></li>
            <li><a href="#jak">Jak to počítá</a></li>
            <li><a href="#neni">Co to neříká</a></li>
            <li><a href="#data">Odkud data jsou</a></li>
          </ol>
          <div class="aside-foot">
            <p class="t">Značení jistoty</p>
            <div class="row"><span class="stamp kn">kniha</span></div>
            <div class="row"><span class="stamp ov">ověřeno</span></div>
            <div class="row"><span class="stamp od">odhad</span></div>
            <div class="row"><span class="stamp sp">sporné</span></div>
          </div>
        </div>
      </aside>

      <article class="art">

        <details class="mtoc">
          <summary><span>Obsah stránky — <span class="cur" id="curSec">Nástroj</span></span></summary>
          <ol>
            <li><a href="#nastroj">Nástroj</a></li>
            <li><a href="#jak">Jak to počítá</a></li>
            <li><a href="#neni">Co to neříká</a></li>
            <li><a href="#data">Odkud data jsou</a></li>
          </ol>
        </details>

        <p class="kicker"><a href="/perak/">Encyklopedie</a> — Identifikace a data</p>
        <h1>Co má mít můj stroj</h1>
        <p class="lead">
          Zadejte výrobní číslo a nástroj vám z databáze doložených změn složí
          seznam dílů, které k tomu číslu podle pramenů patří. U každého dílu
          zároveň řekne, jak jistá ta informace je.
        </p>

        <div class="meta">
          <span>Aktualizováno <b>8. 8. 2026</b></span>
          <span>Záznamů v databázi <b>{pocetZaznamu}</b></span>
          <span>Sledovaných dílů <b>{pocetDilu}</b></span>
        </div>

        <section class="sec" id="nastroj">
          <div class="sec-h">
            <span class="sec-n">01</span>
            <h2>Nástroj</h2>
            <p class="sub">Zadejte číslo z výrobního štítku nebo z ražby v rámu. Funguje pro typy 10, 11, 12 i 18.</p>
          </div>

          <div class="zvc-tool">
            <label class="zvc-lbl" for="zvc-vc">Výrobní číslo stroje</label>
            <div class="zvc-inrow">
              <input type="text" id="zvc-vc" placeholder="např. 11-34567 nebo 11-07390-52" autocomplete="off" spellcheck="false">
              <button type="button" class="zvc-go" id="zvc-go">Vyhodnotit</button>
            </div>
            <div class="zvc-ex">
              Vyzkoušet:
              <button type="button" data-ex="11-1200">11-1200</button>
              <button type="button" data-ex="11-34567">11-34567</button>
              <button type="button" data-ex="11-70000">11-70000</button>
              <button type="button" data-ex="11-07390-52">11-07390-52</button>
              <button type="button" data-ex="12-4200">12-4200</button>
              <button type="button" data-ex="18-8392">18-8392</button>
            </div>
          </div>

          <div id="zvc-out"></div>
        </section>

        <section class="sec" id="jak">
          <div class="sec-h">
            <span class="sec-n">02</span>
            <h2>Jak to počítá</h2>
            <p class="sub">Aby výsledku šlo věřit, je dobré vědět, na čem stojí.</p>
          </div>

          <p>
            U každého dílu máme v databázi řadu provedení, jak šla za sebou.
            U některých změn víme <strong>přesné výrobní číslo</strong>, od kterého
            platí. U jiných víme jen rok. Nástroj proto pracuje ve dvou režimech
            a vždy říká, který z nich právě použil.
          </p>

          <div class="box box--fact">
            <span class="lb">Když známe výrobní číslo</span>
            <p>
              Nástroj prostě porovná vaše číslo s tím v databázi. Výsledek je
              spolehlivý — třeba u brzdových bubnů, kde víme, že se od
              <span class="sn">11-61551</span> zvětšily ze 150 na 160 mm.
            </p>
          </div>

          <div class="box box--warn">
            <span class="lb">Když známe jen rok</span>
            <p>
              Pak si nástroj musí rok vašeho stroje nejdřív odhadnout z výrobního
              čísla. Ten odhad má chybu — <b>klidně rok na obě strany</b>. Takové
              díly poznáte podle toho, že karta má <b>přerušovaný okraj</b>. Berte
              je jako vodítko, ne jako jistotu.
            </p>
          </div>

          <p>
            Trochu potíží dělá číslování. Do konce roku 1951 běžela jedna
            průběžná řada, takže vyšší číslo znamená pozdější stroj. Od 1. ledna
            1952 se ale začalo <strong>každý rok počítat znovu od jedničky</strong>
            a rok se přidal na konec čísla. Stroj <span class="sn">11-00096-52</span>
            je proto novější než <span class="sn">11-84109</span>, i když má
            mnohem nižší číslo. Nástroj s tím počítá.
          </p>

          <div class="rel">
            <span class="t">Souvisí</span>
            <a href="/perak/identifikace/">Kde má Pérák čísla</a>
            <a href="/perak/250/">Pérák 250 — typ 10 a 11</a>
            <a href="/perak/350/">Pérák 350 — typ 12 a 18</a>
          </div>
        </section>

        <section class="sec" id="neni">
          <div class="sec-h">
            <span class="sec-n">03</span>
            <h2>Co to neříká</h2>
            <p class="sub">Tohle je nejdůležitější sekce na stránce. Přečtěte si ji dřív, než podle výpisu začnete něco tvrdit.</p>
          </div>

          <p>
            Nástroj vám řekne, co stroj <strong>nejspíš dostal z výroby</strong>.
            Neřekne vám, co na něm dnes musí být. To jsou dvě různé věci a plete
            si je spousta lidí.
          </p>

          <div class="box box--warn">
            <span class="lb">Proč se neshoda běžně stává</span>
            <ul>
              <li>Díly se ve fabrice kombinovaly podle toho, co bylo zrovna na skladě. Změny se nezaváděly ze dne na den.</li>
              <li>Spousta dílů se za sedmdesát let vyměnila úplně legitimně — protože dosloužily.</li>
              <li>Některé výměny se dělaly už tehdy a doporučovaly se. Třeba čtyřpólové dynamo se běžně nahrazovalo šestipólovým.</li>
              <li>Většina údajů v databázi má razítko <span class="stamp od">odhad</span>, protože pochází z pozorování konkrétních strojů, ne z továrních záznamů.</li>
            </ul>
          </div>

          <p>
            <strong>Neshoda sama o sobě není důkaz podvodu.</strong> Když ale
            nesedí víc věcí najednou, a zvlášť když nesedí rám, motor a štítek
            mezi sebou, stojí za to se ptát dál. Rozhodující jsou vždycky ražby
            a doklady, ne tenhle výpis.
          </p>
        </section>

        <section class="sec" id="data">
          <div class="sec-h">
            <span class="sec-n">04</span>
            <h2>Odkud data jsou</h2>
            <p class="sub">Databáze se plní ručně a průběžně roste. Každý záznam má uvedený pramen.</p>
          </div>

          <p>
            Momentálně je v databázi <strong>{pocetZaznamu} záznamů</strong>
            u <strong>{pocetDilu} různých dílů</strong>. Nejvíc jich máme u
            dvěstěpadesátky, protože se vyráběla nejdéle a je nejlíp zdokumentovaná.
          </p>

          <p>
            Razítko u každého dílu se odvozuje přímo z pramene. Když záznam pochází
            z knihy, dostane <span class="stamp kn">kniha</span>. Když se na něm
            shodly dva nezávislé prameny, dostane <span class="stamp ov">ověřeno</span>.
            Když stojí na jednom pozorování, je to <span class="stamp od">odhad</span>.
            A když si prameny odporují, je to <span class="stamp sp">sporné</span>
            a my to rovnou přiznáme.
          </p>

          <div class="box box--fact">
            <span class="lb">Máte doplněk nebo opravu?</span>
            <p>
              Databáze roste hlavně z toho, co lidi pošlou. Pokud u svého stroje
              víte o změně, kterou tu nemáme — a hlavně pokud k ní znáte výrobní
              číslo — ozvěte se. Přesná čísla jsou to nejcennější, co k tématu
              existuje, a shánějí se nejhůř.
            </p>
          </div>
        </section>

        <div class="cta">
          <div>
            <span class="lb">Nejste si jistí</span>
            <p>Projdeme stroj před koupí, zkontrolujeme čísla a řekneme, co vás čeká.</p>
          </div>
          <a href="/sluzby/prohlidka-pred-koupi/">Prohlídka před koupí</a>
        </div>

        <footer class="src">
          <h2>Zdroje</h2>
          <ol>
            <li>
              Vlastní databáze konstrukčních změn — {pocetZaznamu} záznamů,
              každý s uvedeným pramenem a mírou jistoty.
            </li>
            <li>
              Procházka, Hubert: <cite>Jawa 250/350 Pérák: historie, vývoj, technika, sport</cite>.
              Grada, 2009. <span class="stamp kn">kniha</span>
            </li>
            <li>
              Odhad roku podle výrobního čísla — odvozeno z fotografií dochovaných
              výrobních štítků. <span class="stamp od">odhad</span>
            </li>
          </ol>
        </footer>

        <RejstrikEncyklopedie aktualni="/perak/zmeny-v-case/" />

      </article>
    </div>
  </div>

  <script type="application/json" id="zvc-data" set:html={JSON.stringify(zmeny)}></script>
</Layout>

<style is:global>
