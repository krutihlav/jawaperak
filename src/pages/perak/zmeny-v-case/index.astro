</style>

<script>
  const el = document.getElementById('zvc-data');
  const DATA = el ? JSON.parse(el.textContent || '[]') : [];

  const UZLY = {
    'motor':'Motor','motor - klikové ústrojí':'Motor','výfuky':'Motor',
    'řetězy':'Motor','palivový kohout':'Motor',
    'rám':'Podvozek','rám a přední vidlice':'Podvozek','přední vidlice':'Podvozek',
    'podkova přední vidlice':'Podvozek','přední kluzáky':'Podvozek',
    'brýle a tlumič řízení':'Podvozek','brzdové bubny':'Podvozek','kola':'Podvozek',
    'stojan':'Podvozek','řídítka':'Podvozek','přední blatník':'Podvozek',
    'zadní blatník a nosič':'Podvozek',
    'elektroinstalace - dynamo':'Elektrika','kontaktnice':'Elektrika',
    'maska reflektoru':'Elektrika','přepínač světel':'Elektrika',
    'spínací skříňka':'Elektrika','tachometr':'Elektrika','zadní světlo':'Elektrika',
    'schránky':'Elektrika','kastlíky':'Elektrika',
    'nádrž':'Nádrž a značení','typové označení':'Nádrž a značení'
  };
  const PORADI = ['Motor','Podvozek','Elektrika','Nádrž a značení','Ostatní'];

  // Odhad roku podle výrobního čísla — odvozeno z fotografií štítků.
  const ROKY = {
    '11':[[1946,1,1500],[1947,1501,15800],[1948,15801,34900],[1949,34901,53800],[1950,53801,73000],[1951,73001,90000]],
    '12':[[1948,1,900],[1949,901,4500],[1950,4501,10000]],
    '18':[[1950,1,8000],[1951,8001,14200]]
  };

  function parseVC(raw){
    if(!raw) return null;
    const s = String(raw).trim().toUpperCase().replace(/\s+/g,'');
    const m = s.match(/^(10|11|12|18)[-\/]?0*(\d{1,6})(?:[-\/](\d{2}))?$/);
    if(!m) return null;
    const typ = m[1]==='10' ? '11' : m[1];
    const cislo = parseInt(m[2],10);
    const rocnik = m[3] ? 1900+parseInt(m[3],10) : null;
    if(rocnik && (rocnik<1952 || rocnik>1955)) return {chyba:'rocnik'};
    return {typ, cislo, rocnik, bylo10:m[1]==='10'};
  }

  // klíč pro porovnání: [režim, rok, číslo]; režim 0 = průběžná řada, 1 = roční
  function klic(typ, cislo, rocnik){
    if(rocnik) return [1, rocnik, cislo];
    const tab = ROKY[typ] || [];
    let rok = tab.length ? tab[tab.length-1][0] : 0;
    for(const p of tab){ if(cislo>=p[1] && cislo<=p[2]){ rok=p[0]; break; } }
    return [0, rok, cislo];
  }
  function porovnej(a,b){
    if(a[0]!==b[0]) return a[0]-b[0];
    if(a[0]===1 && a[1]!==b[1]) return a[1]-b[1];
    return a[2]-b[2];
  }
  function odhadRoku(typ,cislo,rocnik){
    if(rocnik) return {rok:rocnik, presny:true};
    const tab = ROKY[typ] || [];
    for(const p of tab){ if(cislo>=p[1] && cislo<=p[2]) return {rok:p[0], presny:false}; }
    return {rok:null, presny:false};
  }

  function vyhodnot(p){
    const mujKlic = klic(p.typ, p.cislo, p.rocnik);
    const odh = odhadRoku(p.typ, p.cislo, p.rocnik);
    const mujRok = odh.rok;

    const podleDilu = {};
    DATA.filter(z => String(z.typ) === p.typ).forEach(z => {
      (podleDilu[z.dil] = podleDilu[z.dil] || []).push(z);
    });

    const vysledek = [];
    Object.keys(podleDilu).forEach(dil => {
      const rada = podleDilu[dil].slice().sort((a,b) => (a.poradi||0)-(b.poradi||0));
      let aktivni = -1, jistota = 'zadna', matchlo = false;

      rada.forEach((z,i) => {
        let plati = false, jak = null;
        if(z.vyrobni_cislo_od){
          const pk = parseVC(z.vyrobni_cislo_od);
          if(pk && !pk.chyba){
            plati = porovnej(mujKlic, klic(pk.typ, pk.cislo, pk.rocnik)) >= 0;
            jak = 'cislo';
          }
        }
        if(!plati && !jak && z.rok_od && mujRok){
          plati = mujRok >= z.rok_od;
          jak = 'rok';
        }
        if(!plati && !jak && i===0) plati = true;   // výchozí provedení
        if(plati){ aktivni = i; jistota = jak || 'zadna'; if(jak) matchlo = true; }
      });

      if(aktivni < 0) aktivni = 0;
      // Když se nic nechytlo a provedení je víc, nedokážeme rozhodnout.
      const neurcite = !matchlo && rada.length > 1;
      vysledek.push({dil, rada, aktivni, jistota, neurcite, uzel: UZLY[dil] || 'Ostatní'});
    });

    return {vysledek, odh};
  }

  function razitko(z){
    if(/Procházka/i.test(z.zdroj || '')) return '<span class="stamp kn">kniha</span>';
    if(z.jistota === 'overeno') return '<span class="stamp ov">ověřeno</span>';
    if(z.jistota === 'nejiste') return '<span class="stamp sp">sporné</span>';
    return '<span class="stamp od">odhad</span>';
  }
  function esc(s){
    return String(s == null ? '' : s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  }
  function sklonuj(n, a, b, c){ return n===1 ? a : (n<5 ? b : c); }

  function vykresli(raw){
    const out = document.getElementById('zvc-out');
    if(!out) return;
    const p = parseVC(raw);

    if(!p){
      out.innerHTML = '<div class="zvc-err"><b>Tohle číslo neumíme přečíst.</b> ' +
        'Čekáme tvar <span class="num">11-34567</span> u strojů z let 1946 až 1951, ' +
        'nebo <span class="num">11-07390-52</span> u strojů z let 1952 až 1954. ' +
        'Na začátku může být 10, 11, 12 nebo 18.</div>';
      return;
    }
    if(p.chyba === 'rocnik'){
      out.innerHTML = '<div class="zvc-err"><b>Rok na konci čísla nedává smysl.</b> ' +
        'Roční řady se používaly jen v letech 1952 až 1955.</div>';
      return;
    }

    const {vysledek, odh} = vyhodnot(p);
    const nazev = p.typ === '11' ? 'Jawa 250, typ 10 nebo 11'
                : p.typ === '12' ? 'Jawa-Ogar 350, typ 12'
                : 'Jawa 350, typ 18';
    const kubatura = p.typ === '11' ? '250 ccm' : '350 ccm';

    let h = '';

    h += '<div class="zvc-read"><p class="zvc-t">Co jsme z čísla poznali</p><div class="zvc-facts">';
    h += '<div><span class="k">Typ</span><span class="v">' + esc(nazev) + '</span></div>';
    h += '<div><span class="k">Kubatura</span><span class="v">' + kubatura + '</span></div>';
    if(odh.rok){
      h += '<div><span class="k">Rok výroby</span><span class="v">' + odh.rok +
           '<small>' + (odh.presny ? 'čte se přímo z čísla' : 'odhad podle čísla') + '</small></span></div>';
    } else {
      h += '<div><span class="k">Rok výroby</span><span class="v">nevíme<small>číslo je mimo doložený rozsah</small></span></div>';
    }
    h += '<div><span class="k">Číslování</span><span class="v">' +
         (p.rocnik ? 'roční řada' : 'průběžná řada') + '</span></div>';
    h += '</div></div>';

    if(p.rocnik){
      h += '<div class="zvc-note">Od roku 1952 je rok součástí výrobního čísla, takže ' +
           '<b>rok výroby známe přesně</b>. Zařazení jednotlivých dílů je i tak jen ' +
           'pravděpodobné — proč, píšeme pod výpisem.</div>';
    } else {
      h += '<div class="zvc-note">Rok jsme <b>odhadli z výrobního čísla</b>, není to údaj ze štítku. ' +
           'Hranice mezi ročníky jsou rozmazané, protože rok na štítku nemusel být rokem, ' +
           'kdy vznikl rám. <b>Počítejte s odchylkou klidně rok na obě strany.</b></div>';
    }
    if(p.bylo10){
      h += '<div class="zvc-note">Zadali jste číslo začínající <span class="num">10-</span>. ' +
           'Výrobní čísla ale začínala <b>11- od úplného začátku výroby</b>, bez ohledu na to, ' +
           'jaké typové označení stroj tehdy nesl. Počítali jsme s typem 11.</div>';
    }

    const skupiny = {};
    vysledek.forEach(v => { (skupiny[v.uzel] = skupiny[v.uzel] || []).push(v); });

    let celkem = 0, podleCisla = 0;
    vysledek.forEach(v => { celkem++; if(v.jistota === 'cislo') podleCisla++; });

    PORADI.forEach(uzel => {
      const g = skupiny[uzel];
      if(!g || !g.length) return;
      g.sort((a,b) => a.dil.localeCompare(b.dil,'cs'));
      h += '<div class="zvc-grp"><h3>' + esc(uzel) + '<span>' + g.length + ' ' +
           sklonuj(g.length,'díl','díly','dílů') + '</span></h3>';

      g.forEach(v => {
        const z = v.rada[v.aktivni];
        const mekke = v.jistota !== 'cislo';
        h += '<div class="zvc-card' + (mekke ? ' soft' : '') + '">';
        h += '<p class="zvc-dil">' + esc(v.dil) + '</p>';

        if(v.neurcite){
          h += '<p class="zvc-now"><b>Tady vám neporadíme.</b> U tohoto dílu známe víc provedení, ' +
               'ale nevíme, od kterého čísla ani roku se která zaváděla. Rozbalte si celou řadu ' +
               'a porovnejte sami.</p>';
        } else {
          h += '<p class="zvc-now">' + esc(z.popis_zmeny) + '</p>';
          h += '<div class="zvc-m">' + razitko(z);
          h += '<span>' + (v.jistota === 'cislo' ? 'určeno podle výrobního čísla'
                        : v.jistota === 'rok' ? 'určeno jen podle roku, takže méně jistě'
                        : 'první známé provedení') + '</span>';
          if(z.vyrobni_cislo_od) h += '<span>platí od <span class="num">' + esc(z.vyrobni_cislo_od) + '</span></span>';
          h += '</div>';
          if(z.poznamka) h += '<div class="zvc-m"><span>' + esc(z.poznamka) + '</span></div>';
        }

        if(v.rada.length > 1){
          h += '<details class="zvc-hist"><summary>Všechna provedení (' + v.rada.length + ')</summary><ol>';
          v.rada.forEach((r,i) => {
            const od = r.vyrobni_cislo_od ? ' <span class="num">od ' + esc(r.vyrobni_cislo_od) + '</span>'
                     : (r.rok_od ? ' <span class="num">od ' + r.rok_od + '</span>' : '');
            h += '<li class="' + (!v.neurcite && i === v.aktivni ? 'is' : '') + '">' +
                 esc(r.popis_zmeny) + od + '</li>';
          });
          h += '</ol></details>';
        }
        h += '</div>';
      });
      h += '</div>';
    });

    if(!celkem){
      h += '<div class="zvc-err"><b>K tomuhle typu zatím v databázi nic nemáme.</b></div>';
      out.innerHTML = h;
      return;
    }

    h += '<div class="zvc-close"><p class="zvc-t">Jak to číst</p>';
    h += '<p>Prošli jsme <b>' + celkem + ' ' + sklonuj(celkem,'díl','díly','dílů') + '</b>. ' +
         'U <b>' + podleCisla + '</b> z nich se dá zařazení opřít o konkrétní výrobní číslo, ' +
         'takže tomu jde věřit. U zbytku známe jen rok, a ten jsme museli odhadnout — ' +
         'proto mají karty přerušovaný okraj.</p>';
    h += '<p>Výpis říká, co stroj <b>nejspíš dostal z výroby</b>. Neříká, co na něm dnes musí být. ' +
         'Díly se ve fabrice kombinovaly podle skladu a za sedmdesát let se spousta z nich ' +
         'legitimně vyměnila. <b>Když něco nesedí, ještě to neznamená podvod.</b></p>';
    h += '<p>Rozhodují vždycky ražby a doklady, ne tenhle výpis.</p></div>';

    out.innerHTML = h;
  }

  const inp = document.getElementById('zvc-vc');
  const btn = document.getElementById('zvc-go');
  if(btn && inp){
    btn.addEventListener('click', () => vykresli(inp.value));
    inp.addEventListener('keydown', e => { if(e.key === 'Enter'){ e.preventDefault(); vykresli(inp.value); } });
  }
  document.querySelectorAll('.zvc-ex button').forEach(b => {
    b.addEventListener('click', () => {
      if(inp) inp.value = b.dataset.ex;
      vykresli(b.dataset.ex);
    });
  });
</script>
