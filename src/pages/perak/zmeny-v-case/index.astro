.zvc-inrow input{flex:1 1 240px;min-width:0;font:500 22px/1 Oswald,sans-serif;letter-spacing:.05em;padding:13px 14px;border:1px solid var(--ink,#241f18);background:rgba(255,255,255,.35);color:inherit}
