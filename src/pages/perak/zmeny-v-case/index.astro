.zvc-ex button:hover{border-color:var(--red,#A81C21);color:var(--red,#A81C21)}

.zvc-read{border:1px solid var(--ink,#241f18);border-top:4px solid var(--red,#A81C21);padding:17px 19px;margin:0 0 8px;background:rgba(0,0,0,.03)}
.zvc-read .zvc-t{font:500 11.5px/1 Oswald,sans-serif;text-transform:uppercase;letter-spacing:.16em;color:var(--red,#A81C21);margin:0 0 12px}
