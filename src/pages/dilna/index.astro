---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/dilna.json';
---

<Layout title={data.seoTitle} description={data.seoDescription}>
  <div class="wrap">
    <article class="art">

      <p class="kicker">{data.kicker}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.lead}</p>

      {data.sections.map((s, i) => (
        <section class="sec" id={s.id}>
          <div class="sec-h">
            <span class="sec-n">{String(i + 1).padStart(2, '0')}</span>
            <h2>{s.title}</h2>
            <p class="sub">{s.sub}</p>
          </div>
          <Fragment set:html={s.body} />
        </section>
      ))}

      <div class="box box--dilna">
        <span class="lb">{data.outro.label}</span>
        <Fragment set:html={data.outro.body} />
      </div>

    </article>
  </div>
</Layout>
