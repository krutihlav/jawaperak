---
import Layout from '../layouts/Layout.astro';
import RejstrikEncyklopedie from '../components/RejstrikEncyklopedie.astro';
import data from '../data/historie.json';

const stampLabel: Record<string, string> = {
  kn: 'kniha',
  ov: 'ověřeno',
  od: 'odhad',
  sp: 'sporné',
};
---

<Layout title={data.seoTitle} description={data.seoDescription}>
  <div class="wrap wrap--art">
    <div class="page">

      <aside class="aside">
        <div class="aside-in">
          <p class="aside-lb">Na této stránce</p>
          <ol id="toc">
            {data.sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
          </ol>
          <div class="aside-foot">
            <p class="t">Značení jistoty</p>
            <div class="row"><span class="stamp kn">kniha</span></div>
            <div class="row"><span class="stamp ov">ověřeno</span></div>
            <div class="row"><span class="stamp od">odhad</span></div>
            <div class="row"><span class="stamp sp">sporné</span></div>
          </div>
        </div>
      </aside>

      <article class="art">

        <details class="mtoc">
          <summary><span>Obsah stránky — <span class="cur" id="curSec">{data.sections[0].title}</span></span></summary>
          <ol>
            {data.sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
          </ol>
        </details>

        <p class="kicker"><a href={data.kickerHref}>{data.kicker}</a> — {data.kickerLabel}</p>
        <h1>{data.title}</h1>
        <p class="lead">{data.lead}</p>

        <div class="meta">
          {data.meta.map((m) => <span>{m.label} <b>{m.value}</b></span>)}
        </div>

        <div class="tldr">
          <h2>Co se tu dozvíte</h2>
          <ol>
            {data.tldr.map((t) => <li><span>{t}</span></li>)}
          </ol>
        </div>

        {data.sections.map((s, i) => (
          <section class="sec" id={s.id}>
            <div class="sec-h">
              <span class="sec-n">{String(i + 1).padStart(2, '0')}</span>
              <h2>{s.title}</h2>
              <p class="sub">{s.sub}</p>
            </div>
            <Fragment set:html={s.body} />
          </section>
        ))}

        <footer class="src">
          <h2>Zdroje</h2>
          <ol>
            {data.sources.map((s) => (
              <li>
                <Fragment set:html={s.text} /> <span class={`stamp ${s.stamp}`}>{stampLabel[s.stamp]}</span>
              </li>
            ))}
          </ol>
        </footer>

        <RejstrikEncyklopedie aktualni="/historie/" />

      </article>
    </div>
  </div>
</Layout>
