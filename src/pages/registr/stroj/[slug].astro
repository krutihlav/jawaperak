---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';

const SUPABASE_URL = 'https://hcszrmqtwnkzlbrecrey.supabase.co';
const SUPABASE_KEY = 'sb_publishable_EJ3eN_tBhUDWt7dbQcYCwg_asAVeZDE';
const H = { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` };

const { slug } = Astro.params;

async function nacti(cesta) {
  const r = await fetch(`${SUPABASE_URL}/rest/v1/${cesta}`, { headers: H });
  return r.ok ? r.json() : [];
}

const [strojeRadky, ciselnikTyp, ciselnikStav, ciselnikFaze] = await Promise.all([
  nacti(`stroje_verejne?slug=eq.${encodeURIComponent(slug)}&select=*&limit=1`),
  nacti('ciselnik_typ?select=*'),
  nacti('ciselnik_stav?select=*'),
  nacti('ciselnik_faze?select=*'),
]);

const stroj = strojeRadky[0] ?? null;
if (!stroj) Astro.response.status = 404;

const fotky = stroj
  ? await nacti(`stroje_fotky?stroj_id=eq.${stroj.id}&select=*&order=poradi`)
  : [];

const radekTyp = stroj ? ciselnikTyp.find((t) => t.hodnota === stroj.typ) : null;

function popis(seznam, hodnota) {
  const r = seznam.find((x) => x.hodnota === hodnota);
  return r ? r.popis_cs : (hodnota ?? '—');
}

// "Jiné záznamy" — volný dodatek jako na dobovém TP
const jineZaznamy = stroj
  ? [
      stroj.vyrobni_faze ? popis(ciselnikFaze, stroj.vyrobni_faze) : null,
      popis(ciselnikStav, stroj.stav),
      stroj.na_prodej ? 'nabízen k prodeji' : null,
    ].filter(Boolean).join(' · ')
  : '';

const znackaTyp = stroj
  ? `Jawa ${radekTyp?.objem_ccm && radekTyp.objem_ccm > 300 ? '350' : '250'}, typ ${stroj.typ}`
  : '';

const datumZapisu = stroj?.schvaleno_at
  ? new Date(stroj.schvaleno_at).toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' })
  : '—';

const titulek = stroj
  ? `${znackaTyp}${stroj.rok_vyroby ? ' (' + stroj.rok_vyroby + ')' : ''} — registr Péráků | jawaperak.cz`
  : 'Stroj nenalezen | jawaperak.cz';

const popisStranky = stroj
  ? (stroj.pribeh ? stroj.pribeh.slice(0, 160) : `Záznam v registru dochovaných strojů Jawa Pérák, ${znackaTyp}.`)
  : 'Tento záznam v registru jsme nenašli.';

const jePribehEn = !!stroj?.pribeh_en;
---

<Layout title={titulek} description={popisStranky}>
  <div class="wrap">
    <article class="art">

      {!stroj && (
        <>
          <p class="kicker">Registr</p>
          <h1>Stroj nenalezen</h1>
          <p class="lead">Záznam s tímto odkazem neexistuje, nebo ještě čeká na schválení.</p>
          <p class="zpet"><a href="/registr/">← Zpět do registru</a></p>
        </>
      )}

      {stroj && (
        <>
          <div class="hlava">
            <div>
              <p class="kicker">Registr</p>
              <h1>{znackaTyp}{stroj.rok_vyroby ? <> <span class="rok">{stroj.rok_vyroby}</span></> : null}</h1>
            </div>
            <div class="langbar">
              <button type="button" class="lb-btn is-on" data-lang="cs">Česky</button>
              <button type="button" class="lb-btn" data-lang="en">English</button>
            </div>
          </div>

          <div class="tp" role="img" aria-label={`Záznam stroje ${znackaTyp} ve stylu dobového technického průkazu`}>
            <div class="tp__str tp__str--l">
              <p class="tp__nadpis" data-i18n="tuNadpis">Technické údaje</p>
              <table class="tpt">
                <tbody>
                  <tr>
                    <td class="lb"><span data-i18n="lDruh">Druh<br>vozidla</span></td>
                    <td colspan="2" class="c"><span class="ruka">motocykl</span></td>
                    <td colspan="2" class="c">
                      <span class="ruka">{stroj.rok_vyroby ?? '—'}</span>
                      <i data-i18n="lRok">rok výroby</i>
                    </td>
                    <td colspan="2" class="c">
                      <span class="ruka">{stroj.barva ?? '—'}</span>
                      <i data-i18n="lBarva">barva</i>
                    </td>
                  </tr>
                  <tr>
                    <td class="lb"><span data-i18n="lTovarni">Tovární <b>(F)</b><br>zn. a typ</span></td>
                    <td colspan="6" class="v"><span class="ruka ruka--vel">{znackaTyp}</span></td>
                  </tr>
                  <tr>
                    <td class="lb"><span data-i18n="lVyrC">Výrobní <b>(G)</b><br>číslo</span></td>
                    <td colspan="3" class="c">
                      <span class="ruka">{stroj.cislo_ramu_maskovane ?? '—'}</span>
                      <i data-i18n="lPodvozku">podvozku</i>
                    </td>
                    <td colspan="3" class="c">
                      <span class="ruka">{stroj.cislo_motoru_maskovane ?? '—'}</span>
                      <i data-i18n="lMotoru">motoru</i>
                    </td>
                  </tr>
                  <tr>
                    <td class="lb"><span data-i18n="lHmot">Hmotnost</span></td>
                    <td colspan="3" class="c">
                      <span class="ruka">{radekTyp?.hmotnost_kg ?? '—'}</span>
                      <i data-i18n="lSucha">suchá, kg</i>
                    </td>
                    <td colspan="3" class="c">
                      <span class="ruka">{radekTyp?.objem_ccm ?? '—'}</span>
                      <i data-i18n="lObjem">objem, ccm</i>
                    </td>
                  </tr>
                  <tr>
                    <td class="lb"><span data-i18n="lMist">Počet<br>míst</span></td>
                    <td colspan="2" class="c">
                      <span class="ruka">{radekTyp?.pocet_mist ?? '—'}</span>
                      <i data-i18n="lSezeni">k sezení</i>
                    </td>
                    <td colspan="2" class="c"><span class="ruka">—</span><i data-i18n="lStani">k stání</i></td>
                    <td colspan="2" class="c"><span class="ruka">—</span><i data-i18n="lLuzek">lůžek</i></td>
                  </tr>
                  <tr>
                    <td class="lb lb--t"><span data-i18n="lJine">Jiné záznamy:</span></td>
                    <td colspan="6" class="v v--t"><span class="ruka ruka--mal">{jineZaznamy}</span></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="tp__str tp__str--r">
              <div class="spz">
                <span class="spz__lb">SPZ <b>(A)</b></span>
                <div class="spz__pole">
                  <span class="ruka spz__val">{stroj.spz_historicka ?? ''}</span>
                </div>
              </div>

              <table class="tpt tpt--r">
                <tbody>
                  <tr>
                    <td rowspan="2" class="lb lb--m"><span data-i18n="lDrzitel">Držitel</span></td>
                    <td class="kod kod--b0"><b>(C)</b></td>
                    <td class="v v--b0 v--p"><span class="skryto" data-i18n="lSkryto">skryto</span> <i data-i18n="lPrijmeni">příjmení</i></td>
                  </tr>
                  <tr>
                    <td class="kod kod--t0"><b>(D)</b></td>
                    <td class="v v--t0 v--p"><span class="skryto" data-i18n="lSkryto2">skryto</span> <i data-i18n="lJmeno">jméno</i></td>
                  </tr>
                  <tr>
                    <td class="lb"><span data-i18n="lBydliste">Bydliště</span></td>
                    <td class="kod"><b>(E)</b></td>
                    <td class="v"><span class="ruka ruka--mal">{[stroj.region, stroj.zeme].filter(Boolean).join(', ') || '—'}</span></td>
                  </tr>
                  <tr>
                    <td class="lb"><span data-i18n="lDatum">Datum</span></td>
                    <td class="kod"><b>(B)</b></td>
                    <td class="v"><span class="ruka ruka--mal">{datumZapisu}</span></td>
                  </tr>
                  <tr>
                    <td class="lb"><span data-i18n="lZapis">Zápis</span></td>
                    <td colspan="2" class="v v--razitko">
                      <span class="ruka ruka--mal">{stroj.renovoval ?? 'registr jawaperak.cz'}</span>
                    </td>
                  </tr>
                </tbody>
              </table>

              <svg class="razitko" viewBox="0 0 120 120" aria-hidden="true">
                <defs>
                  <filter id="inkr"><feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="5" seed="21"/><feDisplacementMap in="SourceGraphic" scale="3"/></filter>
                  <path id="rt" d="M 21,60 A 39,39 0 0 1 99,60" fill="none"/>
                  <path id="rb" d="M 101,63 A 41,41 0 0 1 19,63" fill="none"/>
                </defs>
                <g filter="url(#inkr)" opacity=".72">
                  <circle cx="60" cy="60" r="52" fill="none" stroke="#B3272C" stroke-width="3" stroke-dasharray="90 2 160 3 60 2"/>
                  <circle cx="60" cy="60" r="44" fill="none" stroke="#B3272C" stroke-width="1"/>
                  <text font-size="8.5" fill="#B3272C" font-family="Georgia,serif" font-weight="700" letter-spacing="1.9"><textPath href="#rt" startOffset="50%" text-anchor="middle">REGISTR DOCHOVANÝCH</textPath></text>
                  <text font-size="7.5" fill="#B3272C" font-family="Georgia,serif" letter-spacing="1.7"><textPath href="#rb" startOffset="50%" text-anchor="middle">JAWAPERAK.CZ</textPath></text>
                  <line x1="30" y1="52" x2="90" y2="52" stroke="#B3272C" stroke-width="1"/>
                  <text x="60" y="66" font-size="15" fill="#B3272C" font-family="Georgia,serif" font-weight="700" text-anchor="middle" letter-spacing="1">PÉRÁK</text>
                  <line x1="30" y1="72" x2="90" y2="72" stroke="#B3272C" stroke-width="1"/>
                  <text x="60" y="82" font-size="8" fill="#B3272C" font-family="Georgia,serif" text-anchor="middle">{stroj.schvaleno_at ? new Date(stroj.schvaleno_at).getFullYear() : ''}</text>
                </g>
              </svg>
            </div>
          </div>

          <p class="tp__pozn" data-i18n="poznZdroj">
            Hmotnost a objem jsou typové údaje z veřejných pramenů, ne měření
            konkrétního stroje. Výrobní čísla jsou záměrně zkrácená.
          </p>

          {fotky.length > 0 && (
            <div class="galerie">
              {fotky.map((f) => (
                <figure>
                  <img src={f.url} loading="lazy" alt={f.popisek || titulek} />
                  {(f.popisek || f.zdroj) && (
                    <figcaption>{f.popisek}{f.zdroj && ` — zdroj: ${f.zdroj}`}</figcaption>
                  )}
                </figure>
              ))}
            </div>
          )}

          {(stroj.pribeh || stroj.pribeh_en) && (
            <div class="pribeh">
              <h2 data-i18n="tPribeh">Příběh stroje</h2>
              {stroj.pribeh && <p class="pribeh-cs" set:html={stroj.pribeh.replace(/\n/g, '<br>')} />}
              {stroj.pribeh_en && <p class="pribeh-en" hidden set:html={stroj.pribeh_en.replace(/\n/g, '<br>')} />}
            </div>
          )}

          {stroj.lze_kontaktovat && (
            <div class="kontakt-cta">
              <p data-i18n="ctaText">Máte zájem o tento stroj nebo znáte jeho historii? Napište nám a spojíme vás s majitelem.</p>
              <a class="btn" href={`/kontakt/?stroj=${stroj.slug}`} data-i18n="ctaBtn">Kontaktovat přes formulář</a>
            </div>
          )}

          <p class="zpet"><a href="/registr/" data-i18n="zpet">← Zpět do registru</a></p>
        </>
      )}

    </article>
  </div>
</Layout>

<script define:vars={{ jePribehEn }}>
  const T = {
    en: {
      tuNadpis: 'Technical data', lDruh: 'Vehicle<br>type', lRok: 'year of manufacture', lBarva: 'colour',
      lTovarni: 'Make <b>(F)</b><br>and model', lVyrC: 'Serial <b>(G)</b><br>number',
      lPodvozku: 'frame', lMotoru: 'engine', lHmot: 'Weight', lSucha: 'dry, kg', lObjem: 'capacity, cc',
      lMist: 'Seating', lSezeni: 'seats', lStani: 'standing', lLuzek: 'berths', lJine: 'Other records:',
      lDrzitel: 'Keeper', lSkryto: 'hidden', lSkryto2: 'hidden', lPrijmeni: 'surname', lJmeno: 'first name',
      lBydliste: 'Address', lDatum: 'Date', lZapis: 'Entry', tPribeh: "Machine's story",
      poznZdroj: 'Weight and capacity are model figures from public sources, not measurements of this machine. Serial numbers are deliberately shortened.',
      ctaText: 'Interested in this machine, or do you know its history? Write to us and we will put you in touch with the owner.',
      ctaBtn: 'Contact via form', zpet: '← Back to the registry'
    }
  };
  const CS = {};
  document.querySelectorAll('[data-i18n]').forEach((el) => { CS[el.dataset.i18n] = el.innerHTML; });

  function prepni(l) {
    const d = l === 'en' ? T.en : CS;
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      if (d[el.dataset.i18n]) el.innerHTML = d[el.dataset.i18n];
    });
    document.querySelectorAll('.lb-btn').forEach((b) => b.classList.toggle('is-on', b.dataset.lang === l));
    if (jePribehEn) {
      document.querySelector('.pribeh-cs')?.toggleAttribute('hidden', l === 'en');
      document.querySelector('.pribeh-en')?.toggleAttribute('hidden', l !== 'en');
    }
  }
  document.querySelectorAll('.lb-btn').forEach((b) => b.addEventListener('click', () => prepni(b.dataset.lang)));
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&display=swap');

  .hlava{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:6px}
  .hlava h1{margin:0}
  .rok{color:var(--mute);font-weight:400}

  .langbar{display:flex;gap:0;flex:0 0 auto;margin-top:6px}
  .lb-btn{font-family:var(--disp);font-size:12px;letter-spacing:.11em;text-transform:uppercase;
    background:var(--paper-2);border:1px solid var(--ink);color:var(--mute);padding:7px 14px;cursor:pointer}
  .lb-btn+.lb-btn{border-left:0}
  .lb-btn.is-on{background:var(--ink);color:var(--paper)}

  .tp{display:flex;background:#C3CCD1;border:1px solid #949ba0;margin:22px 0 8px;
    font-family:Arial,Helvetica,sans-serif;color:#16191b}
  .tp__str{padding:14px 14px 16px}
  .tp__str--l{flex:1.08;border-right:1px dashed #7d868b}
  .tp__str--r{flex:1;display:flex;flex-direction:column;position:relative}
  .tp__nadpis{text-align:center;font-size:12px;font-weight:500;letter-spacing:.22em;
    color:#16191b;margin:0 0 9px}

  .tpt{width:100%;border-collapse:collapse;table-layout:fixed}
  .tpt--r{flex:1}
  .tpt td{border:1.5px solid #16191b;padding:3px 5px;vertical-align:middle}
  .tpt .lb{font-size:11px;line-height:1.25;width:31%}
  .tpt .lb b{float:right;font-weight:400}
  .lb--t{vertical-align:top;padding-top:8px}
  .lb--m{vertical-align:middle}
  .tpt .kod{width:12%;font-size:11px;vertical-align:top}
  .tpt .c{text-align:center}
  .tpt .v--t{vertical-align:top}
  .tpt .v--p{text-align:right}
  .kod--b0,.v--b0{border-bottom:0}
  .kod--t0,.v--t0{border-top:0}
  .tpt i{display:block;font-size:11px;font-style:normal;line-height:1;color:#16191b}
  .v--p i{display:inline}

  .ruka{font-family:Caveat,'Segoe Script','Bradley Hand',cursive;font-size:20px;color:#1b2530;line-height:1.1}
  .ruka--vel{font-size:22px}
  .ruka--mal{font-size:18px}
  .skryto{font-size:11px;color:#5c666c;font-style:italic}

  .spz{display:flex;align-items:center;gap:7px;margin-bottom:10px}
  .spz__lb{font-size:12px;font-weight:500;white-space:nowrap}
  .spz__lb b{font-weight:400;font-size:11px}
  .spz__pole{flex:1;min-height:30px;display:flex;align-items:center;justify-content:center;
    background:repeating-linear-gradient(to bottom,#16191b 0 1px,transparent 1px 3px)}
  .spz__val{font-size:24px;font-weight:600;letter-spacing:.06em;
    text-shadow:0 0 4px #C3CCD1,0 0 4px #C3CCD1,0 0 3px #C3CCD1}

  .v--razitko{height:46px}
  .razitko{position:absolute;right:6px;bottom:4px;width:88px;height:88px;
    transform:rotate(6deg);pointer-events:none}

  .tp__pozn{font-size:13px;color:var(--mute);margin:0 0 26px;line-height:1.5}

  .galerie{counter-reset:frame;display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));
    gap:2px;background:var(--ink);border:1px solid var(--ink);margin:0 0 28px}
  .galerie figure{counter-increment:frame;margin:0;background:var(--paper);position:relative}
  .galerie figure::before{content:'#' counter(frame,decimal-leading-zero);position:absolute;top:8px;left:8px;
    background:var(--ink);color:var(--paper);font-family:'SF Mono','Courier New',monospace;
    font-size:10px;padding:2px 6px}
  .galerie img{width:100%;height:200px;object-fit:cover;display:block}
  .galerie figcaption{padding:8px 10px;font-size:12px;color:var(--mute);border-top:1px solid var(--rule)}

  .pribeh{border-left:3px solid var(--red);padding:2px 0 2px 20px;margin:0 0 28px}
  .pribeh h2{margin:0 0 10px;font-family:var(--disp);font-size:11.5px;letter-spacing:.15em;
    text-transform:uppercase;color:var(--red)}
  .pribeh p{margin:0;font-size:16px;line-height:1.65}

  .kontakt-cta{border:1px solid var(--rule);background:var(--paper-2);padding:18px 20px;margin-bottom:24px}
  .kontakt-cta p{margin:0 0 12px;font-size:15px}
  .kontakt-cta .btn{display:inline-block;background:var(--red);color:var(--paper);border:2px solid var(--ink);
    font-family:var(--disp);font-size:13px;letter-spacing:.12em;text-transform:uppercase;
    padding:10px 20px;text-decoration:none}
  .kontakt-cta .btn:hover{background:var(--ink)}

  .zpet{margin:0}
  .zpet a{font-family:var(--disp);font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute)}

  @media (max-width:760px){
    .tp{flex-direction:column}
    .tp__str--l{border-right:0;border-bottom:1px dashed #7d868b}
    .razitko{width:76px;height:76px}
  }
  @media (max-width:420px){
    .ruka{font-size:17px}
    .ruka--vel{font-size:19px}
    .tpt .lb{width:34%;font-size:10.5px}
  }
</style>
