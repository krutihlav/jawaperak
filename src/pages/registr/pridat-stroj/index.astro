---
import Layout from '../../../layouts/Layout.astro';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// Jazyk formuláře teď určuje route (/registr/pridat-stroj/ vs.
// /en/registr/pridat-stroj/) přes Astro.currentLocale, ne vlastní
// langbar přepínač — ten byl jen dočasný per-form fix.
const locale = Astro.currentLocale ?? 'cs';

const CS = {
  h1: 'Přidat stroj',
  lead: 'Vyplňte, co víte. Neúplný záznam je lepší než žádný — doplnit se dá kdykoli.',
  privH: 'Co se zveřejní',
  priv1: 'Typ, rok, stav, barva, kraj — veřejně',
  priv2: 'Výrobní čísla — jen částečně, poslední tři znaky zakryté',
  priv3: 'Jméno, e-mail a telefon — nikdy veřejně',
  priv4: 'Záznam zveřejníme až po ruční kontrole',
  fsStroj: 'Stroj', lTyp: 'Typ *', lRok: 'Rok výroby',
  lRam: 'Výrobní číslo rámu', hRam: 'Zveřejní se jako 11-102•••',
  lMotor: 'Výrobní číslo motoru', lFaze: 'Výrobní fáze', lStav: 'Stav *',
  lBarva: 'Barva', lSpz: 'Historická SPZ',
  fsFoto: 'Fotografie',
  fotoHint: 'Aspoň jedna fotka výrazně pomůže s ověřením záznamu. JPG, PNG nebo WebP, max. 8 MB na fotku, max. 6 fotek.',
  lFoto: 'Fotky stroje',
  fotoPocet: 'Nejvýše 6 fotek.',
  fotoTyp: 'Povolené jsou jen soubory JPG, PNG nebo WebP.',
  fotoVelikost: 'Každá fotka musí být do 8 MB.',
  fotoUploadErr: 'Záznam jsme odeslali, ale některé fotky se nepodařilo nahrát. Ozveme se vám.',
  fsKde: 'Kde stroj je', lZeme: 'Země', lRegion: 'Kraj / region',
  hRegion: 'Přesnou adresu nezadávejte',
  fsPribeh: 'Příběh stroje',
  lPribeh: 'Jak jste ke stroji přišli, co víte o jeho historii',
  lPribehEn: 'Anglicky (nepovinné)',
  fsKontakt: 'Kontakt',
  kontaktNote: 'Kontakt slouží k ověření záznamu. Veřejně se nikdy nezobrazí.',
  lEmail: 'E-mail *', lTel: 'Telefon', lProdej: 'Stroj je na prodej',
  lSouhlas: 'Souhlasím, aby mě zájemci mohli kontaktovat přes formulář (kontakt zůstává skrytý)',
  btnSend: 'Odeslat ke schválení',
  okMsg: 'Děkujeme. Záznam jsme odeslali ke schválení.',
  errMsg: 'Něco se pokazilo. Zkuste to prosím znovu, nebo nám napište.',
  reqMsg: 'Vyplňte prosím povinná pole.',
};

const EN = {
  h1: 'Add a machine',
  lead: 'Fill in what you know. An incomplete record is better than none — you can always add details later.',
  privH: 'What becomes public',
  priv1: 'Type, year, condition, colour, region — public',
  priv2: 'Serial numbers — partially only, last three characters hidden',
  priv3: 'Name, e-mail and phone — never public',
  priv4: 'Records are published after manual review',
  fsStroj: 'Machine', lTyp: 'Type *', lRok: 'Year of manufacture',
  lRam: 'Frame number', hRam: 'Displayed as 11-102•••',
  lMotor: 'Engine number', lFaze: 'Production phase', lStav: 'Condition *',
  lBarva: 'Colour', lSpz: 'Historic registration',
  fsFoto: 'Photos',
  fotoHint: 'At least one photo helps a lot with verifying the record. JPG, PNG or WebP, max. 8 MB per photo, max. 6 photos.',
  lFoto: 'Machine photos',
  fotoPocet: 'Maximum 6 photos.',
  fotoTyp: 'Only JPG, PNG or WebP files are allowed.',
  fotoVelikost: 'Each photo must be under 8 MB.',
  fotoUploadErr: 'The record was submitted, but some photos failed to upload. We will contact you.',
  fsKde: 'Location', lZeme: 'Country', lRegion: 'Region',
  hRegion: 'Do not enter a street address',
  fsPribeh: "Machine's story",
  lPribeh: 'How you got it and what you know about its history',
  lPribehEn: 'In English (optional)',
  fsKontakt: 'Contact',
  kontaktNote: 'Contact details are used to verify the record. They are never shown publicly.',
  lEmail: 'E-mail *', lTel: 'Phone', lProdej: 'This machine is for sale',
  lSouhlas: 'I agree to be contacted through the form (my details stay hidden)',
  btnSend: 'Submit for review',
  okMsg: 'Thank you. The record has been submitted for review.',
  errMsg: 'Something went wrong. Please try again or write to us.',
  reqMsg: 'Please fill in the required fields.',
};

const t = locale === 'en' ? EN : CS;
---

<Layout
  title="Přidat stroj do registru | jawaperak.cz"
  description="Přidejte svůj motocykl Jawa Pérák do veřejného registru dochovaných strojů. Kontaktní údaje zůstávají skryté, výrobní čísla se zveřejňují jen částečně."
>
  <div class="wrap">
    <article class="art">

      <p class="kicker">Registr</p>
      <h1>{t.h1}</h1>

      <p class="lead">
        {t.lead}
      </p>

      <div class="tldr">
        <h2>{t.privH}</h2>
        <ul>
          <li>{t.priv1}</li>
          <li>{t.priv2}</li>
          <li>{t.priv3}</li>
          <li>{t.priv4}</li>
        </ul>
      </div>

      <form id="form-stroj" novalidate>

        <div class="hp-check" style="position: absolute; left: -9999px; opacity: 0; pointer-events: none;" aria-hidden="true">
          <input type="text" name="overeni_webu" tabindex="-1" autocomplete="off" />
        </div>

        <fieldset>
          <legend>{t.fsStroj}</legend>

          <div class="row">
            <label>
              <span>{t.lTyp}</span>
              <select name="typ" id="sel-typ" required>
                <option value="">—</option>
              </select>
            </label>

            <label>
              <span>{t.lRok}</span>
              <input type="number" name="rok_vyroby" min="1946" max="1954" placeholder="1951">
            </label>
          </div>

          <div class="row">
            <label>
              <span>{t.lRam}</span>
              <input type="text" name="cislo_ramu" placeholder="11-102934" autocomplete="off">
              <small>{t.hRam}</small>
            </label>

            <label>
              <span>{t.lMotor}</span>
              <input type="text" name="cislo_motoru" placeholder="12-5845" autocomplete="off">
            </label>
          </div>

          <div class="row">
            <label>
              <span>{t.lFaze}</span>
              <select name="vyrobni_faze" id="sel-faze">
                <option value="">—</option>
              </select>
            </label>

            <label>
              <span>{t.lStav}</span>
              <select name="stav" id="sel-stav" required>
                <option value="">—</option>
              </select>
            </label>
          </div>

          <div class="row">
            <label>
              <span>{t.lBarva}</span>
              <input type="text" name="barva" placeholder="Červená">
            </label>
            <label>
              <span>{t.lSpz}</span>
              <input type="text" name="spz_historicka" placeholder="Nepovinné">
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend>{t.fsFoto}</legend>
          <p class="fs-note">
            {t.fotoHint}
          </p>
          <label class="full">
            <span>{t.lFoto}</span>
            <input type="file" id="input-fotky" name="fotky" accept="image/jpeg,image/png,image/webp" multiple>
          </label>
          <div class="foto-nahled" id="foto-nahled"></div>
          <p class="msg" id="foto-msg" role="status"></p>
        </fieldset>

        <fieldset>
          <legend>{t.fsKde}</legend>
          <div class="row">
            <label>
              <span>{t.lZeme}</span>
              <input type="text" name="zeme" placeholder="Česko" value="Česko">
            </label>
            <label>
              <span>{t.lRegion}</span>
              <input type="text" name="region" placeholder="Olomoucký">
              <small>{t.hRegion}</small>
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend>{t.fsPribeh}</legend>
          <label class="full">
            <span>{t.lPribeh}</span>
            <textarea name="pribeh" rows="5" placeholder="Nepovinné, ale je to nejzajímavější část registru."></textarea>
          </label>
          <label class="full">
            <span>{t.lPribehEn}</span>
            <textarea name="pribeh_en" rows="3"></textarea>
          </label>
        </fieldset>

        <fieldset>
          <legend>{t.fsKontakt}</legend>
          <p class="fs-note">
            {t.kontaktNote}
          </p>
          <div class="row">
            <label>
              <span>{t.lEmail}</span>
              <input type="email" name="kontakt_email" required>
            </label>
            <label>
              <span>{t.lTel}</span>
              <input type="tel" name="kontakt_telefon">
            </label>
          </div>
          <label class="chk-row">
            <input type="checkbox" name="na_prodej">
            <span>{t.lProdej}</span>
          </label>
          <label class="chk-row">
            <input type="checkbox" name="souhlas_kontakt">
            <span>{t.lSouhlas}</span>
          </label>
        </fieldset>

        <div class="submit-row">
          <button type="submit" class="btn">{t.btnSend}</button>
          <p class="msg" id="msg" role="status"></p>
        </div>
      </form>

    </article>
  </div>
</Layout>

<script define:vars={{ SUPABASE_URL, SUPABASE_KEY, locale, msgs: t }}>
  const _pageLoadedAt = Date.now();

  // Popisky dropdownů se NAČÍTAJÍ z číselníkových tabulek v Supabase (CS i EN),
  // ne z kopie natvrdo psané tady — jinak se to časem rozejde. Jazyk popisku
  // určuje `locale` (Astro.currentLocale předaný z frontmatteru), ne toggle.
  let ciselniky = { typ: [], stav: [], faze: [] };

  function vyplnSelect(selectEl, radky) {
    const puvodniHodnota = selectEl.value;
    selectEl.innerHTML = '<option value="">—</option>';
    for (const r of radky) {
      const opt = document.createElement('option');
      opt.value = r.hodnota;
      opt.textContent = locale === 'en' ? (r.popis_en || r.popis_cs) : r.popis_cs;
      selectEl.appendChild(opt);
    }
    if (puvodniHodnota) selectEl.value = puvodniHodnota;
  }

  function vykresliDropdowny() {
    vyplnSelect(document.getElementById('sel-typ'), ciselniky.typ);
    vyplnSelect(document.getElementById('sel-faze'), ciselniky.faze);
    vyplnSelect(document.getElementById('sel-stav'), ciselniky.stav);
  }

  async function nactiCiselniky() {
    const H = { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY };
    try {
      const [rTyp, rStav, rFaze] = await Promise.all([
        fetch(`${SUPABASE_URL}/rest/v1/ciselnik_typ?select=*&order=poradi`, { headers: H }),
        fetch(`${SUPABASE_URL}/rest/v1/ciselnik_stav?select=*&order=poradi`, { headers: H }),
        fetch(`${SUPABASE_URL}/rest/v1/ciselnik_faze?select=*&order=poradi`, { headers: H }),
      ]);
      ciselniky.typ = await rTyp.json();
      ciselniky.stav = await rStav.json();
      ciselniky.faze = await rFaze.json();
      vykresliDropdowny();
    } catch (e) {
      console.error('Číselníky se nepodařilo načíst', e);
    }
  }

  nactiCiselniky();

  const form = document.getElementById('form-stroj');
  const msg = document.getElementById('msg');

  // --- Fotky: preview + validace ---
  const inputFotky = document.getElementById('input-fotky');
  const fotoNahled = document.getElementById('foto-nahled');
  const fotoMsg = document.getElementById('foto-msg');

  const MAX_FOTEK = 6;
  const MAX_VELIKOST = 8 * 1024 * 1024; // 8 MB, musí odpovídat file_size_limit bucketu v Supabase
  const POVOLENE_TYPY = ['image/jpeg', 'image/png', 'image/webp'];

  inputFotky.addEventListener('change', () => {
    const soubory = Array.from(inputFotky.files || []);
    fotoNahled.innerHTML = '';
    fotoMsg.textContent = '';
    fotoMsg.className = 'msg';

    if (soubory.length > MAX_FOTEK) {
      fotoMsg.textContent = msgs.fotoPocet;
      fotoMsg.className = 'msg msg--err';
      inputFotky.value = '';
      return;
    }
    for (const s of soubory) {
      if (!POVOLENE_TYPY.includes(s.type)) {
        fotoMsg.textContent = msgs.fotoTyp;
        fotoMsg.className = 'msg msg--err';
        inputFotky.value = '';
        return;
      }
      if (s.size > MAX_VELIKOST) {
        fotoMsg.textContent = msgs.fotoVelikost;
        fotoMsg.className = 'msg msg--err';
        inputFotky.value = '';
        return;
      }
    }
    for (const s of soubory) {
      const img = document.createElement('img');
      img.src = URL.createObjectURL(s);
      fotoNahled.appendChild(img);
    }
  });

  // Fotka jde na server (/api/nahraj-fotku), ne přímo do Supabase Storage —
  // teprve tam se z ní serverem (sharp) odstraní EXIF/GPS metadata, než se
  // uloží. Server zároveň ověří, že stroj strojId skutečně čeká na schválení
  // (stejné pravidlo, které by jinak vynucovalo RLS pro anon roli).
  async function nahrajFotku(strojId, soubor, poradi) {
    const fd = new FormData();
    fd.append('strojId', strojId);
    fd.append('poradi', String(poradi));
    fd.append('soubor', soubor);

    const r = await fetch('/api/nahraj-fotku', { method: 'POST', body: fd });
    if (!r.ok) throw new Error(await r.text());
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);

    // Honeypot: skryté pole vidí a vyplní jen boti, lidský uživatel ne.
    if (fd.get('overeni_webu')) {
      msg.textContent = msgs.okMsg;
      msg.className = 'msg msg--ok';
      form.reset();
      return;
    }

    if (Date.now() - _pageLoadedAt < 3000) {
      msg.textContent = 'Formulář byl odeslán příliš rychle. Zkuste to prosím znovu.';
      msg.className = 'msg msg--err';
      return;
    }

    if (!fd.get('typ') || !fd.get('stav') || !fd.get('kontakt_email')) {
      msg.textContent = msgs.reqMsg;
      msg.className = 'msg msg--err';
      return;
    }

    // UUID generujeme na klientovi předem — potřebujeme ho hned pro cestu k fotkám
    // ve Storage, a anon role nemá SELECT na tabulku stroje, takže by se id
    // po insertu nedalo přečíst zpátky (return=representation by selhal na RLS).
    const strojId = crypto.randomUUID();

    const payload = {
      id: strojId,
      typ: fd.get('typ'),
      stav: fd.get('stav'),
      rok_vyroby: fd.get('rok_vyroby') ? Number(fd.get('rok_vyroby')) : null,
      cislo_ramu: fd.get('cislo_ramu') || null,
      cislo_motoru: fd.get('cislo_motoru') || null,
      vyrobni_faze: fd.get('vyrobni_faze') || null,
      barva: fd.get('barva') || null,
      spz_historicka: fd.get('spz_historicka') || null,
      zeme: fd.get('zeme') || null,
      region: fd.get('region') || null,
      pribeh: fd.get('pribeh') || null,
      pribeh_en: fd.get('pribeh_en') || null,
      kontakt_email: fd.get('kontakt_email'),
      kontakt_telefon: fd.get('kontakt_telefon') || null,
      na_prodej: fd.get('na_prodej') === 'on',
      souhlas_kontakt: fd.get('souhlas_kontakt') === 'on',
      stav_moderace: 'ceka',
      schvaleno_at: null
    };

    msg.textContent = '…';
    msg.className = 'msg';

    try {
      const r = await fetch(`${SUPABASE_URL}/rest/v1/stroje`, {
        method: 'POST',
        headers: {
          apikey: SUPABASE_KEY,
          Authorization: 'Bearer ' + SUPABASE_KEY,
          'Content-Type': 'application/json',
          Prefer: 'return=minimal'
        },
        body: JSON.stringify(payload)
      });
      if (!r.ok) throw new Error(await r.text());

      const soubory = Array.from(inputFotky.files || []);
      let chybaFotek = false;
      for (let i = 0; i < soubory.length; i++) {
        try {
          await nahrajFotku(strojId, soubory[i], i);
        } catch (chybaNahravani) {
          console.error('Nahrání fotky selhalo', chybaNahravani);
          chybaFotek = true;
        }
      }

      form.reset();
      fotoNahled.innerHTML = '';
      msg.textContent = chybaFotek ? msgs.fotoUploadErr : msgs.okMsg;
      msg.className = chybaFotek ? 'msg msg--err' : 'msg msg--ok';
    } catch (err) {
      console.error(err);
      msg.textContent = msgs.errMsg;
      msg.className = 'msg msg--err';
    }
  });
</script>

<style is:global>
  form{margin-top:26px}
  fieldset{border:1px solid var(--rule);background:var(--paper-2);padding:18px 20px;margin:0 0 18px}
  legend{font-family:var(--disp);font-weight:500;font-size:11.5px;letter-spacing:.15em;
    text-transform:uppercase;color:var(--red);padding:0 8px}
  .fs-note{margin:0 0 14px;font-size:14.5px;color:var(--mute)}

  .row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
  .row:last-child{margin-bottom:0}
  label{display:flex;flex-direction:column;gap:5px}
  label.full{margin-bottom:14px}
  label>span{font-family:var(--disp);font-size:11.5px;letter-spacing:.1em;
    text-transform:uppercase;color:var(--mute)}
  input[type=text],input[type=email],input[type=tel],input[type=number],select,textarea{
    font-family:var(--body);font-size:16px;background:var(--paper);
    border:1px solid var(--ink);color:var(--ink);padding:9px 11px;width:100%;box-sizing:border-box}
  textarea{resize:vertical}
  small{font-size:12.5px;color:var(--mute)}

  .chk-row{flex-direction:row;align-items:flex-start;gap:9px;margin-top:12px}
  .chk-row span{font-family:var(--body);font-size:15px;letter-spacing:0;
    text-transform:none;color:var(--ink)}
  .chk-row input{margin-top:3px}

  .submit-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .btn{background:var(--red);color:var(--paper);border:2px solid var(--ink);
    font-family:var(--disp);font-size:13px;letter-spacing:.12em;text-transform:uppercase;
    padding:12px 24px;cursor:pointer}
  .btn:hover{background:var(--ink)}
  .msg{margin:0;font-size:15px}
  .msg--ok{color:#2E6B32;font-weight:600}
  .msg--err{color:var(--red);font-weight:600}

  .foto-nahled{display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));
    gap:8px;margin:12px 0 0}
  .foto-nahled img{width:100%;height:90px;object-fit:cover;border:1px solid var(--ink)}

  input[type=file]{font-family:var(--body);font-size:14.5px;background:var(--paper);
    border:1px solid var(--ink);color:var(--ink);padding:9px 11px;width:100%;box-sizing:border-box}

  @media (max-width:880px){
    .row{grid-template-columns:1fr}
  }
</style>
