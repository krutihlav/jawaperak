---
import Layout from '../../../layouts/Layout.astro';

const SUPABASE_URL = 'https://hcszrmqtwnkzlbrecrey.supabase.co';
const SUPABASE_KEY = 'sb_publishable_EJ3eN_tBhUDWt7dbQcYCwg_asAVeZDE';
---

<Layout
  title="Přidat stroj do registru | jawaperak.cz"
  description="Přidejte svůj motocykl Jawa Pérák do veřejného registru dochovaných strojů. Kontaktní údaje zůstávají skryté, výrobní čísla se zveřejňují jen částečně."
>
  <div class="wrap">
    <article class="art">

      <p class="kicker">Registr</p>
      <h1 data-i18n="h1">Přidat stroj</h1>

      <div class="langbar">
        <button type="button" class="lb-btn is-on" data-lang="cs">Česky</button>
        <button type="button" class="lb-btn" data-lang="en">English</button>
      </div>

      <p class="lead" data-i18n="lead">
        Vyplňte, co víte. Neúplný záznam je lepší než žádný — doplnit se dá
        kdykoli později.
      </p>

      <div class="tldr">
        <h2 data-i18n="privH">Co se zveřejní</h2>
        <ul>
          <li data-i18n="priv1">Typ, rok, stav, barva, kraj — veřejně</li>
          <li data-i18n="priv2">Výrobní čísla — jen částečně, poslední tři znaky zakryté</li>
          <li data-i18n="priv3">Jméno, e-mail a telefon — nikdy veřejně</li>
          <li data-i18n="priv4">Záznam zveřejníme až po ruční kontrole</li>
        </ul>
      </div>

      <form id="form-stroj" novalidate>

        <fieldset>
          <legend data-i18n="fsStroj">Stroj</legend>

          <div class="row">
            <label>
              <span data-i18n="lTyp">Typ *</span>
              <select name="typ" id="sel-typ" required>
                <option value="">—</option>
              </select>
            </label>

            <label>
              <span data-i18n="lRok">Rok výroby</span>
              <input type="number" name="rok_vyroby" min="1946" max="1954" placeholder="1951">
            </label>
          </div>

          <div class="row">
            <label>
              <span data-i18n="lRam">Výrobní číslo rámu</span>
              <input type="text" name="cislo_ramu" placeholder="11-102934" autocomplete="off">
              <small data-i18n="hRam">Zveřejní se jako 11-102•••</small>
            </label>

            <label>
              <span data-i18n="lMotor">Výrobní číslo motoru</span>
              <input type="text" name="cislo_motoru" placeholder="12-5845" autocomplete="off">
            </label>
          </div>

          <div class="row">
            <label>
              <span data-i18n="lFaze">Výrobní fáze</span>
              <select name="vyrobni_faze" id="sel-faze">
                <option value="">—</option>
              </select>
            </label>

            <label>
              <span data-i18n="lStav">Stav *</span>
              <select name="stav" id="sel-stav" required>
                <option value="">—</option>
              </select>
            </label>
          </div>

          <div class="row">
            <label>
              <span data-i18n="lBarva">Barva</span>
              <input type="text" name="barva" placeholder="Červená">
            </label>
            <label>
              <span data-i18n="lSpz">Historická SPZ</span>
              <input type="text" name="spz_historicka" placeholder="Nepovinné">
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend data-i18n="fsKde">Kde stroj je</legend>
          <div class="row">
            <label>
              <span data-i18n="lZeme">Země</span>
              <input type="text" name="zeme" placeholder="Česko" value="Česko">
            </label>
            <label>
              <span data-i18n="lRegion">Kraj / region</span>
              <input type="text" name="region" placeholder="Olomoucký">
              <small data-i18n="hRegion">Přesnou adresu nezadávejte</small>
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend data-i18n="fsPribeh">Příběh stroje</legend>
          <label class="full">
            <span data-i18n="lPribeh">Jak jste ke stroji přišli, co víte o jeho historii</span>
            <textarea name="pribeh" rows="5" placeholder="Nepovinné, ale je to nejzajímavější část registru."></textarea>
          </label>
          <label class="full">
            <span data-i18n="lPribehEn">Anglicky (nepovinné)</span>
            <textarea name="pribeh_en" rows="3"></textarea>
          </label>
        </fieldset>

        <fieldset>
          <legend data-i18n="fsKontakt">Kontakt</legend>
          <p class="fs-note" data-i18n="kontaktNote">
            Kontakt slouží k ověření záznamu. Veřejně se nikdy nezobrazí.
          </p>
          <div class="row">
            <label>
              <span data-i18n="lEmail">E-mail *</span>
              <input type="email" name="kontakt_email" required>
            </label>
            <label>
              <span data-i18n="lTel">Telefon</span>
              <input type="tel" name="kontakt_telefon">
            </label>
          </div>
          <label class="chk-row">
            <input type="checkbox" name="na_prodej">
            <span data-i18n="lProdej">Stroj je na prodej</span>
          </label>
          <label class="chk-row">
            <input type="checkbox" name="souhlas_kontakt">
            <span data-i18n="lSouhlas">Souhlasím, aby mě zájemci mohli kontaktovat přes formulář (kontakt zůstává skrytý)</span>
          </label>
        </fieldset>

        <div class="submit-row">
          <button type="submit" class="btn" data-i18n="btnSend">Odeslat ke schválení</button>
          <p class="msg" id="msg" role="status"></p>
        </div>
      </form>

      <p class="foto-note" data-i18n="fotoNote">
        <b>Fotky:</b> nahrávání fotek zatím není hotové. Po odeslání záznamu se
        vám ozveme a fotky doplníme ručně.
      </p>

    </article>
  </div>
</Layout>

<script define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
  const T = {
    en: {
      h1: 'Add a machine',
      lead: 'Fill in what you know. An incomplete record is better than none — you can always add details later.',
      privH: 'What becomes public',
      priv1: 'Type, year, condition, colour, region — public',
      priv2: 'Serial numbers — partially only, last three characters hidden',
      priv3: 'Name, e-mail and phone — never public',
      priv4: 'Records are published after manual review',
      fsStroj: 'Machine', lTyp: 'Type *', lRok: 'Year of manufacture',
      lRam: 'Frame number', hRam: 'Displayed as 11-102•••',
      lMotor: 'Engine number', lFaze: 'Production phase', lStav: 'Condition *',
      lBarva: 'Colour', lSpz: 'Historic registration',
      fsKde: 'Location', lZeme: 'Country', lRegion: 'Region',
      hRegion: 'Do not enter a street address',
      fsPribeh: "Machine's story",
      lPribeh: 'How you got it and what you know about its history',
      lPribehEn: 'In English (optional)',
      fsKontakt: 'Contact',
      kontaktNote: 'Contact details are used to verify the record. They are never shown publicly.',
      lEmail: 'E-mail *', lTel: 'Phone', lProdej: 'This machine is for sale',
      lSouhlas: 'I agree to be contacted through the form (my details stay hidden)',
      btnSend: 'Submit for review',
      fotoNote: 'Photos: upload is not ready yet. We will contact you and add photos manually.',
      okMsg: 'Thank you. The record has been submitted for review.',
      errMsg: 'Something went wrong. Please try again or write to us.',
      reqMsg: 'Please fill in the required fields.'
    }
  };
  const CS = {};
  document.querySelectorAll('[data-i18n]').forEach((el) => { CS[el.dataset.i18n] = el.innerHTML; });
  CS.okMsg = 'Děkujeme. Záznam jsme odeslali ke schválení.';
  CS.errMsg = 'Něco se pokazilo. Zkuste to prosím znovu, nebo nám napište.';
  CS.reqMsg = 'Vyplňte prosím povinná pole.';

  let lang = 'cs';
  function prepni(l) {
    lang = l;
    const d = l === 'en' ? T.en : CS;
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      if (d[el.dataset.i18n]) el.innerHTML = d[el.dataset.i18n];
    });
    document.querySelectorAll('.lb-btn').forEach((b) =>
      b.classList.toggle('is-on', b.dataset.lang === l));
    vykresliDropdowny(l);
  }
  document.querySelectorAll('.lb-btn').forEach((b) =>
    b.addEventListener('click', () => prepni(b.dataset.lang)));

  // Popisky dropdownů se NAČÍTAJÍ z číselníkových tabulek v Supabase (CS i EN),
  // ne z kopie natvrdo psané tady — jinak se to časem rozejde.
  let ciselniky = { typ: [], stav: [], faze: [] };

  function vyplnSelect(selectEl, radky, jazyk) {
    const puvodniHodnota = selectEl.value;
    selectEl.innerHTML = '<option value="">—</option>';
    for (const r of radky) {
      const opt = document.createElement('option');
      opt.value = r.hodnota;
      opt.textContent = jazyk === 'en' ? (r.popis_en || r.popis_cs) : r.popis_cs;
      selectEl.appendChild(opt);
    }
    if (puvodniHodnota) selectEl.value = puvodniHodnota;
  }

  function vykresliDropdowny(jazyk) {
    vyplnSelect(document.getElementById('sel-typ'), ciselniky.typ, jazyk);
    vyplnSelect(document.getElementById('sel-faze'), ciselniky.faze, jazyk);
    vyplnSelect(document.getElementById('sel-stav'), ciselniky.stav, jazyk);
  }

  async function nactiCiselniky() {
    const H = { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY };
    try {
      const [rTyp, rStav, rFaze] = await Promise.all([
        fetch(`${SUPABASE_URL}/rest/v1/ciselnik_typ?select=*&order=poradi`, { headers: H }),
        fetch(`${SUPABASE_URL}/rest/v1/ciselnik_stav?select=*&order=poradi`, { headers: H }),
        fetch(`${SUPABASE_URL}/rest/v1/ciselnik_faze?select=*&order=poradi`, { headers: H }),
      ]);
      ciselniky.typ = await rTyp.json();
      ciselniky.stav = await rStav.json();
      ciselniky.faze = await rFaze.json();
      vykresliDropdowny(lang);
    } catch (e) {
      console.error('Číselníky se nepodařilo načíst', e);
    }
  }

  nactiCiselniky();

  const form = document.getElementById('form-stroj');
  const msg = document.getElementById('msg');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = lang === 'en' ? T.en : CS;
    const fd = new FormData(form);

    if (!fd.get('typ') || !fd.get('stav') || !fd.get('kontakt_email')) {
      msg.textContent = d.reqMsg;
      msg.className = 'msg msg--err';
      return;
    }

    const payload = {
      typ: fd.get('typ'),
      stav: fd.get('stav'),
      rok_vyroby: fd.get('rok_vyroby') ? Number(fd.get('rok_vyroby')) : null,
      cislo_ramu: fd.get('cislo_ramu') || null,
      cislo_motoru: fd.get('cislo_motoru') || null,
      vyrobni_faze: fd.get('vyrobni_faze') || null,
      barva: fd.get('barva') || null,
      spz_historicka: fd.get('spz_historicka') || null,
      zeme: fd.get('zeme') || null,
      region: fd.get('region') || null,
      pribeh: fd.get('pribeh') || null,
      pribeh_en: fd.get('pribeh_en') || null,
      kontakt_email: fd.get('kontakt_email'),
      kontakt_telefon: fd.get('kontakt_telefon') || null,
      na_prodej: fd.get('na_prodej') === 'on',
      souhlas_kontakt: fd.get('souhlas_kontakt') === 'on',
      stav_moderace: 'ceka',
      schvaleno_at: null
    };

    msg.textContent = '…';
    msg.className = 'msg';

    try {
      const r = await fetch(`${SUPABASE_URL}/rest/v1/stroje`, {
        method: 'POST',
        headers: {
          apikey: SUPABASE_KEY,
          Authorization: 'Bearer ' + SUPABASE_KEY,
          'Content-Type': 'application/json',
          Prefer: 'return=minimal'
        },
        body: JSON.stringify(payload)
      });
      if (!r.ok) throw new Error(await r.text());
      form.reset();
      msg.textContent = d.okMsg;
      msg.className = 'msg msg--ok';
    } catch (err) {
      console.error(err);
      msg.textContent = d.errMsg;
      msg.className = 'msg msg--err';
    }
  });
</script>

<style>
  .langbar{display:flex;gap:0;margin:18px 0 6px}
  .lb-btn{font-family:var(--disp);font-size:12px;letter-spacing:.11em;text-transform:uppercase;
    background:var(--paper-2);border:1px solid var(--ink);color:var(--mute);
    padding:7px 14px;cursor:pointer}
  .lb-btn+.lb-btn{border-left:0}
  .lb-btn.is-on{background:var(--ink);color:var(--paper)}

  form{margin-top:26px}
  fieldset{border:1px solid var(--rule);background:var(--paper-2);padding:18px 20px;margin:0 0 18px}
  legend{font-family:var(--disp);font-weight:500;font-size:11.5px;letter-spacing:.15em;
    text-transform:uppercase;color:var(--red);padding:0 8px}
  .fs-note{margin:0 0 14px;font-size:14.5px;color:var(--mute)}

  .row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
  .row:last-child{margin-bottom:0}
  label{display:flex;flex-direction:column;gap:5px}
  label.full{margin-bottom:14px}
  label>span{font-family:var(--disp);font-size:11.5px;letter-spacing:.1em;
    text-transform:uppercase;color:var(--mute)}
  input[type=text],input[type=email],input[type=tel],input[type=number],select,textarea{
    font-family:var(--body);font-size:16px;background:var(--paper);
    border:1px solid var(--ink);color:var(--ink);padding:9px 11px;width:100%;box-sizing:border-box}
  textarea{resize:vertical}
  small{font-size:12.5px;color:var(--mute)}

  .chk-row{flex-direction:row;align-items:flex-start;gap:9px;margin-top:12px}
  .chk-row span{font-family:var(--body);font-size:15px;letter-spacing:0;
    text-transform:none;color:var(--ink)}
  .chk-row input{margin-top:3px}

  .submit-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .btn{background:var(--red);color:var(--paper);border:2px solid var(--ink);
    font-family:var(--disp);font-size:13px;letter-spacing:.12em;text-transform:uppercase;
    padding:12px 24px;cursor:pointer}
  .btn:hover{background:var(--ink)}
  .msg{margin:0;font-size:15px}
  .msg--ok{color:#2E6B32;font-weight:600}
  .msg--err{color:var(--red);font-weight:600}

  .foto-note{margin-top:24px;border:1px dashed var(--rule);padding:12px 16px;
    font-size:15px;color:var(--mute)}

  @media (max-width:880px){
    .row{grid-template-columns:1fr}
  }
</style>
