---
import Layout from '../../layouts/Layout.astro';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const locale = Astro.currentLocale ?? 'cs';

const CS = {
  metaTitle: 'Registr dochovaných Péráků | jawaperak.cz',
  metaDesc: 'Veřejná databáze dochovaných motocyklů Jawa 250 a 350 Pérák. Přidejte svůj stroj a pomozte zmapovat, kolik jich přežilo.',
  kicker: 'Registr',
  h1: 'Kolik Péráků přežilo?',
  lead: 'Nikdo to neví. Vyráběly se desítky tisíc kusů, dochovala se neznámá část — roztroušená po garážích, stodolách a sbírkách. Tenhle registr to zkouší zmapovat.',
  statStroju: 'strojů',
  statZemi: 'zemí',
  ctaHave: 'Máte Péráka?',
  ctaText: 'I nekompletní nebo rozebraný stroj do registru patří.',
  addMachine: 'Přidat stroj',
  vypisH2: 'Dochované stroje',
  filtryLabel: 'Filtry',
  typLabel: 'Typ',
  vsechnyTypy: 'Všechny typy',
  stavLabel: 'Stav',
  vsechnyStavy: 'Všechny stavy',
  fazeLabel: 'Výrobní fáze',
  vsechnyFaze: 'Všechny fáze',
  jenProdej: 'Jen na prodej',
  nacitam: 'Načítám registr…',
  jakH2: 'Jak registr funguje',
  tabCaption: 'Co je veřejné a co ne',
  thUdaj: 'Údaj',
  thViditelnost: 'Viditelnost',
  row1Label: 'Typ, rok, stav, barva', row1Val: 'Veřejné',
  row2Label: 'Výrobní čísla', row2Val: 'Veřejně jen částečně — poslední tři znaky zakryté',
  row3Label: 'Kraj / země', row3Val: 'Veřejné (ne přesná adresa)',
  row4Label: 'Jméno a kontakt majitele', row4Val: 'Nikdy veřejné, jen přes formulář a se souhlasem',
  row5Label: 'Fotky a příběh stroje', row5Val: 'Veřejné',
  boxLabel: 'Proč zakrýváme část čísel',
  boxText: 'Kompletní výrobní číslo se dá zneužít ke klonování identity — přeražením na jiný, třeba kradený stroj. Zakrytá část zůstává v databázi a používá se při ověřování, jen není veřejně čitelná.',
  closingText: 'Každý záznam před zveřejněním ručně zkontrolujeme — ne kvůli přísnosti, ale kvůli kvalitě dat. Neúplný záznam ale vítáme, doplnit se dá kdykoli.',
  naProdej: 'Na prodej',
  bezFotky: 'Bez<br>fotky',
  typPrefix: 'Typ',
  prazdnoNadpis: 'Zatím tu nic není.',
  prazdnoText: 'Registr se teprve plní. Když přidáte svůj stroj, budete mezi prvními.',
  chybaNacteni: 'Registr se nepodařilo načíst. Zkuste to prosím později.',
};

const EN = {
  metaTitle: 'Registry of Surviving Péráks | jawaperak.cz',
  metaDesc: 'A public database of surviving Jawa 250 and 350 Pérák motorcycles. Add your machine and help map how many have survived.',
  kicker: 'Registry',
  h1: 'How many Péráks survived?',
  lead: 'Nobody knows. Tens of thousands were produced, and an unknown share has survived — scattered across garages, barns, and collections. This registry is an attempt to map that.',
  statStroju: 'machines',
  statZemi: 'countries',
  ctaHave: 'Have a Pérák?',
  ctaText: 'Even an incomplete or disassembled machine belongs in the registry.',
  addMachine: 'Add a machine',
  vypisH2: 'Surviving machines',
  filtryLabel: 'Filters',
  typLabel: 'Type',
  vsechnyTypy: 'All types',
  stavLabel: 'Condition',
  vsechnyStavy: 'All conditions',
  fazeLabel: 'Production phase',
  vsechnyFaze: 'All phases',
  jenProdej: 'For sale only',
  nacitam: 'Loading registry…',
  jakH2: 'How the registry works',
  tabCaption: "What's public and what isn't",
  thUdaj: 'Field',
  thViditelnost: 'Visibility',
  row1Label: 'Type, year, condition, color', row1Val: 'Public',
  row2Label: 'Serial numbers', row2Val: 'Partially public only — last three characters masked',
  row3Label: 'Region / country', row3Val: 'Public (not the exact address)',
  row4Label: "Owner's name and contact", row4Val: 'Never public — only via the form, with consent',
  row5Label: "Photos and the machine's story", row5Val: 'Public',
  boxLabel: 'Why we mask part of the numbers',
  boxText: "A complete serial number can be misused to clone an identity — by restamping it onto another machine, potentially a stolen one. The masked part stays in the database and is used for verification; it's just not publicly visible.",
  closingText: "We manually review every entry before it's published — not to be strict, but for data quality. An incomplete entry is still welcome; it can always be filled in later.",
  naProdej: 'For sale',
  bezFotky: 'No<br>photo',
  typPrefix: 'Type',
  prazdnoNadpis: 'Nothing here yet.',
  prazdnoText: 'The registry is just getting started. Add your machine and be among the first.',
  chybaNacteni: "Couldn't load the registry. Please try again later.",
};

const t = locale === 'en' ? EN : CS;
---

<Layout
  title={t.metaTitle}
  description={t.metaDesc}
>
  <div class="wrap wrap--wide">
    <div class="page" style="max-width:none">
    <article class="art">

      <div class="art--text">
        <p class="kicker">{t.kicker}</p>
        <h1>{t.h1}</h1>
        <p class="lead">
          {t.lead}
        </p>

        <div class="stats" id="stats" aria-live="polite">
          <div class="stat"><span class="stat__n" data-stat="celkem">–</span><span class="stat__l">{t.statStroju}</span></div>
          <div class="stat"><span class="stat__n" data-stat="pocet_250">–</span><span class="stat__l">250 ccm</span></div>
          <div class="stat"><span class="stat__n" data-stat="pocet_350">–</span><span class="stat__l">350 ccm</span></div>
          <div class="stat"><span class="stat__n" data-stat="pocet_zemi">–</span><span class="stat__l">{t.statZemi}</span></div>
        </div>

        <div class="cta-add">
          <div>
            <b>{t.ctaHave}</b>
            <span>{t.ctaText}</span>
          </div>
          <a class="btn" href="/registr/pridat-stroj/">{t.addMachine}</a>
        </div>
      </div>

      <section id="vypis">
        <h2>{t.vypisH2}</h2>

        <div class="filters" role="group" aria-label={t.filtryLabel}>
          <select id="f-typ" aria-label={t.typLabel}>
            <option value="">{t.vsechnyTypy}</option>
          </select>
          <select id="f-stav" aria-label={t.stavLabel}>
            <option value="">{t.vsechnyStavy}</option>
          </select>
          <select id="f-faze" aria-label={t.fazeLabel}>
            <option value="">{t.vsechnyFaze}</option>
          </select>
          <label class="chk"><input type="checkbox" id="f-prodej"> {t.jenProdej}</label>
        </div>

        <div id="vysledky" class="seznam-stroju" aria-live="polite">
          <p class="loading">{t.nacitam}</p>
        </div>
      </section>

      <section id="jak" class="art--text">
        <h2>{t.jakH2}</h2>

        <table class="spec">
          <caption>{t.tabCaption}</caption>
          <thead>
            <tr><th>{t.thUdaj}</th><th>{t.thViditelnost}</th></tr>
          </thead>
          <tbody>
            <tr><td class="rl">{t.row1Label}</td><td>{t.row1Val}</td></tr>
            <tr><td class="rl">{t.row2Label}</td><td>{t.row2Val}</td></tr>
            <tr><td class="rl">{t.row3Label}</td><td>{t.row3Val}</td></tr>
            <tr><td class="rl">{t.row4Label}</td><td>{t.row4Val}</td></tr>
            <tr><td class="rl">{t.row5Label}</td><td>{t.row5Val}</td></tr>
          </tbody>
        </table>

        <div class="box box--warn">
          <span class="lb">{t.boxLabel}</span>
          <p>
            {t.boxText}
          </p>
        </div>

        <p>
          {t.closingText}
        </p>
      </section>

    </article>
    </div>
  </div>
</Layout>

<script define:vars={{ SUPABASE_URL, SUPABASE_KEY, locale, msgs: t }}>
  const H = { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY };
  const box = document.getElementById('vysledky');

  // Popisky typu/stavu/fáze se NAČÍTAJÍ z číselníkových tabulek v Supabase,
  // ne z kopie natvrdo psané tady — jinak se to časem rozejde (viz historie projektu).
  // Jazyk popisku určuje `locale` (Astro.currentLocale předaný z frontmatteru).
  const popis = (radek) => (locale === 'en' ? (radek.popis_en || radek.popis_cs) : radek.popis_cs);

  let TYP = {};
  let STAV = {};
  let FAZE = {};

  const esc = (s) => String(s ?? '').replace(/[<>&"]/g, (c) =>
    ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c]));

  // Bucket stroje-fotky je soukromý. Podpis funguje i s anon klíčem díky RLS policy
  // verejne_cteni_schvalenych_fotek_storage (jen fotky schváleného stroje) —
  // výsledná URL je časově omezená, ale samotné žádosti o podpis smí jít z prohlížeče.
  async function podepsatCesty(cesty) {
    if (cesty.length === 0) return {};
    try {
      const r = await fetch(`${SUPABASE_URL}/storage/v1/object/sign/stroje-fotky`, {
        method: 'POST',
        headers: { ...H, 'Content-Type': 'application/json' },
        body: JSON.stringify({ paths: cesty, expiresIn: 3600 })
      });
      if (!r.ok) return {};
      const vysledek = await r.json();
      const mapa = {};
      for (const p of vysledek) {
        if (p.signedURL) mapa[p.path] = `${SUPABASE_URL}/storage/v1${p.signedURL}`;
      }
      return mapa;
    } catch (e) {
      console.error('Podpis náhledů se nepodařil', e);
      return {};
    }
  }

  // Pro seznam strojů vrátí mapu stroj_id -> podepsaná URL první fotky (poradi nejnižší).
  async function nactiNahledy(idyStroju) {
    if (idyStroju.length === 0) return {};
    try {
      const r = await fetch(
        `${SUPABASE_URL}/rest/v1/stroje_fotky?select=stroj_id,url,poradi&stroj_id=in.(${idyStroju.join(',')})&order=poradi`,
        { headers: H }
      );
      if (!r.ok) return {};
      const radky = await r.json();
      const prvniCesta = {};
      for (const f of radky) {
        if (!(f.stroj_id in prvniCesta)) prvniCesta[f.stroj_id] = f.url;
      }
      const mapaPodpisu = await podepsatCesty(Object.values(prvniCesta));
      const nahledy = {};
      for (const [strojId, cesta] of Object.entries(prvniCesta)) {
        nahledy[strojId] = mapaPodpisu[cesta] || null;
      }
      return nahledy;
    } catch (e) {
      console.error('Náhledy fotek se nepodařilo načíst', e);
      return {};
    }
  }

  function naplnSelect(selectEl, radky) {
    for (const r of radky) {
      const opt = document.createElement('option');
      opt.value = r.hodnota;
      opt.textContent = popis(r);
      selectEl.appendChild(opt);
    }
  }

  async function nactiCiselniky() {
    try {
      const [rTyp, rStav, rFaze] = await Promise.all([
        fetch(`${SUPABASE_URL}/rest/v1/ciselnik_typ?select=*&order=poradi`, { headers: H }),
        fetch(`${SUPABASE_URL}/rest/v1/ciselnik_stav?select=*&order=poradi`, { headers: H }),
        fetch(`${SUPABASE_URL}/rest/v1/ciselnik_faze?select=*&order=poradi`, { headers: H }),
      ]);
      const [typy, stavy, faze] = await Promise.all([rTyp.json(), rStav.json(), rFaze.json()]);

      TYP = Object.fromEntries(typy.map((r) => [r.hodnota, popis(r)]));
      STAV = Object.fromEntries(stavy.map((r) => [r.hodnota, popis(r)]));
      FAZE = Object.fromEntries(faze.map((r) => [r.hodnota, popis(r)]));

      naplnSelect(document.getElementById('f-typ'), typy);
      naplnSelect(document.getElementById('f-stav'), stavy);
      naplnSelect(document.getElementById('f-faze'), faze);
    } catch (e) {
      console.error('Číselníky se nepodařilo načíst', e);
    }
  }

  async function nactiStatistiky() {
    try {
      const r = await fetch(`${SUPABASE_URL}/rest/v1/registr_statistiky?select=*`, { headers: H });
      const [s] = await r.json();
      if (!s) return;
      document.querySelectorAll('[data-stat]').forEach((el) => {
        el.textContent = s[el.dataset.stat] ?? 0;
      });
    } catch (e) {
      console.error('Statistiky se nepodařilo načíst', e);
    }
  }

function karta(s, nahledUrl) {
  const cislo = s.cislo_ramu_maskovane ? `<span class="k__cislo">${esc(s.cislo_ramu_maskovane)}</span>` : '';
  const misto = [s.region, s.zeme].filter(Boolean).map(esc).join(', ');
  const faze = s.vyrobni_faze && FAZE[s.vyrobni_faze] ? `<span class="tagx">${FAZE[s.vyrobni_faze]}</span>` : '';
  const prodej = s.na_prodej ? `<span class="tagx tagx--red">${msgs.naProdej}</span>` : '';
  const foto = nahledUrl
    ? `<div class="k__ph"><img src="${nahledUrl}" alt="" loading="lazy"></div>`
    : `<div class="k__ph k__ph--prazdno"><span class="k__ph-text">${msgs.bezFotky}</span></div>`;
  return `
    <a class="k" href="/registr/stroj/${esc(s.slug)}/">
      ${foto}
      <div class="k__mid">
        <div class="k__top">
          <h3>${esc(TYP[s.typ] || (msgs.typPrefix + ' ' + s.typ))}${s.rok_vyroby ? ' · ' + esc(s.rok_vyroby) : ''}</h3>
          ${cislo}
        </div>
        <p class="k__meta">
          ${s.stav ? `<span class="tagx">${STAV[s.stav] || esc(s.stav)}</span>` : ''}
          ${faze}${prodej}
        </p>
        ${misto ? `<p class="k__misto">${misto}</p>` : ''}
        ${s.pribeh ? `<p class="k__pribeh">${esc(s.pribeh).slice(0, 160)}${s.pribeh.length > 160 ? '…' : ''}</p>` : ''}
      </div>
    </a>`;
}

function skeletony(pocet) {
  return Array.from({ length: pocet }, () => `
    <div class="k-skeleton" aria-hidden="true">
      <div class="k-skeleton__ph sk-shimmer"></div>
      <div class="k-skeleton__lines">
        <div class="k-skeleton__line sk-shimmer" style="width:55%"></div>
        <div class="k-skeleton__line sk-shimmer" style="width:30%"></div>
        <div class="k-skeleton__line sk-shimmer" style="width:70%"></div>
      </div>
    </div>`).join('');
}

  async function nactiStroje() {
    const typ = document.getElementById('f-typ').value;
    const stav = document.getElementById('f-stav').value;
    const faze = document.getElementById('f-faze').value;
    const prodej = document.getElementById('f-prodej').checked;

    let q = `${SUPABASE_URL}/rest/v1/stroje_verejne?select=*&order=schvaleno_at.desc&limit=60`;
    if (typ) q += `&typ=eq.${typ}`;
    if (stav) q += `&stav=eq.${stav}`;
    if (faze) q += `&vyrobni_faze=eq.${faze}`;
    if (prodej) q += `&na_prodej=is.true`;

    box.innerHTML = skeletony(6);
    try {
      const r = await fetch(q, { headers: H });
      const data = await r.json();
      if (!Array.isArray(data) || data.length === 0) {
        box.innerHTML = `<div class="prazdno">
          <p><b>${msgs.prazdnoNadpis}</b></p>
          <p>${msgs.prazdnoText}</p>
          <a class="btn" href="/registr/pridat-stroj/">${msgs.addMachine}</a>
        </div>`;
        return;
      }
      const nahledy = await nactiNahledy(data.map((s) => s.id));
      box.innerHTML = data.map((s) => karta(s, nahledy[s.id] || null)).join('');
    } catch (e) {
      box.innerHTML = `<p class="loading">${msgs.chybaNacteni}</p>`;
      console.error(e);
    }
  }

  ['f-typ', 'f-stav', 'f-faze', 'f-prodej'].forEach((id) =>
    document.getElementById(id).addEventListener('change', nactiStroje));

  (async () => {
    await nactiCiselniky();
    nactiStatistiky();
    nactiStroje();
  })();
</script>

<style is:global>
  .art--text{max-width:740px}

  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--rule);
    border:1px solid var(--rule);margin:26px 0}
  .stat{background:var(--paper-2);padding:16px 12px;text-align:center}
  .stat__n{display:block;font-family:var(--disp);font-weight:600;font-size:30px;
    line-height:1;color:var(--red);font-variant-numeric:tabular-nums}
  .stat__l{display:block;margin-top:5px;font-family:var(--disp);font-size:11px;
    letter-spacing:.13em;text-transform:uppercase;color:var(--mute)}

  .cta-add{display:flex;align-items:center;justify-content:space-between;gap:16px;
    flex-wrap:wrap;border:2px solid var(--ink);padding:16px 20px;margin:22px 0}
  .cta-add b{display:block;font-family:var(--disp);font-size:16px;letter-spacing:.03em}
  .cta-add span{font-size:15px;color:var(--mute)}
  .btn{display:inline-block;background:var(--red);color:var(--paper);text-decoration:none;
    font-family:var(--disp);font-size:13px;letter-spacing:.12em;text-transform:uppercase;
    padding:11px 20px;border:2px solid var(--ink)}
  .btn:hover{background:var(--ink)}

  .filters{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:18px 0 22px}
  .filters select{font-family:var(--disp);font-size:13px;letter-spacing:.06em;
    background:var(--paper-2);border:1px solid var(--ink);color:var(--ink);padding:8px 10px}
  .chk{font-family:var(--disp);font-size:13px;letter-spacing:.06em;display:flex;
    align-items:center;gap:6px;cursor:pointer}

  .seznam-stroju{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px}

  .k{display:flex;gap:16px;align-items:stretch;text-decoration:none;color:inherit;
    padding:14px;border:1px solid var(--rule);background:var(--card);transition:border-color .15s,box-shadow .15s}
  .k:hover{border-color:var(--ink);box-shadow:0 6px 18px rgba(20,19,18,.08)}
  .k:focus-visible{outline:2px solid var(--red);outline-offset:-2px}

  .k__ph{flex:0 0 92px;width:92px;aspect-ratio:1/1;overflow:hidden;border:1px solid var(--rule);
    background:var(--ink)}
  .k__ph img{display:block;width:100%;height:100%;object-fit:cover}
  .k__ph--prazdno{background:repeating-linear-gradient(45deg,var(--ph-1) 0 10px,var(--ph-2) 10px 20px);
    display:flex;align-items:center;justify-content:center;text-align:center}
  .k__ph-text{font-family:var(--disp);font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;
    line-height:1.35;color:var(--mute-2)}

  .k__mid{flex:1;min-width:0}
  .k__top{display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap}
  .k__top h3{margin:0;font-family:var(--disp);font-weight:600;font-size:16px;letter-spacing:.01em}
  .k__cislo{font-family:var(--disp);font-size:12.5px;letter-spacing:.05em;color:var(--mute);
    font-variant-numeric:tabular-nums;white-space:nowrap}
  .k__meta{margin:8px 0 0;display:flex;gap:6px;flex-wrap:wrap}
  .tagx{font-family:var(--disp);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;
    border:1px solid var(--rule);padding:2px 7px;color:var(--mute)}
  .tagx--red{border-color:var(--red);color:var(--red)}
  .k__misto{margin:8px 0 0;font-size:14px;color:var(--mute)}
  .k__pribeh{margin:6px 0 0;font-size:14.5px;line-height:1.5}

  .k-skeleton{display:flex;gap:16px;padding:14px;border:1px solid var(--rule);background:var(--card)}
  .k-skeleton__ph{flex:0 0 92px;width:92px;aspect-ratio:1/1;background:var(--paper-2)}
  .k-skeleton__lines{flex:1;display:flex;flex-direction:column;gap:9px;justify-content:center}
  .k-skeleton__line{height:11px;background:var(--paper-2)}
  .sk-shimmer{background-image:linear-gradient(100deg,transparent 30%,var(--rule) 50%,transparent 70%);
    background-size:200% 100%;animation:sk-shimmer 1.6s ease-in-out infinite}
  @keyframes sk-shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}

  .loading{grid-column:1/-1;color:var(--mute);font-size:15px}
  .prazdno{grid-column:1/-1;border:1px dashed var(--rule);padding:30px 24px;text-align:center}
  .prazdno p{margin:0 0 8px}
  .prazdno .btn{margin-top:12px}

  @media (prefers-reduced-motion: reduce){
    .k{transition:none}
    .sk-shimmer{animation:none}
  }

  @media (max-width:600px){
    .k__ph{flex-basis:72px;width:72px}
  }

  @media (max-width:880px){
    .stats{grid-template-columns:repeat(2,1fr)}
    .filters select,.filters .chk{flex:1 1 45%}
  }
</style>
