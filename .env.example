# Skutečné hodnoty patří do .env (necommitovat) a do nastavení proměnných na Vercelu.
# Projekt "jawaperak" v Supabase: ref hcszrmqtwnkzlbrecrey, region eu-west-1.

PUBLIC_SUPABASE_URL=https://hcszrmqtwnkzlbrecrey.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Server-only, nikdy neposílat do prohlížeče. Používá se v SSR stránce detailu
# stroje (podpis fotek) a v /api/nahraj-fotku (sanitizace + upload fotek).
SUPABASE_SERVICE_ROLE_KEY=

# Sveltia/Decap CMS na /admin — GitHub OAuth App (astro-decap-cms-oauth).
# Client ID/Secret vytvořené OAuth App v GitHub Settings > Developer settings.
# Secret sem NIKDY nepsat — jen do .env lokálně (gitignored) a do Vercel env proměnných.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Sveltia CMS engine místo výchozího Decap UI (kvůli i18n cs/en)
PUBLIC_DECAP_CMS_SRC_URL=https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js
